---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedFormats from '../components/SupportedFormats.astro';
import SeoContent from '../components/SeoContent.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Remover Metadados — Limpar Metadados de Fotos, PDFs e Documentos Online"
  description="Removedor de metadados gratuito e 100% privado. Aprenda como remover metadados de fotos (EXIF/GPS), PDFs e arquivos Office direto no navegador, sem enviar dados a servidores."
>
  <Header />
  <main id="main-content">
    <Hero />
    <PrivacyBanner />
    <HowItWorks />
    <SupportedFormats />
    <SeoContent />
    <Faq />
  </main>
  <Footer />
</Layout>
