---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedFormats from '../components/SupportedFormats.astro';
import SeoContent from '../components/SeoContent.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Remover Metadados Online — Limpe EXIF e GPS de Fotos e PDFs"
  description="Remova metadados de fotos, PDFs e documentos online e grátis. Apague GPS, dados EXIF e autoria direto no navegador com 100% de privacidade (sem envio a servidores)."
>
  <Header />
  <main id="main-content">
    <Hero />
    <PrivacyBanner />
    <HowItWorks />
    <SupportedFormats />
    <SeoContent />
    <Faq />
  </main>
  <Footer />
</Layout>
