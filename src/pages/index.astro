---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedFormats from '../components/SupportedFormats.astro';
import SeoContent from '../components/SeoContent.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Remover Metadados — Remova GPS, EXIF e Dados Ocultos de Fotos, PDFs e Documentos"
  description="Remova metadados de fotos, PDFs e documentos online grátis. Apague GPS, EXIF e dados de autoria direto no navegador, sem enviar arquivos a servidores. 100% privado e seguro."
>
  <Header />
  <main id="main-content">
    <Hero />
    <PrivacyBanner />
    <HowItWorks />
    <SupportedFormats />
    <SeoContent />
    <Faq />
  </main>
  <Footer />
</Layout>
