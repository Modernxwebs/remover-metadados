---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PrivacyBanner from '../components/PrivacyBanner.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SupportedFormats from '../components/SupportedFormats.astro';
import SeoContent from '../components/SeoContent.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Remover Metadados — Remova GPS, EXIF e Dados Ocultos de Fotos, PDFs e Documentos Grátis"
  description="Remover Metadados online, grátis e 100% privado. Apague GPS, EXIF, autoria e dados ocultos de fotos, PDFs e documentos direto no navegador — nenhum arquivo sai do seu dispositivo."
>
  <Header />
  <main id="main-content">
    <Hero />
    <PrivacyBanner />
    <HowItWorks />
    <SupportedFormats />
    <SeoContent />
    <Faq />
  </main>
  <Footer />
</Layout>
