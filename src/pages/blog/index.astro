---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogCta from '../../components/BlogCta.astro';

const allPosts = (await getCollection('blog', ({ data }) => data.lang === 'pt-BR' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = allPosts.find((p) => p.data.featured) || allPosts[0];
const regularPosts = allPosts.filter((p) => p.id !== featuredPost?.id);

// Unique categories
const categories = ['Todos', ...new Set(allPosts.map((p) => p.data.category))];

const title = 'Blog de Privacidade Digital e Metadados | Remover Metadados';
const description = 'Artigos práticos, análises de segurança e tutoriais aprofundados sobre dados EXIF, coordenadas GPS em fotos, sigilo em documentos PDF e conformidade com a LGPD.';
const canonicalUrl = 'https://remover-metadados.com/blog/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://remover-metadados.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': canonicalUrl },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${canonicalUrl}#blog`,
  'name': 'Blog do Remover Metadados',
  'description': description,
  'url': canonicalUrl,
  'inLanguage': 'pt-BR',
  'publisher': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
  'blogPost': allPosts.map((post) => ({
    '@type': 'BlogPosting',
    'headline': post.data.title,
    'description': post.data.description,
    'url': `https://remover-metadados.com/blog/${post.id}/`,
    'datePublished': post.data.pubDate.toISOString(),
    'author': {
      '@type': 'Person',
      'name': post.data.author,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  includeHreflang={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

  <Header lang="pt-BR" ptUrl="/blog/" enUrl="/en/" isSubpage={true} />

  <main class="blog-main">
    <div class="page-wrap blog-wrap">

      <!-- Breadcrumbs -->
      <nav class="blog-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">Blog</span>
      </nav>

      <!-- Hero Header -->
      <header class="blog-hero">
        <div class="blog-kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>CENTRAL DE PRIVACIDADE & CONHECIMENTO</span>
        </div>

        <h1 class="blog-hero-h1">Blog de Privacidade Digital e Limpeza de Metadados</h1>

        <p class="blog-hero-lead">
          Artigos técnicos, pesquisas sobre vigilância digital e guias detalhados para proteger sua identidade, localização e documentos antes de publicá-los na internet.
        </p>

        <!-- Search and Category Filters -->
        <div class="blog-controls-box">
          <div class="search-input-wrap">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input
              type="search"
              id="blog-search-input"
              class="blog-search-input"
              placeholder="Buscar artigos por palavra-chave (ex: EXIF, GPS, PDF, C2PA)..."
              aria-label="Buscar artigos"
            />
          </div>

          <div class="category-pills-list" role="tablist" aria-label="Filtrar por categoria">
            {categories.map((cat, idx) => (
              <button
                type="button"
                class:list={['cat-filter-btn', { active: idx === 0 }]}
                data-category={cat}
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {cat}
              </button>
            ))}
          </div>
        </div>
      </header>

      <!-- Featured Article Spotlight -->
      {featuredPost && (
        <section class="featured-section" id="featured-article-wrap">
          <div class="section-label-bar">
            <span class="section-tag-pill">★ ARTIGO EM DESTAQUE</span>
          </div>
          <div data-post-card data-category={featuredPost.data.category} data-search={`${featuredPost.data.title} ${featuredPost.data.description} ${featuredPost.data.tags.join(' ')}`}>
            <BlogCard post={featuredPost} isFeatured={true} />
          </div>
        </section>
      )}

      <!-- All Posts Grid -->
      <section class="posts-grid-section">
        <div class="section-label-bar">
          <span class="section-tag-pill">TODOS OS ARTIGOS ({allPosts.length})</span>
        </div>

        <div id="posts-grid" class="posts-grid">
          {regularPosts.map((post) => (
            <div data-post-card data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`}>
              <BlogCard post={post} />
            </div>
          ))}
        </div>

        <!-- No results state -->
        <div id="no-results-msg" class="no-results-box" style="display: none;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="8" y1="12" x2="16" y2="12"/>
          </svg>
          <p>Nenhum artigo encontrado para o filtro selecionado.</p>
          <button type="button" id="reset-filters-btn" class="btn-accent" style="margin-top: 0.75rem; font-size: 0.78rem;">
            Limpar filtros de busca
          </button>
        </div>
      </section>

      <!-- Bottom In-Content CTA -->
      <BlogCta isEn={false} />

    </div>
  </main>

  <Footer lang="pt-BR" />
</Layout>

<style>
  .blog-main {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .blog-wrap {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-align: left;
    align-self: flex-start;
  }

  .blog-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .blog-breadcrumb a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .crumb-sep {
    color: var(--text-faint);
  }

  .crumb-current {
    font-weight: 700;
    color: var(--text);
  }

  .blog-hero {
    text-align: center;
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .blog-kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    background: var(--badge-bg);
    color: var(--badge-text);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    padding: 0.25rem 0.65rem;
    border-radius: 2px;
    margin-bottom: 1.25rem;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.3);
  }

  .blog-hero-h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .blog-hero-lead {
    font-size: clamp(0.95rem, 2vw, 1.12rem);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 2rem 0;
    max-width: 740px;
  }

  .blog-controls-box {
    width: 100%;
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    padding: 1.25rem;
  }

  .search-input-wrap {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  .blog-search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--bg);
    color: var(--text);
    border: 1.5px solid var(--border);
    border-radius: 3px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .blog-search-input:focus {
    border-color: var(--link-color);
    box-shadow: 0 0 0 2px rgba(26, 86, 219, 0.2);
  }

  .category-pills-list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-filter-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    background: var(--bg);
    color: var(--text-muted);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    border-radius: 2px;
    cursor: pointer;
    transition: transform 0.12s ease, background 0.15s ease, color 0.15s ease;
  }

  .cat-filter-btn:hover {
    transform: translate(-1px, -1px);
    background: var(--card-bg);
    color: var(--text);
  }

  .cat-filter-btn.active {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .section-label-bar {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    text-align: left;
  }

  .section-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.3rem;
  }

  .featured-section {
    text-align: left;
  }

  .posts-grid-section {
    text-align: left;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .no-results-box {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--card-bg);
    border: 2px dashed var(--border);
    border-radius: 4px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    .blog-controls-box {
      padding: 1rem;
    }
  }
</style>

<script>
  // Dynamic client-side search and category filtering
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
  const categoryBtns = document.querySelectorAll('.cat-filter-btn');
  const postCards = document.querySelectorAll('[data-post-card]');
  const featuredWrap = document.getElementById('featured-article-wrap');
  const noResultsMsg = document.getElementById('no-results-msg');
  const resetBtn = document.getElementById('reset-filters-btn');

  let activeCategory = 'Todos';
  let searchQuery = '';

  function filterPosts() {
    let visibleCount = 0;

    postCards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const cardCategory = card.getAttribute('data-category') || '';
      const cardSearchText = (card.getAttribute('data-search') || '').toLowerCase();

      const matchesCat = activeCategory === 'Todos' || cardCategory === activeCategory;
      const matchesSearch = !searchQuery || cardSearchText.includes(searchQuery);

      if (matchesCat && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? 'flex' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterPosts();
  });

  categoryBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      activeCategory = btn.getAttribute('data-category') || 'Todos';
      filterPosts();
    });
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    searchQuery = '';
    activeCategory = 'Todos';
    categoryBtns.forEach((b, idx) => {
      b.classList.toggle('active', idx === 0);
      b.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
    });
    filterPosts();
  });
</script>
