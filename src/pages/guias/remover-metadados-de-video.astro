---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Remover Metadados de Vídeo MP4, MOV e M4V | Limites';
const description = 'Veja quais caixas de MP4, MOV e M4V o código tenta remover, o que pode permanecer e como conferir o vídeo baixado. Processamento local no navegador.';
const canonicalUrl = 'https://remover-metadados.com/guias/remover-metadados-de-video/';

const faqItems = [
  {
    question: 'Quais caixas de metadados o código tenta remover?',
    answer: 'O caminho atual ignora caixas udta e caixas uuid cujo identificador começa com be 7a cf cb. Isso pode atingir alguns dados de usuário e XMP. Não é uma lista de campos GPS, câmera ou datas garantidamente removidos; outras estruturas podem permanecer.',
  },
  {
    question: 'Quais formatos são aceitos e foram testados?',
    answer: 'O código aceita arquivos com extensão MP4, M4V e MOV. A verificação publicada do projeto ainda não inclui um vídeo de teste: reprodução e cobertura completa dos metadados não foram verificadas. Use uma cópia e confira o resultado antes de compartilhar.',
  },
  {
    question: 'A imagem, o áudio e a reprodução estão garantidos?',
    answer: 'O código copia os dados de mídia sem reencodificá-los, mas a reprodução do arquivo de saída ainda não foi verificada pelo teste público. Confira duração, imagem e som em um player antes de usar a cópia.',
  },
  {
    question: 'Meu vídeo é enviado ao servidor?',
    answer: 'O arquivo selecionado é processado no navegador e não é enviado aos servidores do site. A página usa analytics e pode carregar recursos externos; consulte a política de privacidade para detalhes sobre as conexões do site.',
  },
  {
    question: 'A limpeza remove marca d’água ou legendas do vídeo?',
    answer: 'Não. Marcas d’água e legendas queimadas fazem parte da imagem; faixas de áudio e vídeo são tratadas como dados de mídia, não como metadados pelo código atual.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://remover-metadados.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guias', 'item': 'https://remover-metadados.com/guias/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'Vídeo', 'item': canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonicalUrl}#article`,
  'mainEntityOfPage': { '@id': `${canonicalUrl}#webpage` },
  'headline': title,
  'description': description,
  'url': canonicalUrl,
  'inLanguage': 'pt-BR',
  'author': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'Como Remover Metadados de Vídeo Online',
  'description': 'Passo a passo para processar uma cópia de vídeo no navegador e conferir a reprodução e os metadados restantes.',
  'totalTime': 'PT1M',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Guarde uma cópia do vídeo original',
      'text': 'Abra a página inicial do Removedor de Metadados no seu navegador.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Selecione seu arquivo de vídeo',
      'text': 'Arraste o arquivo MP4, MOV ou M4V para a área de limpeza ou clique para selecionar do dispositivo.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Processe uma cópia e conheça os limites',
      'text': 'O código tenta remover caixas udta e uma família de caixas XMP uuid; outros metadados podem permanecer e a reprodução não foi verificada.',
      'url': 'https://remover-metadados.com/#como-funciona',
    },
    {
      '@type': 'HowToStep',
      'position': 4,
      'name': 'Baixe e confira a cópia',
      'text': 'Inspecione as tags restantes e abra o arquivo em um player para conferir imagem, som e duração antes de usá-lo.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  mainEntityId={`${canonicalUrl}#article`}
  includeHreflang={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header lang="pt-BR" ptUrl="/guias/remover-metadados-de-video/" enUrl="/en/" isSubpage={true} />
  <p class="page-wrap" style="padding-top: 1rem; font-size: 0.85rem;"><a href="/verificacao/">Veja a cobertura real por formato, os testes e as limitações antes de compartilhar arquivos.</a></p>

  <main class="guide-main">
    <div class="page-wrap guide-container">

      <!-- Breadcrumbs -->
      <nav class="guide-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/guias/">Guias</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">Vídeo</span>
      </nav>

      <!-- Hero Header -->
      <header class="guide-hero">
        <div class="guide-kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>GUIA PRÁTICO · MP4, MOV, M4V E LIMITAÇÕES</span>
        </div>

        <h1 class="guide-hero-h1">Como Remover Metadados de Vídeo Online</h1>

        <p class="guide-hero-lead">
          O código aceita arquivos MP4, MOV e M4V e tenta remover caixas específicas do contêiner. O relatório público ainda não inclui um vídeo de teste, então a reprodução e a remoção completa de metadados não estão confirmadas. Veja o que o código altera e como conferir a cópia.
        </p>

        <!-- Quick Specs Strip -->
        <div class="guide-specs-strip">
          <div class="spec-pill">
            <span class="spec-label">EXTENSÕES ACEITAS PELO CÓDIGO:</span>
            <span class="spec-val">MP4, MOV, M4V</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">TESTE PÚBLICO:</span>
            <span class="spec-val">Vídeo ainda não verificado</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">CAIXAS ALVO:</span>
            <span class="spec-val">udta e XMP uuid específico</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">ANTES DE USAR:</span>
            <span class="spec-val">Confira tags e reprodução</span>
          </div>
        </div>

        <div class="hero-cta-wrap">
          <a class="hero-cta-btn" href="/#hero-section">
            <span class="cta-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m22 8-6 4 6 4V8Z"/>
                <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
              </svg>
            </span>
            <span>Remover Metadados do Meu Vídeo Agora</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="hero-cta-trust">Processamento local · Use uma cópia · Reprodução ainda não testada</p>
        </div>
      </header>

      <!-- Main Two-Column Layout -->
      <div class="guide-layout">
        
        <!-- Left Content Column -->
        <article class="guide-article">

          <!-- Implementation scope, not a video test result -->
          <section class="guide-section" aria-labelledby="heading-inspecao">
            <div class="section-title-wrap">
              <span class="section-kicker">ALCANCE DO CÓDIGO</span>
              <h2 id="heading-inspecao">O que o código tenta alterar?</h2>
            </div>
            <p>
              Arquivos MP4, MOV e M4V podem organizar dados em caixas diferentes. A implementação atual procura caixas <code>udta</code> e caixas <code>uuid</code> com um identificador XMP específico. Isso descreve o código, não comprova que todos os metadados ou todos os vídeos sejam tratados corretamente.
            </p>

            <div class="terminal-comparison">
              <div class="terminal-box terminal-danger">
                <div class="terminal-header">
                  <span class="term-dot dot-red" aria-hidden="true"></span>
                  <span class="term-dot dot-yellow" aria-hidden="true"></span>
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">Contêiner de entrada [ESTRUTURA VARIÁVEL]</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line danger-line"><span>moov:</span> caixa principal de metadados e faixas</div>
                  <div class="term-line danger-line"><span>udta:</span> dados de usuário; caixa-alvo do código</div>
                  <div class="term-line danger-line"><span>uuid:</span> pode conter XMP ou outros dados</div>
                  <div class="term-line danger-line"><span>mdat:</span> amostras de áudio e vídeo</div>
                </div>
              </div>

              <div class="terminal-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <polyline points="19 12 12 19 5 12"/>
                </svg>
              </div>

              <div class="terminal-box terminal-safe">
                <div class="terminal-header">
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">Comportamento implementado [NÃO É TESTE]</span>
                  <span class="term-badge-ok">COBERTURA LIMITADA</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line safe-line"><span>udta:</span> ignorada pelo código</div>
                  <div class="term-line safe-line"><span>uuid XMP específico:</span> ignorado pelo código</div>
                  <div class="term-line safe-line"><span>Outras caixas:</span> copiadas, podem conter metadados</div>
                  <div class="term-line safe-line"><span>mdat:</span> bytes copiados sem reencodificação</div>
                  <div class="term-line danger-line"><span>Reprodução e cobertura total:</span> ainda não verificadas</div>
                </div>
              </div>
            </div>
            <p class="video-verification-note">O relatório público do projeto ainda não inclui amostra de vídeo. Não há teste de reprodução nem de remoção completa para MP4, MOV ou M4V. <a href="/verificacao/">Consulte o relatório, o método e os formatos verificados.</a></p>
          </section>

          <!-- Why clean metadata -->
          <section class="guide-section" aria-labelledby="heading-por-que">
            <div class="section-title-wrap">
              <span class="section-kicker">MOTIVOS CRÍTICOS</span>
              <h2 id="heading-por-que">Por que você deve limpar metadados de vídeo antes de compartilhar?</h2>
            </div>
            <p>
              O conteúdo de um contêiner varia conforme o aplicativo, as configurações de gravação e as edições feitas no arquivo. Serviços de compartilhamento também podem transformar ou remover dados de maneiras diferentes; não presuma que uma plataforma sempre preserve ou apague metadados:
            </p>

            <div class="risks-grid">
              <div class="risk-card">
                <div class="risk-badge">PERIGO 01</div>
                <h3>Localização, se estiver no arquivo</h3>
                <p>
                  Alguns arquivos podem conter localização ou outros dados de contexto. Inspecione o vídeo específico antes de compartilhar; a presença e a precisão desses campos variam.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">PERIGO 02</div>
                <h3>Informações do contêiner</h3>
                <p>
                  Caixas do contêiner podem armazenar nomes, datas ou metadados de ferramentas. O código só trata caixas específicas e não garante que todos esses dados sejam removidos.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">PERIGO 03</div>
                <h3>Revisão antes do envio</h3>
                <p>
                  Confira a saída com um leitor de metadados e reproduza o arquivo. Metadados e conteúdo visível, como legendas gravadas na imagem, são coisas diferentes.
                </p>
              </div>
            </div>
          </section>

          <!-- Step-by-Step Guide -->
          <section class="guide-section" aria-labelledby="heading-passos">
            <div class="section-title-wrap">
              <span class="section-kicker">TUTORIAL PASSO A PASSO</span>
              <h2 id="heading-passos">Como remover metadados de vídeos no navegador (Sem Instalação)</h2>
            </div>
            <p>
              Siga estas instruções simples para limpar seu arquivo em poucos segundos:
            </p>

            <div class="steps-flow">
              <div class="step-card">
                <div class="step-number">01</div>
                <div class="step-info">
                  <h3>Acesse o Removedor de Metadados</h3>
                  <p>
                    Abra o <a href="/#hero-section">Removedor de Metadados</a> no seu computador ou smartphone. Não é necessário criar conta, assinar plano ou instalar plugins.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">02</div>
                <div class="step-info">
                  <h3>Arraste ou Escolha seu Vídeo</h3>
                  <p>
                    Arraste um ou mais arquivos <strong>MP4, MOV ou M4V</strong> para a área de limpeza. Você também pode clicar no botão para selecionar os vídeos da galeria do seu dispositivo.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">03</div>
                <div class="step-info">
                    <h3>Processamento local com cobertura limitada</h3>
                  <p>
                    O código atual tenta remover caixas <code>udta</code> e caixas <code>uuid</code> com um identificador XMP específico. Outros metadados podem permanecer; os testes publicados ainda não verificam vídeos.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">04</div>
                <div class="step-info">
                    <h3>Baixe e verifique a cópia</h3>
                  <p>
                    Baixe a cópia e inspecione as tags com <code>exiftool -a -G1 -s arquivo.mp4</code>. Em seguida, abra-a em um player e confira imagem, som e duração. Guarde o original.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Format Compatibility Table -->
          <section class="guide-section" aria-labelledby="heading-formatos">
            <div class="section-title-wrap">
              <span class="section-kicker">TABELA TÉCNICA</span>
              <h2 id="heading-formatos">Formatos aceitos e o que foi testado</h2>
            </div>
            <p>
              Estes nomes de arquivo entram no caminho de vídeo do código. O relatório público ainda não tem uma amostra de vídeo, portanto não confirma a saída nem a reprodução:
            </p>

            <div class="table-container">
              <table class="specs-table">
                <thead>
                  <tr>
                    <th>Extensões aceitas</th>
                    <th>Alvo do código</th>
                    <th>Verificação e limites</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>MP4</strong></td>
                    <td>Caixas <code>udta</code> e caixas <code>uuid</code> com prefixo XMP específico.</td>
                    <td>Sem amostra publicada; outras caixas e tags podem permanecer. Reprodução não verificada.</td>
                  </tr>
                  <tr>
                    <td><strong>MOV</strong></td>
                    <td>Usa o mesmo caminho de caixas do código para arquivos de vídeo.</td>
                    <td>Sem amostra publicada; outras caixas e tags podem permanecer. Reprodução não verificada.</td>
                  </tr>
                  <tr>
                    <td><strong>M4V</strong></td>
                    <td>Usa o mesmo caminho de caixas do código para arquivos de vídeo.</td>
                    <td>Sem amostra publicada; outras caixas e tags podem permanecer. Reprodução não verificada.</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="video-verification-note">O código não percorre todas as estruturas possíveis: outras caixas, datas, metadados de faixas e dados em caixas não reconhecidas podem ficar no arquivo. Até haver testes de vídeo, processe apenas cópias e confira cada saída.</p>
          </section>

          <!-- FAQ Accordion -->
          <section class="guide-section" aria-labelledby="heading-faq">
            <div class="section-title-wrap">
              <span class="section-kicker">DÚVIDAS FREQUENTES</span>
              <h2 id="heading-faq">Perguntas Frequentes sobre Metadados de Vídeo</h2>
            </div>

            <div class="guide-faq-list">
              {faqItems.map((item) => (
                <details class="guide-faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Related Guides Navigation -->
          <section class="guide-section" aria-labelledby="heading-relacionados">
            <div class="section-title-wrap">
              <span class="section-kicker">CONTINUE APRENDENDO</span>
              <h2 id="heading-relacionados">Outros Guias de Limpeza de Metadados</h2>
            </div>

            <div class="related-cards-grid">
              <a href="/guias/remover-metadados-de-imagem/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                    <circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">FOTOS & EXIF</span>
                  <h3 class="rel-title">Remover metadados de imagem e foto</h3>
                  <p class="rel-desc">Aprenda a limpar dados EXIF e localização GPS de fotos JPEG, PNG, WebP e HEIC.</p>
                </div>
              </a>

              <a href="/guias/remover-metadados-pdf/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                    <polyline points="14 2 14 8 20 8"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">DOCUMENTOS & PDF</span>
                  <h3 class="rel-title">Remover metadados de PDF</h3>
                  <p class="rel-desc">Limpe propriedades padrão de autoria e confira as limitações para documentos PDF.</p>
                </div>
              </a>
            </div>
          </section>

        </article>

        <!-- Right Sticky Sidebar -->
        <aside class="guide-sidebar" aria-label="Painel de ações do guia">
          <div class="sidebar-sticky-card">
            <div class="sidebar-header">
              <span class="sidebar-badge">RESUMO RÁPIDO</span>
              <h2 class="sidebar-title">Higienização de Vídeo</h2>
            </div>

            <ul class="sidebar-checklist">
              <li>
                <span class="check-mark">✓</span>
                <span>O código aceita MP4, MOV e M4V</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Tenta remover udta e um tipo de XMP uuid</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Reprodução ainda não verificada</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>O arquivo é processado localmente</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Use uma cópia e confira cada saída</span>
              </li>
            </ul>

            <div class="sidebar-action-box">
              <a href="/#hero-section" class="sidebar-cta-btn">
                <span>Processar uma cópia de vídeo</span>
                <span aria-hidden="true">→</span>
              </a>
              <p class="sidebar-subtext">Reprodução e cobertura completa ainda não foram testadas.</p>
            </div>

            <div class="sidebar-help">
              <span class="help-title">Precisa de outro formato?</span>
              <a href="/#formatos" class="help-link">Ver lista de formatos suportados →</a>
            </div>
          </div>
        </aside>

      </div>

      <!-- Bottom High-Impact Callout -->
      <section class="guide-bottom-cta">
        <div class="bottom-cta-badge">TESTE COM UMA CÓPIA</div>
        <h2>Inspecione o vídeo antes de compartilhar</h2>
        <p>O código tenta remover caixas específicas, mas o relatório público ainda não confirma a reprodução nem a cobertura completa de MP4, MOV ou M4V.</p>
        <div class="bottom-cta-btns">
          <a href="/#hero-section" class="btn-cta-primary">
            <span>Processar uma cópia de vídeo</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/guias/" class="btn-cta-secondary">
            <span>Voltar para a Central de Guias</span>
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer lang="pt-BR" />
</Layout>

<style>
