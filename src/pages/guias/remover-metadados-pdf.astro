---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Como Remover Metadados de PDF Online Grátis | Autor e Datas';
const description = 'Remova nomes de autores, título, datas de criação e histórico XMP de documentos PDF no navegador. 100% privado, sem envio a servidores e grátis.';
const canonicalUrl = 'https://remover-metadados.com/guias/remover-metadados-pdf/';

const faqItems = [
  {
    question: 'Quais metadados estão embutidos em um arquivo PDF?',
    answer: 'Um documento PDF exportado pelo Word, LibreOffice, Canva ou Acrobat pode armazenar o nome completo do autor, empresa, título, assunto, palavras-chave, software criador, versão do sistema operacional, datas exatas de criação e modificação, além de fluxos XMP com histórico editorial.',
  },
  {
    question: 'A ferramenta apaga o texto, tabelas ou páginas do documento?',
    answer: 'Não. O processo remove exclusivamente as propriedades e tabelas de metadados binários (como Info Dictionaries e XMP Metadata Streams). O texto legível, fontes, imagens, vetores, páginas e o layout visual permanecem 100% idênticos ao original.',
  },
  {
    question: 'Posso higienizar um PDF assinado digitalmente (com certificado ICP-Brasil)?',
    answer: 'Recomendamos cautela redobrada. Qualquer alteração na estrutura binária de um PDF assinado pode invalidar a assinatura digital criptográfica. Se o documento exigir validade jurídica da assinatura, mantenha o original intacto e gere uma versão higienizada apenas quando a assinatura não for necessária.',
  },
  {
    question: 'Documentos protegidos por senha de abertura podem ser limpos?',
    answer: 'A ferramenta aceita PDFs desprotegidos. Se o documento tiver senha de abertura ou restrição de leitura, remova a senha no aplicativo de origem antes de processar o arquivo no navegador.',
  },
  {
    question: 'Meu documento confidencial é enviado para algum servidor?',
    answer: 'Não. Todo o processamento ocorre 100% localmente no seu navegador através de bibliotecas WebAssembly e manipulação binária de arquivos. Seu PDF nunca é transmitido para servidores remotos nem armazenado na internet, garantindo sigilo absoluto e conformidade com a LGPD.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://remover-metadados.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guias', 'item': 'https://remover-metadados.com/guias/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'PDF', 'item': canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': title,
  'description': description,
  'url': canonicalUrl,
  'inLanguage': 'pt-BR',
  'author': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'Como Remover Metadados de PDF Online',
  'description': 'Passo a passo para apagar autores, empresa e datas de criação de PDFs no navegador.',
  'totalTime': 'PT1M',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Abra a ferramenta gratuita',
      'text': 'Acesse o Removedor de Metadados diretamente no seu navegador.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Selecione seu documento PDF',
      'text': 'Arraste uma cópia do seu arquivo PDF para a área de limpeza ou clique para carregar.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Higienização binária local',
      'text': 'O navegador descarta blocos de autoria, software gerador e registros XMP na memória RAM.',
      'url': 'https://remover-metadados.com/#como-funciona',
    },
    {
      '@type': 'HowToStep',
      'position': 4,
      'name': 'Baixe o PDF protegido',
      'text': 'Faça o download do PDF pronto para envio com segurança e conformidade à LGPD.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  includeHreflang={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header lang="pt-BR" ptUrl="/guias/remover-metadados-pdf/" enUrl="/en/" isSubpage={true} />

  <main class="guide-main">
    <div class="page-wrap guide-container">

      <!-- Breadcrumbs -->
      <nav class="guide-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/guias/">Guias</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">PDF</span>
      </nav>

      <!-- Hero Header -->
      <header class="guide-hero">
        <div class="guide-kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>GUIA PRÁTICO · PDF, XMP & OFFICE</span>
        </div>

        <h1 class="guide-hero-h1">Como Remover Metadados de PDF Online</h1>

        <p class="guide-hero-lead">
          Antes de enviar um contrato, petição jurídica, proposta comercial ou currículo, verifique se o seu PDF não está expondo <strong>nomes de autores, razão social da empresa, histórico de edições e versões anteriores</strong>. Aprenda a higienizar seus documentos direto no navegador, com total privacidade e sem envio a servidores.
        </p>

        <!-- Quick Specs Strip -->
        <div class="guide-specs-strip">
          <div class="spec-pill">
            <span class="spec-label">DOCUMENTOS:</span>
            <span class="spec-val">PDF, DOCX, XLSX, PPTX</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">PRIVACIDADE:</span>
            <span class="spec-val">100% Local (Conforme LGPD)</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">VELOCIDADE:</span>
            <span class="spec-val">Instantâneo (&lt; 2 seg)</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">INTEGRIDADE:</span>
            <span class="spec-val">Texto & Layout Intactos</span>
          </div>
        </div>

        <div class="hero-cta-wrap">
          <a class="hero-cta-btn" href="/#hero-section">
            <span class="cta-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <line x1="10" y1="9" x2="8" y2="9"/>
              </svg>
            </span>
            <span>Remover Metadados do Meu PDF Agora</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="hero-cta-trust">✓ Processamento seguro no navegador · Sem envio a servidores · Total conformidade LGPD</p>
        </div>
      </header>

      <!-- Main Two-Column Layout -->
      <div class="guide-layout">
        
        <!-- Left Content Column -->
        <article class="guide-article">

          <!-- Before vs After Terminal Box -->
          <section class="guide-section" aria-labelledby="heading-pdf-demo">
            <div class="section-title-wrap">
              <span class="section-kicker">INSPEÇÃO REAL</span>
              <h2 id="heading-pdf-demo">Quais informações ocultas seu PDF carrega?</h2>
            </div>
            <p>
              Mesmo que você exporte um documento em PDF pronto para leitura, programas como Microsoft Word, Excel e Canva salvam dados de auditoria interna nas propriedades do arquivo:
            </p>

            <div class="terminal-comparison">
              <div class="terminal-box terminal-danger">
                <div class="terminal-header">
                  <span class="term-dot dot-red" aria-hidden="true"></span>
                  <span class="term-dot dot-yellow" aria-hidden="true"></span>
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">contrato_proposta.pdf [EXPOSTO]</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line danger-line"><span>Autor / Criador:</span> Dr. Roberto Silva (Advocacia Corporativa)</div>
                  <div class="term-line danger-line"><span>Empresa / Razão Social:</span> Silva &amp; Associados Consultoria S/A</div>
                  <div class="term-line danger-line"><span>Título do Documento:</span> Minuta_Fusao_Empresarial_v4_Final.docx</div>
                  <div class="term-line danger-line"><span>Aplicativo Gerador:</span> Microsoft Word para Office 365</div>
                  <div class="term-line danger-line"><span>Produtor do PDF:</span> macOS Version 14.3.1 Quartz PDFContext</div>
                  <div class="term-line danger-line"><span>Data de Criação:</span> 2026-02-14 09:12:44 -03:00</div>
                  <div class="term-line danger-line"><span>Metadados XMP:</span> Registros de 6 revisores anteriores detectados</div>
                </div>
              </div>

              <div class="terminal-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <polyline points="19 12 12 19 5 12"/>
                </svg>
              </div>

              <div class="terminal-box terminal-safe">
                <div class="terminal-header">
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">contrato_proposta_limpo.pdf [HIGIENIZADO]</span>
                  <span class="term-badge-ok">100% PROTEGIDO</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line safe-line"><span>Autor / Criador:</span> [REMOVIDO COMPLETAMENTE]</div>
                  <div class="term-line safe-line"><span>Empresa / Organização:</span> [NENHUM RASTRO ENCONTRADO]</div>
                  <div class="term-line safe-line"><span>Título / Assunto:</span> [HIGIENIZADO]</div>
                  <div class="term-line safe-line"><span>Aplicativo &amp; Produtor:</span> [APAGADOS]</div>
                  <div class="term-line safe-line"><span>Datas e Histórico:</span> [ZERADOS]</div>
                  <div class="term-line safe-line"><span>Fluxos XMP:</span> [DESCARTE TOTAL DE REVISÕES]</div>
                  <div class="term-line safe-line"><span>Conteúdo Visual:</span> 100% Páginas, Textos e Imagens Preservados</div>
                </div>
              </div>
            </div>
          </section>

          <!-- Why clean PDF metadata -->
          <section class="guide-section" aria-labelledby="heading-por-que-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">CONFORMIDADE & SIGILO</span>
              <h2 id="heading-por-que-pdf">Por que advogados, empresas e profissionais devem limpar PDFs?</h2>
            </div>
            <p>
              No meio corporativo e jurídico, o envio acidental de metadados pode violar acordos de confidencialidade (NDA), comprometer negociações estratégicas e desrespeitar a <strong>Lei Geral de Proteção de Dados (LGPD)</strong>:
            </p>

            <div class="risks-grid">
              <div class="risk-card">
                <div class="risk-badge">SIGILO 01</div>
                <h3>Identidade de Redatores e Fontes</h3>
                <p>
                  Petições judiciais e relatórios periciais podem expor estagiários, sócios ou consultores externos que redigiram o rascunho inicial do documento.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">SIGILO 02</div>
                <h3>Estratégias e Valores Anteriores</h3>
                <p>
                  O título original de um arquivo exportado pode revelar termos como <code>Proposta_Desconto_50_porcento.docx</code>, enfraquecendo sua negociação comercial.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">SIGILO 03</div>
                <h3>Pastas e Estrutura de Redes</h3>
                <p>
                  Alguns aplicativos salvam o caminho de pastas local (ex: <code>C:\Users\roberto\Clientes\Caso_Confidencial\</code>), expondo sua infraestrutura de TI.
                </p>
              </div>
            </div>
          </section>

          <!-- Step-by-Step Flow -->
          <section class="guide-section" aria-labelledby="heading-passos-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">TUTORIAL PASSO A PASSO</span>
              <h2 id="heading-passos-pdf">Como higienizar metadados de PDF no navegador (Sem Envio a Servidores)</h2>
            </div>
            <p>
              Siga estas instruções simples para limpar seu PDF antes de enviar por e-mail ou anexar em processos:
            </p>

            <div class="steps-flow">
              <div class="step-card">
                <div class="step-number">01</div>
                <div class="step-info">
                  <h3>Acesse o Removedor Local</h3>
                  <p>
                    Abra o <a href="/#hero-section">Removedor de Metadados</a> no seu navegador. Como o processamento é 100% client-side, seus contratos confidenciais nunca saem do seu computador.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">02</div>
                <div class="step-info">
                  <h3>Selecione uma Cópia do PDF</h3>
                  <p>
                    Arraste o arquivo <strong>PDF, DOCX, XLSX ou PPTX</strong> para a área de limpeza. Dica: sempre guarde seu documento original de edição em pasta segura.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">03</div>
                <div class="step-info">
                  <h3>Limpeza Binária de Propriedades</h3>
                  <p>
                    A ferramenta manipula a árvore de objetos do PDF e descarta o dicionário de informações (<code>/Info</code>) e o fluxo XML de metadados (<code>/Metadata</code>).
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">04</div>
                <div class="step-info">
                  <h3>Baixe o PDF Higienizado</h3>
                  <p>
                    Faça o download do PDF limpo. Você pode abrir as propriedades do arquivo no Adobe Acrobat ou no navegador para confirmar que todos os campos de autor foram removidos.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Format Compatibility Table -->
          <section class="guide-section" aria-labelledby="heading-formatos-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">TABELA TÉCNICA</span>
              <h2 id="heading-formatos-pdf">Metadados Removidos em Documentos</h2>
            </div>
            <p>
              Veja quais campos e propriedades são higienizados pela nossa ferramenta em PDFs e pacotes Office:
            </p>

            <div class="table-container">
              <table class="specs-table">
                <thead>
                  <tr>
                    <th>Tipo de Arquivo</th>
                    <th>Extensão</th>
                    <th>Campos Eliminados</th>
                    <th>Conformidade LGPD</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Documento PDF</strong></td>
                    <td><code>.pdf</code></td>
                    <td>Autor, Criador, Produtor, Título, Assunto, Datas, XMP</td>
                    <td><span class="table-badge-ok">Totalmente Conforme</span></td>
                  </tr>
                  <tr>
                    <td><strong>Microsoft Word</strong></td>
                    <td><code>.docx</code></td>
                    <td>Autor, Último Salvo Por, Tempo de Edição, Comentários ocultos</td>
                    <td><span class="table-badge-ok">Totalmente Conforme</span></td>
                  </tr>
                  <tr>
                    <td><strong>Microsoft Excel</strong></td>
                    <td><code>.xlsx</code></td>
                    <td>Nome da Empresa, Gerente, Histórico de Revisões</td>
                    <td><span class="table-badge-ok">Totalmente Conforme</span></td>
                  </tr>
                  <tr>
                    <td><strong>PowerPoint</strong></td>
                    <td><code>.pptx</code></td>
                    <td>Propriedades da apresentação e notas do apresentador</td>
                    <td><span class="table-badge-ok">Totalmente Conforme</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- FAQ Accordion -->
          <section class="guide-section" aria-labelledby="heading-faq-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">DÚVIDAS FREQUENTES</span>
              <h2 id="heading-faq-pdf">Perguntas Frequentes sobre Metadados de PDF</h2>
            </div>

            <div class="guide-faq-list">
              {faqItems.map((item) => (
                <details class="guide-faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Related Guides Navigation -->
          <section class="guide-section" aria-labelledby="heading-relacionados-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">CONTINUE APRENDENDO</span>
              <h2 id="heading-relacionados-pdf">Outros Guias de Limpeza de Metadados</h2>
            </div>

            <div class="related-cards-grid">
              <a href="/guias/remover-metadados-de-imagem/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                    <circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">FOTOS & EXIF</span>
                  <h3 class="rel-title">Remover metadados de imagem e foto</h3>
                  <p class="rel-desc">Aprenda a limpar dados EXIF e localização GPS de fotos JPEG, PNG, WebP e HEIC.</p>
                </div>
              </a>

              <a href="/guias/remover-metadados-de-video/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m22 8-6 4 6 4V8Z"/>
                    <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">ÁUDIO & VÍDEO</span>
                  <h3 class="rel-title">Remover metadados de vídeo online</h3>
                  <p class="rel-desc">Aprenda a limpar localização e dados do dispositivo de vídeos MP4 e MOV.</p>
                </div>
              </a>

              <a href="/blog/metadados-em-pdf-riscos-e-como-remover/" class="related-card blog-rel-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                    <path d="M6 6h10"/>
                    <path d="M6 10h10"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">ARTIGO DO BLOG · 7 MIN</span>
                  <h3 class="rel-title">Metadados Ocultos em PDFs & LGPD</h3>
                  <p class="rel-desc">Entenda como nomes de autores, caminhos de pastas e revisões vazam dados confidenciais.</p>
                </div>
              </a>
            </div>
          </section>

        </article>

        <!-- Right Sticky Sidebar -->
        <aside class="guide-sidebar" aria-label="Painel de ações do guia">
          <div class="sidebar-sticky-card">
            <div class="sidebar-header">
              <span class="sidebar-badge">RESUMO RÁPIDO</span>
              <h2 class="sidebar-title">Higienização de PDF</h2>
            </div>

            <ul class="sidebar-checklist">
              <li>
                <span class="check-mark">✓</span>
                <span>Remove nome do autor e empresa</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Descarta datas e software gerador</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Elimina fluxos de revisão XMP</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Mantém páginas e texto 100% intactos</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Totalmente compatível com a LGPD</span>
              </li>
            </ul>

            <div class="sidebar-action-box">
              <a href="/#hero-section" class="sidebar-cta-btn">
                <span>Limpar Meu PDF Agora</span>
                <span aria-hidden="true">→</span>
              </a>
              <p class="sidebar-subtext">Sem envio a servidores · Sem cadastro · 100% privado</p>
            </div>

            <div class="sidebar-help">
              <span class="help-title">Precisa de outro formato?</span>
              <a href="/#formatos" class="help-link">Ver lista de formatos suportados →</a>
            </div>
          </div>
        </aside>

      </div>

      <!-- Bottom High-Impact Callout -->
      <section class="guide-bottom-cta">
