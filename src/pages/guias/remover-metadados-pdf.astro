---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Como Remover Metadados de PDF | Campos Testados e Limites';
const description = 'Veja quais campos padrão de PDF foram testados, o que pode permanecer e como conferir a cópia baixada. Processamento local no navegador.';
const canonicalUrl = 'https://remover-metadados.com/guias/remover-metadados-pdf/';

const faqItems = [
  {
    question: 'Quais metadados estão embutidos em um arquivo PDF?',
    answer: 'Dependendo do arquivo e do programa que o criou, um PDF pode conter campos padrão como título, autor, assunto, palavras-chave, criador, produtor e datas, além de metadados XMP e outras estruturas. O conteúdo varia entre documentos.',
  },
  {
    question: 'Quais campos foram confirmados no teste do PDF?',
    answer: 'No PDF de teste publicado, ExifTool mostrou os campos Author, Title, Creator, Producer e Subject vazios após o processamento. O código também define Keywords como vazio e grava as datas de criação e modificação como 1º de janeiro de 1970; esses campos de data não são apagados e não foram verificados pelo teste publicado.',
  },
  {
    question: 'O que pode permanecer no PDF?',
    answer: 'O teste publicado encontrou uma propriedade personalizada e bytes XMP desvinculados que permaneceram no arquivo. Comentários, anexos, campos de formulário, metadados de imagens incorporadas e revisões anteriores também não fazem parte da cobertura verificada. Esta ferramenta não apaga texto ou imagens visíveis.',
  },
  {
    question: 'Como conferir a cópia baixada?',
    answer: 'Abra as propriedades do PDF e confira os campos padrão. Para uma inspeção mais detalhada, use ExifTool com o comando exiftool -a -G1 -s arquivo.pdf. Revise também as páginas, anexos, comentários e assinatura digital. O resultado do teste e as limitações estão na página de verificação.',
  },
  {
    question: 'A ferramenta altera o conteúdo visível ou a assinatura?',
    answer: 'A limpeza trata propriedades de metadados; ela não faz redação de texto ou imagens visíveis. Como o arquivo é modificado, a assinatura digital pode deixar de ser válida. Guarde o original e não use esta ferramenta como substituto de redação de conteúdo confidencial.',
  },
  {
    question: 'Meu PDF é enviado ao servidor?',
    answer: 'O arquivo selecionado é processado no navegador e não é enviado aos servidores do site. A página usa analytics e pode carregar recursos externos; consulte a política de privacidade para detalhes sobre as conexões do site.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://remover-metadados.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guias', 'item': 'https://remover-metadados.com/guias/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'PDF', 'item': canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  '@id': `${canonicalUrl}#article`,
  'mainEntityOfPage': { '@id': `${canonicalUrl}#webpage` },
  'headline': title,
  'description': description,
  'url': canonicalUrl,
  'inLanguage': 'pt-BR',
  'author': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'Como Remover Metadados de PDF Online',
  'description': 'Passo a passo para processar uma cópia de PDF no navegador e conferir os campos padrão e limitações do resultado.',
  'totalTime': 'PT1M',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Guarde uma cópia do PDF original',
      'text': 'Trabalhe em uma cópia do PDF e mantenha o original, especialmente se ele tiver uma assinatura digital.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Selecione o PDF',
      'text': 'Arraste a cópia do arquivo PDF para a ferramenta no navegador ou clique para selecioná-la.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Higienização binária local',
      'text': 'O teste publicado confirmou campos padrão específicos vazios; propriedades personalizadas e bytes XMP desvinculados podem permanecer.',
      'url': 'https://remover-metadados.com/#como-funciona',
    },
    {
      '@type': 'HowToStep',
      'position': 4,
      'name': 'Baixe e confira o PDF',
      'text': 'Inspecione as propriedades da cópia baixada e confira páginas, conteúdo, anexos e assinatura antes de compartilhar.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  mainEntityId={`${canonicalUrl}#article`}
  includeHreflang={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header lang="pt-BR" ptUrl="/guias/remover-metadados-pdf/" enUrl="/en/" isSubpage={true} />
  <p class="page-wrap" style="padding-top: 1rem; font-size: 0.85rem;"><a href="/verificacao/">Veja a cobertura real por formato, os testes e as limitações antes de compartilhar arquivos.</a></p>

  <main class="guide-main">
    <div class="page-wrap guide-container">

      <!-- Breadcrumbs -->
      <nav class="guide-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/guias/">Guias</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">PDF</span>
      </nav>

      <!-- Hero Header -->
      <header class="guide-hero">
        <div class="guide-kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>GUIA PRÁTICO · PDF, CAMPOS TESTADOS E LIMITES</span>
        </div>

        <h1 class="guide-hero-h1">Como Remover Metadados de PDF Online</h1>

        <p class="guide-hero-lead">
          PDFs podem conter propriedades de autoria e outros dados que não aparecem na página. Veja quais campos padrão foram confirmados em um arquivo de teste, quais dados podem permanecer e como revisar a cópia baixada. O arquivo é processado localmente no navegador.
        </p>

        <!-- Quick Specs Strip -->
        <div class="guide-specs-strip">
          <div class="spec-pill">
            <span class="spec-label">FORMATO DESTE GUIA:</span>
            <span class="spec-val">PDF</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">TESTE PUBLICADO:</span>
            <span class="spec-val">Campos padrão selecionados</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">PODEM PERMANECER:</span>
            <span class="spec-val">Propriedades extras e bytes XMP</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">PROCESSAMENTO:</span>
            <span class="spec-val">Local no navegador</span>
          </div>
        </div>

        <div class="hero-cta-wrap">
          <a class="hero-cta-btn" href="/#hero-section">
            <span class="cta-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <line x1="10" y1="9" x2="8" y2="9"/>
              </svg>
            </span>
            <span>Remover Metadados do Meu PDF Agora</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="hero-cta-trust">Use uma cópia · Confira os campos · Preserve o original</p>
        </div>
      </header>

      <!-- Main Two-Column Layout -->
      <div class="guide-layout">
        
        <!-- Left Content Column -->
        <article class="guide-article">

          <!-- Published PDF fixture results -->
          <section class="guide-section" aria-labelledby="heading-pdf-demo">
            <div class="section-title-wrap">
              <span class="section-kicker">RESULTADOS PUBLICADOS</span>
              <h2 id="heading-pdf-demo">O que o teste do PDF confirmou?</h2>
            </div>
            <p>
              O relatório público registra um teste feito pela equipe em um PDF sintético. O arquivo de entrada tinha os campos mostrados abaixo; ExifTool foi usado para inspecionar a cópia processada. Isso não é uma auditoria independente nem comprova todos os PDFs.
            </p>

            <div class="terminal-comparison">
              <div class="terminal-box terminal-danger">
                <div class="terminal-header">
                  <span class="term-dot dot-red" aria-hidden="true"></span>
                  <span class="term-dot dot-yellow" aria-hidden="true"></span>
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">PDF sintético de teste [ENTRADA]</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line danger-line"><span>PDF:Author:</span> Audit Test Author</div>
                  <div class="term-line danger-line"><span>PDF:Title:</span> Audit Test Title</div>
                  <div class="term-line danger-line"><span>PDF:Creator:</span> pdf-lib</div>
                  <div class="term-line danger-line"><span>PDF:Producer:</span> pdf-lib</div>
                  <div class="term-line danger-line"><span>Teste:</span> Campos padrão não vazios antes do processamento</div>
                </div>
              </div>

              <div class="terminal-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <polyline points="19 12 12 19 5 12"/>
                </svg>
              </div>

              <div class="terminal-box terminal-safe">
                <div class="terminal-header">
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">PDF sintético de teste [SAÍDA]</span>
                  <span class="term-badge-ok">VERIFICAÇÃO PUBLICADA</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line safe-line"><span>PDF:Author:</span> vazio</div>
                  <div class="term-line safe-line"><span>PDF:Title:</span> vazio</div>
                  <div class="term-line safe-line"><span>PDF:Creator / Producer:</span> vazio</div>
                  <div class="term-line safe-line"><span>PDF:Subject:</span> vazio</div>
                  <div class="term-line danger-line"><span>Propriedade personalizada:</span> ainda presente no teste</div>
                  <div class="term-line danger-line"><span>Bytes XMP desvinculados:</span> ainda presentes no teste</div>
                </div>
              </div>
            </div>
            <p class="verification-note">O relatório foi gerado em 22/10/2026 com Chrome, ExifTool e pdf-lib. Os campos de data são definidos como 01/01/1970 pelo código, mas não foram verificados por esse teste. <a href="/verificacao/">Consulte o relatório completo, o método e as limitações.</a></p>
          </section>

          <!-- Why clean PDF metadata -->
          <section class="guide-section" aria-labelledby="heading-por-que-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">REVISÃO DO ARQUIVO</span>
              <h2 id="heading-por-que-pdf">O que revisar antes de compartilhar um PDF?</h2>
            </div>
            <p>
              As propriedades de um PDF variam conforme o arquivo e o aplicativo que o criou. Revise os dados do documento e o conteúdo visível antes de compartilhar. Remover alguns campos não garante conformidade legal nem substitui a revisão de privacidade da sua organização:
            </p>

            <div class="risks-grid">
              <div class="risk-card">
                <div class="risk-badge">SIGILO 01</div>
                <h3>Identidade de Redatores e Fontes</h3>
                <p>
                  Petições judiciais e relatórios periciais podem expor estagiários, sócios ou consultores externos que redigiram o rascunho inicial do documento.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">SIGILO 02</div>
                <h3>Estratégias e Valores Anteriores</h3>
                <p>
                  O título original de um arquivo exportado pode revelar termos como <code>Proposta_Desconto_50_porcento.docx</code>, enfraquecendo sua negociação comercial.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">SIGILO 03</div>
                <h3>Pastas e Estrutura de Redes</h3>
                <p>
                  Alguns aplicativos salvam o caminho de pastas local (ex: <code>C:\Users\roberto\Clientes\Caso_Confidencial\</code>), expondo sua infraestrutura de TI.
                </p>
              </div>
            </div>
          </section>

          <!-- Step-by-Step Flow -->
          <section class="guide-section" aria-labelledby="heading-passos-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">TUTORIAL PASSO A PASSO</span>
              <h2 id="heading-passos-pdf">Como higienizar metadados de PDF no navegador (Sem Envio a Servidores)</h2>
            </div>
            <p>
              Siga estas instruções simples para limpar seu PDF antes de enviar por e-mail ou anexar em processos:
            </p>

            <div class="steps-flow">
              <div class="step-card">
                <div class="step-number">01</div>
                <div class="step-info">
                  <h3>Acesse o Removedor Local</h3>
                  <p>
                    Abra o <a href="/#hero-section">Removedor de Metadados</a> no navegador e trabalhe em uma cópia. O arquivo selecionado é processado no dispositivo.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">02</div>
                <div class="step-info">
                  <h3>Selecione uma Cópia do PDF</h3>
                  <p>
                    Arraste o arquivo <strong>PDF</strong> para a área de limpeza. Guarde o original, especialmente se ele tiver assinatura digital.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">03</div>
                <div class="step-info">
                  <h3>Limpeza Binária de Propriedades</h3>
                  <p>
                    O código limpa campos padrão do dicionário de informações, redefine datas e remove referências de metadados e PieceInfo do catálogo. Consulte abaixo quais campos foram verificados e o que pode permanecer.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">04</div>
                <div class="step-info">
                    <h3>Baixe e inspecione a cópia</h3>
                  <p>
                    Faça o download. Abra as propriedades no leitor de PDF e confira os campos padrão; para uma inspeção mais detalhada, use <code>exiftool -a -G1 -s arquivo.pdf</code>. Revise as páginas, anexos, comentários e assinatura antes de compartilhar.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Format Compatibility Table -->
          <section class="guide-section" aria-labelledby="heading-formatos-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">TABELA TÉCNICA</span>
              <h2 id="heading-formatos-pdf">Campos de PDF verificados e cobertura do código</h2>
            </div>
            <p>
              O teste publicado examinou um PDF sintético com ExifTool. A tabela separa o que o teste confirmou do que o código altera sem uma asserção de teste:
            </p>

            <div class="table-container">
              <table class="specs-table">
                <thead>
                  <tr>
                    <th>Campo PDF</th>
                    <th>Comportamento</th>
                    <th>Verificação</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Author, Title, Creator, Producer e Subject</strong></td>
                    <td>Os valores padrão ficam vazios após o processamento do PDF de teste.</td>
                    <td><span class="table-badge-ok">Confirmado no relatório</span></td>
                  </tr>
                  <tr>
                    <td><strong>Keywords</strong></td>
                    <td>O código grava uma lista vazia. O teste não começou com palavras-chave de exemplo.</td>
                    <td><span class="table-badge-ok">Código; sem valor de entrada no teste</span></td>
                  </tr>
                  <tr>
                    <td><strong>CreationDate e ModDate</strong></td>
                    <td>O código define as duas datas como 01/01/1970; elas não são removidas.</td>
                    <td><span class="table-badge-ok">Não verificado no teste</span></td>
                  </tr>
                  <tr>
                    <td><strong>XMP e PieceInfo no catálogo</strong></td>
                    <td>O código remove as referências do catálogo. Bytes XMP desvinculados permaneceram no teste.</td>
                    <td><span class="table-badge-ok">Limite confirmado</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="verification-note">O teste encontrou uma propriedade personalizada e bytes XMP desvinculados que ainda estavam no arquivo. Comentários, anexos, formulários, metadados de imagens incorporadas e revisões anteriores não foram validados. A ferramenta não redige conteúdo visível; alterações também podem invalidar assinaturas digitais.</p>
            <p class="verification-note">Para DOCX, XLSX, PPTX, ODT, ODS e ODP há testes sintéticos de propriedades de pacote, mas não testes completos de compatibilidade com cada aplicativo. Veja os <a href="/verificacao/">resultados e limitações por formato</a>.</p>
          </section>

          <!-- FAQ Accordion -->
          <section class="guide-section" aria-labelledby="heading-faq-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">DÚVIDAS FREQUENTES</span>
              <h2 id="heading-faq-pdf">Perguntas Frequentes sobre Metadados de PDF</h2>
            </div>

            <div class="guide-faq-list">
              {faqItems.map((item) => (
                <details class="guide-faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Related Guides Navigation -->
          <section class="guide-section" aria-labelledby="heading-relacionados-pdf">
            <div class="section-title-wrap">
              <span class="section-kicker">CONTINUE APRENDENDO</span>
              <h2 id="heading-relacionados-pdf">Outros Guias de Limpeza de Metadados</h2>
            </div>

            <div class="related-cards-grid">
              <a href="/guias/remover-metadados-de-imagem/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                    <circle cx="9" cy="9" r="2"/>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">FOTOS & EXIF</span>
                  <h3 class="rel-title">Remover metadados de imagem e foto</h3>
                  <p class="rel-desc">Aprenda a limpar dados EXIF e localização GPS de fotos JPEG, PNG, WebP e HEIC.</p>
                </div>
              </a>

              <a href="/guias/remover-metadados-de-video/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m22 8-6 4 6 4V8Z"/>
                    <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">ÁUDIO & VÍDEO</span>
                  <h3 class="rel-title">Remover metadados de vídeo online</h3>
                  <p class="rel-desc">Aprenda a limpar localização e dados do dispositivo de vídeos MP4 e MOV.</p>
                </div>
              </a>

              <a href="/blog/metadados-em-pdf-riscos-e-como-remover/" class="related-card blog-rel-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
                    <path d="M6 6h10"/>
                    <path d="M6 10h10"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">ARTIGO DO BLOG · 7 MIN</span>
                  <h3 class="rel-title">Metadados em PDF: Campos e Limites</h3>
                  <p class="rel-desc">Veja o que o teste confirmou, o que pode permanecer e como conferir uma cópia.</p>
                </div>
              </a>
            </div>
          </section>

        </article>

        <!-- Right Sticky Sidebar -->
        <aside class="guide-sidebar" aria-label="Painel de ações do guia">
          <div class="sidebar-sticky-card">
            <div class="sidebar-header">
              <span class="sidebar-badge">RESUMO RÁPIDO</span>
              <h2 class="sidebar-title">Higienização de PDF</h2>
            </div>

            <ul class="sidebar-checklist">
              <li>
              <span class="check-mark">✓</span>
                <span>Teste confirmou Author, Title, Creator, Producer e Subject vazios</span>
              </li>
              <li>
