---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Como Remover Metadados de Imagem e Foto | EXIF e GPS';
const description = 'Aprenda a remover dados EXIF, coordenadas de GPS e informações da câmera de fotos JPEG, PNG, WebP e HEIC no navegador com 100% de privacidade e grátis.';
const canonicalUrl = 'https://remover-metadados.com/guias/remover-metadados-de-imagem/';

const faqItems = [
  {
    question: 'O que são metadados EXIF de uma foto?',
    answer: 'EXIF (Exchangeable Image File Format) é um padrão que armazena informações técnicas e contextuais dentro do arquivo de imagem. Inclui coordenadas exatas de GPS de onde a foto foi tirada, data e hora, modelo do smartphone ou câmera, lente, abertura, velocidade do obturador, ISO e número de série.',
  },
  {
    question: 'Remover EXIF apaga a localização geográfica da foto?',
    answer: 'Sim. A ferramenta apaga todas as tags de geolocalização GPS (latitude, longitude, altitude e direção da bússola) gravadas pelo sensor do aparelho, impossibilitando que terceiros descubram onde a fotografia foi capturada.',
  },
  {
    question: 'A imagem perde resolução ou qualidade após a remoção?',
    answer: 'Não para o olho humano. Em formatos de vetor ou blocos estruturados como PNG, os metadados são retirados sem tocar nos pixels. Em JPEG e WebP, o arquivo é regravado na resolução nativa máxima sem compressão agressiva, mantendo nitidez e cores fiéis.',
  },
  {
    question: 'Tirar print (captura de tela) é suficiente para apagar metadados?',
    answer: 'Não é um método confiável nem profissional. O print comprime a imagem, diminui drasticamente a resolução e cria novos metadados com horário e resolução da sua tela. Usar um removedor dedicado limpa os metadados mantendo a resolução original da foto.',
  },
  {
    question: 'Minhas fotografias são enviadas para servidores na internet?',
    answer: 'Nunca. Nossa tecnologia funciona de maneira 100% local através do seu navegador. As fotos são processadas na memória RAM do seu aparelho e o download é gerado diretamente para você, sem tráfego de rede ou armazenamento externo.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Início', 'item': 'https://remover-metadados.com/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Guias', 'item': 'https://remover-metadados.com/guias/' },
    { '@type': 'ListItem', 'position': 3, 'name': 'Imagem', 'item': canonicalUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  'headline': title,
  'description': description,
  'url': canonicalUrl,
  'inLanguage': 'pt-BR',
  'author': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Remover Metadados',
    'url': 'https://remover-metadados.com/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'Como Remover Metadados de Imagem e Foto Online',
  'description': 'Passo a passo para apagar dados EXIF e localização GPS de fotos no navegador.',
  'totalTime': 'PT1M',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Abra a ferramenta gratuita',
      'text': 'Acesse a página inicial do Removedor de Metadados pelo seu navegador.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Selecione suas fotos',
      'text': 'Arraste imagens JPEG, PNG, WebP ou HEIC para a área de limpeza ou clique para escolher arquivos.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Higienização de EXIF local',
      'text': 'O navegador limpa dados de GPS, câmera e autoria instantaneamente na memória.',
      'url': 'https://remover-metadados.com/#como-funciona',
    },
    {
      '@type': 'HowToStep',
      'position': 4,
      'name': 'Baixe suas imagens limpas',
      'text': 'Faça o download das fotos individuais ou baixe todas reunidas em um arquivo ZIP protegido.',
      'url': 'https://remover-metadados.com/#hero-section',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  includeHreflang={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Header lang="pt-BR" ptUrl="/guias/remover-metadados-de-imagem/" enUrl="/en/" isSubpage={true} />

  <main class="guide-main">
    <div class="page-wrap guide-container">

      <!-- Breadcrumbs -->
      <nav class="guide-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/guias/">Guias</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">Imagem</span>
      </nav>

      <!-- Hero Header -->
      <header class="guide-hero">
        <div class="guide-kicker-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>GUIA PRÁTICO · EXIF, GPS & IPTC</span>
        </div>

        <h1 class="guide-hero-h1">Como Remover Metadados de Imagem e Foto Online</h1>

        <p class="guide-hero-lead">
          Toda foto tirada com seu celular carrega dados invisíveis além dos pixels: <strong>coordenadas de GPS da sua casa</strong>, modelo do smartphone, data, hora e lente. Veja como inspecionar e apagar esses dados EXIF em fotos JPEG, PNG, WebP e HEIC de forma 100% gratuita e local.
        </p>

        <!-- Quick Specs Strip -->
        <div class="guide-specs-strip">
          <div class="spec-pill">
            <span class="spec-label">FORMATOS:</span>
            <span class="spec-val">JPEG, PNG, WebP, HEIC</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">PRIVACIDADE:</span>
            <span class="spec-val">100% Local (Zero Upload)</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">VELOCIDADE:</span>
            <span class="spec-val">Instantânea (&lt; 1 seg)</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-pill">
            <span class="spec-label">LIMPEZA EM LOTE:</span>
            <span class="spec-val">Suportada (ZIP)</span>
          </div>
        </div>

        <div class="hero-cta-wrap">
          <a class="hero-cta-btn" href="/#hero-section">
            <span class="cta-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                <circle cx="9" cy="9" r="2"/>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
              </svg>
            </span>
            <span>Remover Metadados da Minha Foto Agora</span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="hero-cta-trust">✓ Processamento instantâneo no navegador · Sem uploads · Sem cadastro</p>
        </div>
      </header>

      <!-- Main Two-Column Layout -->
      <div class="guide-layout">
        
        <!-- Left Content Column -->
        <article class="guide-article">

          <!-- Before vs After Terminal Box -->
          <section class="guide-section" aria-labelledby="heading-exif-demo">
            <div class="section-title-wrap">
              <span class="section-kicker">INSPEÇÃO REAL</span>
              <h2 id="heading-exif-demo">O que uma foto comum revela sobre você?</h2>
            </div>
            <p>
              Ao compartilhar uma imagem em fóruns, anúncios de vendas ou redes sociais, qualquer pessoa com um leitor EXIF básico consegue extrair o mapa exato de onde a foto foi feita:
            </p>

            <div class="terminal-comparison">
              <div class="terminal-box terminal-danger">
                <div class="terminal-header">
                  <span class="term-dot dot-red" aria-hidden="true"></span>
                  <span class="term-dot dot-yellow" aria-hidden="true"></span>
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">foto_camera.jpg [EXPOSTO]</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line danger-line"><span>GPS Latitude:</span> -22.906847 S (Precisão: 3 metros)</div>
                  <div class="term-line danger-line"><span>GPS Longitude:</span> -43.172896 W (Rio de Janeiro, RJ)</div>
                  <div class="term-line danger-line"><span>Aparelho / Modelo:</span> Apple iPhone 15 Pro Max</div>
                  <div class="term-line danger-line"><span>Lente & Abertura:</span> 24mm f/1.78 ISO 64</div>
                  <div class="term-line danger-line"><span>Data e Hora:</span> 2026-03-15 11:34:10 -03:00</div>
                  <div class="term-line danger-line"><span>Número de Série:</span> C39ZF001MD42</div>
                </div>
              </div>

              <div class="terminal-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <polyline points="19 12 12 19 5 12"/>
                </svg>
              </div>

              <div class="terminal-box terminal-safe">
                <div class="terminal-header">
                  <span class="term-dot dot-green" aria-hidden="true"></span>
                  <span class="term-title">foto_higienizada.jpg [LIMPO]</span>
                  <span class="term-badge-ok">100% HIGIENIZADO</span>
                </div>
                <div class="terminal-body">
                  <div class="term-line safe-line"><span>GPS Latitude / Longitude:</span> [REMOVIDO COMPLETAMENTE]</div>
                  <div class="term-line safe-line"><span>Modelo da Câmera:</span> [NENHUM REGISTRO]</div>
                  <div class="term-line safe-line"><span>Lente e Configurações:</span> [APAGADOS]</div>
                  <div class="term-line safe-line"><span>Número de Série:</span> [HIGIENIZADO]</div>
                  <div class="term-line safe-line"><span>Data & Timestamp:</span> [ZERADOS]</div>
                  <div class="term-line safe-line"><span>Qualidade & Resolução:</span> 100% Preservada para visualização</div>
                </div>
              </div>
            </div>
          </section>

          <!-- Why clean photo metadata -->
          <section class="guide-section" aria-labelledby="heading-por-que-foto">
            <div class="section-title-wrap">
              <span class="section-kicker">MOTIVOS CRÍTICOS</span>
              <h2 id="heading-por-que-foto">Por que limpar metadados antes de publicar fotos na web?</h2>
            </div>
            <p>
              Mesmo plataformas que afirmam compactar imagens nem sempre removem todos os campos EXIF e IPTC. Em mensageiros como Telegram e Discord (ao enviar como arquivo ou documento), a foto é transmitida 100% crua com todos os dados de geolocalização.
            </p>

            <div class="risks-grid">
              <div class="risk-card">
                <div class="risk-badge">RISCO 01</div>
                <h3>Doxxing e Perseguição (Stalking)</h3>
                <p>
                  Fotos tiradas dentro de casa revelam o endereço exato com precisão milimétrica de GPS. Criminosos virtuais utilizam esses dados para mapear residências e rotinas diárias.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">RISCO 02</div>
                <h3>Venda de Bens em Marketplaces</h3>
                <p>
                  Ao fotografar um carro, eletrônico ou joia para vender em sites de anúncios, o anúncio pode expor onde o produto de alto valor está guardado.
                </p>
              </div>

              <div class="risk-card">
                <div class="risk-badge">RISCO 03</div>
                <h3>Fotos de Documentos e Crianças</h3>
                <p>
                  Fotos de carteira de motorista, contratos ou filhos em escolas e parques nunca devem carregar marcadores de geolocalização ou identificadores do celular.
                </p>
              </div>
            </div>
          </section>

          <!-- Step-by-Step Flow -->
          <section class="guide-section" aria-labelledby="heading-passos-foto">
            <div class="section-title-wrap">
              <span class="section-kicker">TUTORIAL PASSO A PASSO</span>
              <h2 id="heading-passos-foto">Como limpar metadados de fotos no navegador (Sem Cadastro)</h2>
            </div>
            <p>
              Siga estes passos rápidos para criar uma cópia higienizada em segundos:
            </p>

            <div class="steps-flow">
              <div class="step-card">
                <div class="step-number">01</div>
                <div class="step-info">
                  <h3>Abra o Removedor Online</h3>
                  <p>
                    Acesse o <a href="/#hero-section">Removedor de Metadados</a> no seu computador, tablet ou celular. Não há necessidade de instalar aplicativos ou extensões.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">02</div>
                <div class="step-info">
                  <h3>Selecione uma ou Múltiplas Fotos</h3>
                  <p>
                    Arraste suas fotos <strong>JPEG, PNG, WebP ou HEIC</strong> para a área de arrastar ou clique no botão para selecionar da galeria. Você pode processar dezenas de imagens em lote.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">03</div>
                <div class="step-info">
                  <h3>Limpeza Local no Navegador</h3>
                  <p>
                    A ferramenta processa o arquivo na memória do seu dispositivo, descartando blocos EXIF, marcadores GPS e miniaturas ocultas. Nada é transmitido pela internet.
                  </p>
                </div>
              </div>

              <div class="step-card">
                <div class="step-number">04</div>
                <div class="step-info">
                  <h3>Baixe a Cópia Protegida</h3>
                  <p>
                    Faça o download de cada foto limpa individualmente ou clique em <strong>Baixar Todos (.zip)</strong> para obter um pacote único pronto para compartilhamento seguro.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <!-- Format Compatibility Table -->
          <section class="guide-section" aria-labelledby="heading-formatos-foto">
            <div class="section-title-wrap">
              <span class="section-kicker">TABELA TÉCNICA</span>
              <h2 id="heading-formatos-foto">Formatos de Imagem Suportados</h2>
            </div>
            <p>
              Nosso removedor trata os principais formatos de imagem utilizados na web e fotografia digital:
            </p>

            <div class="table-container">
              <table class="specs-table">
                <thead>
                  <tr>
                    <th>Formato</th>
                    <th>Extensão</th>
                    <th>Metadados Eliminados</th>
                    <th>Preservação Visual</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>JPEG / JPG</strong></td>
                    <td><code>.jpg</code>, <code>.jpeg</code></td>
                    <td>EXIF, GPS, IPTC, XMP, Thumbnail interno</td>
                    <td><span class="table-badge-ok">Alta Fidelidade</span></td>
                  </tr>
                  <tr>
                    <td><strong>PNG</strong></td>
                    <td><code>.png</code></td>
                    <td>Chunks eXIf, tEXt, zTXt, iTXt, pHYs</td>
                    <td><span class="table-badge-ok">Sem Perda (Lossless)</span></td>
                  </tr>
                  <tr>
                    <td><strong>WebP</strong></td>
                    <td><code>.webp</code></td>
                    <td>Chunks EXIF e XMP embutidos no container RIFF</td>
                    <td><span class="table-badge-ok">Alta Fidelidade</span></td>
                  </tr>
                  <tr>
                    <td><strong>Apple HEIC / HEIF</strong></td>
                    <td><code>.heic</code>, <code>.heif</code></td>
                    <td>Metadados de câmera iOS, Live Photos, GPS</td>
                    <td><span class="table-badge-ok">Convertido / Limpo</span></td>
                  </tr>
                  <tr>
                    <td><strong>GIF</strong></td>
                    <td><code>.gif</code></td>
                    <td>Comentários de aplicação e autor</td>
                    <td><span class="table-badge-ok">Sem Perda</span></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- FAQ Accordion -->
          <section class="guide-section" aria-labelledby="heading-faq-foto">
            <div class="section-title-wrap">
              <span class="section-kicker">DÚVIDAS FREQUENTES</span>
              <h2 id="heading-faq-foto">Perguntas Frequentes sobre Metadados de Fotos</h2>
            </div>

            <div class="guide-faq-list">
              {faqItems.map((item) => (
                <details class="guide-faq-item">
                  <summary class="faq-summary">
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>

          <!-- Related Guides Navigation -->
          <section class="guide-section" aria-labelledby="heading-relacionados-foto">
            <div class="section-title-wrap">
              <span class="section-kicker">CONTINUE APRENDENDO</span>
              <h2 id="heading-relacionados-foto">Outros Guias de Limpeza de Metadados</h2>
            </div>

            <div class="related-cards-grid">
              <a href="/guias/remover-metadados-de-video/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m22 8-6 4 6 4V8Z"/>
                    <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">ÁUDIO & VÍDEO</span>
                  <h3 class="rel-title">Remover metadados de vídeo online</h3>
                  <p class="rel-desc">Aprenda a limpar localização e dados do dispositivo de vídeos MP4 e MOV.</p>
                </div>
              </a>

              <a href="/guias/remover-metadados-pdf/" class="related-card">
                <div class="rel-icon-box" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                    <polyline points="14 2 14 8 20 8"/>
                  </svg>
                </div>
                <div class="rel-card-info">
                  <span class="rel-tag">DOCUMENTOS & PDF</span>
                  <h3 class="rel-title">Remover metadados de PDF</h3>
                  <p class="rel-desc">Elimine nomes de autores, histórico de revisões e dados de empresas em documentos PDF.</p>
                </div>
              </a>
            </div>
          </section>

        </article>

        <!-- Right Sticky Sidebar -->
        <aside class="guide-sidebar" aria-label="Painel de ações do guia">
          <div class="sidebar-sticky-card">
            <div class="sidebar-header">
              <span class="sidebar-badge">RESUMO RÁPIDO</span>
              <h2 class="sidebar-title">Limpeza de Fotos & EXIF</h2>
            </div>

            <ul class="sidebar-checklist">
              <li>
                <span class="check-mark">✓</span>
                <span>Suporta JPEG, PNG, WebP e HEIC</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Apaga GPS exato e altitude</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Remove modelo da câmera e lente</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Processamento 100% no navegador</span>
              </li>
              <li>
                <span class="check-mark">✓</span>
                <span>Download individual ou em lote (ZIP)</span>
              </li>
            </ul>

            <div class="sidebar-action-box">
              <a href="/#hero-section" class="sidebar-cta-btn">
                <span>Limpar Minha Foto Agora</span>
                <span aria-hidden="true">→</span>
              </a>
              <p class="sidebar-subtext">Sem uploads · Sem cadastro · 100% grátis</p>
            </div>

            <div class="sidebar-help">
              <span class="help-title">Precisa de outro formato?</span>
              <a href="/#formatos" class="help-link">Ver lista de formatos suportados →</a>
            </div>
          </div>
        </aside>

      </div>

      <!-- Bottom High-Impact Callout -->
      <section class="guide-bottom-cta">
        <div class="bottom-cta-badge">PRIVACIDADE ABSOLUTA</div>
        <h2>Pronto para postar suas fotos com total segurança?</h2>
        <p>Arraste suas imagens e gere cópias higienizadas em segundos no seu navegador.</p>
        <div class="bottom-cta-btns">
          <a href="/#hero-section" class="btn-cta-primary">
            <span>Abrir Removedor de Imagens</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/guias/" class="btn-cta-secondary">
            <span>Voltar para a Central de Guias</span>
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer lang="pt-BR" />
</Layout>

<style>
  /* ── Layout & Typography ─────────────────────────────────── */
  .guide-main {
    min-height: 70vh;
    padding: 1.5rem 0 6rem;
  }

  .guide-container {
    text-align: left;
  }

  /* ── Breadcrumb ─────────────────────────────────────────── */
  .guide-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.5rem 0 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .guide-breadcrumb a {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .guide-breadcrumb a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .crumb-sep {
    color: var(--text-faint);
  }

  .crumb-current {
    color: var(--text-muted);
  }

  /* ── Hero Header ────────────────────────────────────────── */
  .guide-hero {
    max-width: 920px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .guide-kicker-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    padding: 0.35rem 0.85rem;
    border-radius: 3px;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text);
    text-transform: uppercase;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.25); opacity: 0.65; }
  }

  .guide-hero-h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--text);
    margin: 0 auto 1.25rem;
    text-wrap: balance;
  }

  .guide-hero-lead {
    font-size: clamp(0.98rem, 2vw, 1.12rem);
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 780px;
    margin: 0 auto 2rem;
  }

  .guide-hero-lead strong {
    color: var(--text);
  }

  .guide-specs-strip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: 0.65rem 1.25rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    margin-bottom: 2rem;
  }

  .spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .spec-label {
    color: var(--text-muted);
    font-weight: 700;
  }

  .spec-val {
    color: var(--text);
    font-weight: 700;
  }

  .spec-divider {
    width: 1px;
    height: 14px;
    background: var(--border-light);
  }

  .hero-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2.5px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: 0.9rem 1.75rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.12s ease;
  }

  .hero-cta-btn:hover {
    background: var(--btn-accent-hover);
    transform: translate(-2px, -2px);
    box-shadow: var(--neo-shadow-lg);
  }

  .hero-cta-trust {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Two Column Layout ──────────────────────────────────── */
  .guide-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 3rem;
    max-width: 1180px;
    margin: 0 auto;
    text-align: left;
  }

  .guide-article {
    min-width: 0;
    text-align: left;
  }

  .guide-section {
    margin-bottom: 3.5rem;
    text-align: left;
  }

  .section-title-wrap {
    margin-bottom: 1.25rem;
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    border: 1px solid var(--border);
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    margin-bottom: 0.65rem;
  }

  .guide-section h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0;
    text-transform: none;
  }

  .guide-section p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }

  .guide-section p strong {
    color: var(--text);
  }

  .guide-section code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--card-bg);
    border: 1px solid var(--border);
    padding: 0.15rem 0.35rem;
    border-radius: 2px;
    color: var(--text);
  }

  /* ── Terminal Inspection Box ────────────────────────────── */
  .terminal-comparison {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .terminal-box {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 4px;
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1.5px solid var(--border);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .term-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--border);
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #10b981; }

  .term-title {
    color: var(--text);
    margin-left: 0.25rem;
  }

  .term-badge-ok {
    margin-left: auto;
    background: #10b981;
    color: #ffffff;
    font-size: 0.6rem;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    border: 1px solid var(--border);
  }

  .terminal-body {
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .term-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .danger-line span {
    color: var(--text-muted);
  }

  .danger-line {
    color: #ef4444;
  }

  .safe-line span {
    color: var(--text-muted);
  }

  .safe-line {
    color: #10b981;
    font-weight: 700;
  }

  .terminal-arrow {
    display: flex;
    justify-content: center;
    color: var(--text-muted);
  }

  /* ── Risks Grid ─────────────────────────────────────────── */
  .risks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }

  .risk-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    padding: 1.25rem;
    border-radius: 3px;
  }

  .risk-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    display: inline-block;
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    margin-bottom: 0.75rem;
  }

  .risk-card h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.55rem;
    line-height: 1.3;
  }

  .risk-card p {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Steps Flow ─────────────────────────────────────────── */
  .steps-flow {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin: 1.5rem 0 2rem;
  }

  .step-card {
    display: flex;
    gap: 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: 1.25rem 1.5rem;
    border-radius: 3px;
    align-items: flex-start;
  }

  .step-number {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .step-info {
    flex: 1 1 auto;
  }

  .step-info h3 {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.45rem;
  }

  .step-info p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .step-info a {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Table Container ────────────────────────────────────── */
  .table-container {
    overflow-x: auto;
    margin: 1.5rem 0 2rem;
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 3px;
    background: var(--card-bg);
  }

  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    text-align: left;
  }

  .specs-table th {
    background: var(--bg);
    padding: 0.85rem 1rem;
    border-bottom: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
  }

  .specs-table td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-muted);
  }

  .specs-table tr:last-child td {
    border-bottom: none;
  }

  .table-badge-ok {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid #10b981;
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  /* ── FAQ ────────────────────────────────────────────────── */
  .guide-faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .guide-faq-item {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    overflow: hidden;
    text-align: left;
  }

  .guide-faq-item:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .guide-faq-item[open] {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .faq-summary {
    padding: 1.25rem 1.4rem;
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-heading);
    color: var(--text);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    user-select: none;
    border-bottom: 2px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    text-align: left;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .guide-faq-item[open] .faq-summary {
    border-bottom: 2px solid var(--border);
    background: var(--bg);
  }

  .faq-question {
    flex: 1;
    line-height: 1.4;
    text-align: left;
  }

  .faq-icon {
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    background: var(--card-bg);
    border-radius: 2px;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .guide-faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .faq-answer {
    padding: 1.25rem 1.4rem;
    text-align: left;
  }

  .faq-answer p {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
    text-align: left;
  }

  /* ── Related Guides ─────────────────────────────────────── */
  .related-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }

  .related-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 3px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .related-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--neo-shadow-lg);
  }

  .rel-icon-box {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .rel-card-info {
    display: flex;
    flex-direction: column;
  }

  .rel-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .rel-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.45rem;
    line-height: 1.3;
  }

  .related-card:hover .rel-title {
    color: var(--link-color);
    text-decoration: underline;
  }

  .rel-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Right Sticky Sidebar ───────────────────────────────── */
  .guide-sidebar {
    position: sticky;
    top: 1.5rem;
    align-self: start;
  }

  .sidebar-sticky-card {
    background: var(--card-bg);
    border: 2.5px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 4px;
    padding: 1.5rem;
  }

  .sidebar-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.95rem;
    border-bottom: 1.5px solid var(--border-light);
  }

  .sidebar-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    border: 1px solid var(--border);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .sidebar-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.25;
    text-transform: none;
  }

  .sidebar-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .sidebar-checklist li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .check-mark {
    color: #10b981;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .sidebar-action-box {
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1.5px solid var(--border-light);
  }

  .sidebar-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2.5px 2.5px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.12s ease;
  }

  .sidebar-cta-btn:hover {
    background: var(--btn-accent-hover);
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4px 4px 0 var(--shadow-color);
  }

  .sidebar-subtext {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
    text-align: center;
    margin: 0.55rem 0 0;
  }

  .sidebar-help {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .help-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .help-link {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ── Bottom Callout Banner ──────────────────────────────── */
  .guide-bottom-cta {
    background: var(--card-bg);
    border: 3px solid var(--border);
    box-shadow: var(--neo-shadow-lg);
    border-radius: 6px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
    text-align: center;
    margin: 4rem auto 0;
    max-width: 960px;
  }

  .bottom-cta-badge {
    display: inline-block;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 2px;
    margin-bottom: 1rem;
  }

  .guide-bottom-cta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.3rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin: 0 auto 0.85rem;
    max-width: 700px;
    text-align: center;
    text-transform: none;
  }

  .guide-bottom-cta p {
    color: var(--text-muted);
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    line-height: 1.7;
    max-width: 650px;
    margin: 0 auto 1.75rem;
    text-align: center;
  }

  .bottom-cta-btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .btn-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--shadow-color);
    padding: 0.85rem 1.6rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.12s ease;
  }

  .btn-cta-primary:hover {
    background: var(--btn-accent-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--shadow-color);
  }

  .btn-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--bg);
    color: var(--text);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--shadow-color);
    padding: 0.85rem 1.4rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.12s ease;
  }

  .btn-cta-secondary:hover {
    background: var(--card-bg);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--shadow-color);
  }

  /* ── Responsive Breakpoints ─────────────────────────────── */
  @media (max-width: 960px) {
    .guide-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .guide-sidebar {
      position: static;
      order: 2;
    }

    .risks-grid {
      grid-template-columns: 1fr;
    }

    .related-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .guide-main {
      padding: 1rem 0 4rem;
    }

    .guide-specs-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
      width: 100%;
    }

    .spec-divider {
      display: none;
    }

    .step-card {
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-cta-btn,
    .btn-cta-primary,
    .btn-cta-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  class FaqAccordion {
    constructor(el) {
      this.el = el;
      this.summary = el.querySelector('summary');
      this.content = el.querySelector('.faq-answer');
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.summary?.addEventListener('click', (e) => this.onClick(e));
    }

    onClick(e) {
      e.preventDefault();
      this.el.style.overflow = 'hidden';
      if (this.isClosing || !this.el.open) {
        this.open();
      } else if (this.isExpanding || this.el.open) {
        this.shrink();
      }
    }

    shrink() {
      this.isClosing = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate({
        height: [startHeight, endHeight]
      }, {
        duration: 250,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
      });

      this.content?.animate({
        opacity: [1, 0],
        transform: ['translateY(0px)', 'translateY(-6px)']
      }, {
        duration: 200,
        easing: 'ease-out'
      });

      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => (this.isClosing = false);
    }

    open() {
      this.el.style.height = `${this.el.offsetHeight}px`;
      this.el.open = true;
      window.requestAnimationFrame(() => this.expand());
    }

    expand() {
      this.isExpanding = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight + (this.content?.offsetHeight || 0)}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate({
        height: [startHeight, endHeight]
      }, {
        duration: 280,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
      });

      this.content?.animate({
        opacity: [0, 1],
        transform: ['translateY(-6px)', 'translateY(0px)']
      }, {
        duration: 260,
        easing: 'ease-out'
      });

      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => (this.isExpanding = false);
    }

    onAnimationFinish(open) {
      this.el.open = open;
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.el.style.height = '';
      this.el.style.overflow = '';
    }
  }

  document.querySelectorAll('details.guide-faq-item').forEach((el) => {
    new FaqAccordion(el);
  });
</script>
