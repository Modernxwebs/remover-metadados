---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Guias para Remover Metadados | Fotos, Vídeos e PDFs';
const description = 'Guias para remover metadados de fotos, vídeos e PDFs. Consulte os campos verificados, as limitações por formato e como conferir uma cópia processada.';
const canonicalUrl = 'https://remover-metadados.com/guias/';

const guides = [
  {
    id: 'imagem',
    category: 'Fotos & Imagens',
    categorySlug: 'imagem',
    typeTag: 'EXIF · GPS · IPTC',
    title: 'Remover metadados de imagem e foto',
    slug: '/guias/remover-metadados-de-imagem/',
    readTime: '4 min de leitura',
    icon: 'image',
    badge: 'Mais Acessado',
    summary: 'Veja quais dados EXIF fotos de celular e câmeras carregam e aprenda a criar cópias com os campos compatíveis removidos sem expor a localização da sua casa ou trabalho.',
    highlights: [
      'Apaga geolocalização exata (latitude, longitude, altitude)',
      'Remove modelo da câmera, número de série, lente e ISO',
      'Suporte para limpeza em lote com download em arquivo ZIP',
    ],
    formats: ['JPEG', 'PNG', 'WEBP', 'HEIC', 'GIF'],
  },
  {
    id: 'video',
    category: 'Áudio & Vídeo',
    categorySlug: 'video',
    typeTag: 'MP4 · MOV · M4V',
    title: 'Remover metadados de vídeo online',
    slug: '/guias/remover-metadados-de-video/',
    readTime: '3 min de leitura',
    icon: 'video',
    badge: 'Essencial',
    summary: 'A ferramenta aceita MP4, MOV e M4V e direciona a limpeza a caixas udta e a um tipo específico de XMP. Os testes publicados ainda não verificam reprodução nem cobertura completa de vídeo.',
    highlights: [
      'Veja exatamente quais caixas o código remove',
      'Outras tags e dados de faixa podem permanecer',
      'Confira a cópia em um player e com um leitor de metadados',
    ],
    formats: ['MP4', 'MOV', 'M4V'],
  },
  {
    id: 'pdf',
    category: 'Documentos',
    categorySlug: 'pdf',
    typeTag: 'PDF · XMP · OFFICE',
    title: 'Remover metadados de PDF e Documentos',
    slug: '/guias/remover-metadados-pdf/',
    readTime: '3 min de leitura',
    icon: 'pdf',
    badge: 'Campos verificados',
    summary: 'O teste público confirmou campos padrão de autoria vazios na cópia. Datas são redefinidas, enquanto propriedades personalizadas e bytes XMP desvinculados podem permanecer.',
    highlights: [
      'Autor, título, criador, produtor e assunto ficaram vazios no PDF de teste',
      'Datas são definidas para 1970; não são apagadas',
      'Propriedades personalizadas, bytes XMP e outros dados podem permanecer',
    ],
    formats: ['PDF'],
  },
];

const faqs = [
  {
    q: 'O que são metadados e por que devo removê-los?',
    a: 'Metadados são informações associadas ao arquivo, como campos de autoria, datas ou localização, quando o formato e o aplicativo os gravam. O conteúdo varia por arquivo. A remoção de alguns campos pode reduzir exposição, mas não garante anonimização nem substitui a revisão do arquivo.',
  },
  {
    q: 'A ferramenta reduz a qualidade da imagem ou do vídeo ao limpar?',
    a: 'Depende do formato. PNG normalmente preserva os dados de imagem comprimidos; JPEG, WebP e AVIF são recodificados e podem perder qualidade. HEIC vira JPEG; GIF e TIFF viram PNG de um quadro ou página. Vídeos são tratados por um caminho de caixas do contêiner, mas os testes publicados ainda não verificam reprodução ou cobertura completa. Consulte a página de verificação.',
  },
  {
    q: 'Onde os arquivos selecionados são processados?',
    a: 'A ferramenta processa o conteúdo dos arquivos no navegador e não envia os arquivos selecionados ao servidor. O site ainda carrega analytics e outros recursos externos; veja a política de privacidade para entender as conexões da página.',
  },
  {
    q: 'Como verificar se os metadados foram realmente excluídos?',
    a: 'Confira a cópia baixada com um leitor adequado ao formato. Para PDFs, veja as propriedades do documento ou use ExifTool; para vídeos, examine as tags e confirme que o arquivo toca com imagem e som. A página de verificação mostra o que os testes atuais cobrem e o que não foi testado.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Início',
      'item': 'https://remover-metadados.com/',
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Guias',
      'item': 'https://remover-metadados.com/guias/',
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': 'https://remover-metadados.com/guias/#guides',
  'name': 'Guias Práticos para Remover Metadados | Remover Metadados',
  'description': description,
  'itemListElement': guides.map((guide, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'url': `https://remover-metadados.com${guide.slug}`,
      'name': guide.title,
      'description': guide.summary,
  })),
};
---

<Layout
  pageType="CollectionPage"
  mainEntityId="https://remover-metadados.com/guias/#guides"
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  includeHreflang={false}
>
  <!-- Schema.org Rich Structured Data for Guide Hub Collection -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <Header lang="pt-BR" ptUrl="/guias/" enUrl="/en/" isSubpage={true} />
  <p class="page-wrap" style="padding-top: 1rem; font-size: 0.85rem;"><a href="/verificacao/">Veja a cobertura real por formato, os testes e as limitações antes de compartilhar arquivos.</a></p>

  <main class="guides-main">
    <div class="page-wrap guides-container">

      <!-- Breadcrumbs -->
      <nav class="guides-breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Remover Metadados</a>
        <span class="crumb-separator" aria-hidden="true">/</span>
        <span class="crumb-active" aria-current="page">Guias</span>
      </nav>

      <!-- Hero Header -->
      <header class="guides-hero">
        <div class="kicker-wrap">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span class="guides-kicker">CENTRAL DE PRIVACIDADE & GUIAS TÉCNICOS</span>
        </div>

        <h1 class="guides-hero-title">Guias Práticos para Remover Metadados com Segurança</h1>

        <p class="guides-hero-lead">
          Fotos, vídeos e documentos podem conter dados que não aparecem na tela, como autoria, datas ou localização. Explore os tutoriais para ver a cobertura testada e as limitações de cada formato. O processamento dos arquivos ocorre localmente no navegador.
        </p>

        <!-- Technical Trust Chips -->
        <div class="tech-metrics-bar">
          <div class="metric-item">
            <span class="metric-icon" aria-hidden="true">🔒</span>
            <span class="metric-text"><strong>100% Local</strong> (Sem Envio a Servidores)</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-icon" aria-hidden="true">⚡</span>
            <span class="metric-text"><strong>Limpeza Instantânea</strong> no Navegador</span>
          </div>
          <div class="metric-divider" aria-hidden="true"></div>
          <div class="metric-item">
            <span class="metric-icon" aria-hidden="true">🛡️</span>
            <span class="metric-text"><strong>Arquivos locais</strong> & Sem Upload</span>
          </div>
        </div>
      </header>

      <!-- Category Filter Bar -->
      <section class="guides-filter-section" aria-label="Filtrar guias por formato">
        <div class="filter-header">
          <span class="filter-label">ESCOLHA UMA CATEGORIA:</span>
          <span class="guides-count-pill">3 GUIAS DISPONÍVEIS</span>
        </div>
        <div class="filter-pills" role="tablist" id="filter-pills">
          <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">
            <span class="filter-name">Todos os Guias</span>
            <span class="filter-badge">3</span>
          </button>
          <button class="filter-btn" data-filter="imagem" role="tab" aria-selected="false">
            <span class="filter-name">Fotos & Imagens</span>
            <span class="filter-badge">EXIF</span>
          </button>
          <button class="filter-btn" data-filter="video" role="tab" aria-selected="false">
            <span class="filter-name">Áudio & Vídeo</span>
            <span class="filter-badge">MP4</span>
          </button>
          <button class="filter-btn" data-filter="pdf" role="tab" aria-selected="false">
            <span class="filter-name">Documentos</span>
            <span class="filter-badge">PDF</span>
          </button>
        </div>
      </section>

      <!-- Guides Bento Grid -->
      <section class="guides-grid-section" aria-labelledby="section-guides-title">
        <h2 id="section-guides-title" class="sr-only">Tutoriais Disponíveis</h2>

        <div class="guides-grid" id="guides-container">
          {guides.map((guide) => (
            <article class="guide-card" data-category={guide.categorySlug}>
              <!-- Top Metadata Strip -->
              <div class="guide-card-top">
                <div class="guide-card-header-left">
                  <div class="guide-icon-box" aria-hidden="true">
                    {guide.icon === 'image' && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                      </svg>
                    )}
                    {guide.icon === 'video' && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m22 8-6 4 6 4V8Z"/>
                        <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                      </svg>
                    )}
                    {guide.icon === 'pdf' && (
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                        <line x1="10" y1="9" x2="8" y2="9"/>
                      </svg>
                    )}
                  </div>
                  <div class="guide-category-meta">
                    <span class="guide-cat-text">{guide.category}</span>
                    <span class="guide-type-pill">{guide.typeTag}</span>
                  </div>
                </div>

                <div class="guide-card-header-right">
                  <span class="guide-badge-pill">{guide.badge}</span>
                </div>
              </div>

              <!-- Main Title & Summary -->
              <div class="guide-card-content">
                <h3 class="guide-title">
                  <a href={guide.slug} class="guide-title-link">
                    {guide.title}
                  </a>
                </h3>

                <p class="guide-desc">{guide.summary}</p>

                <!-- What you will learn checklist -->
                <div class="guide-highlights-box">
                  <div class="highlights-heading">O QUE VOCÊ APRENDE A LIMPAR:</div>
                  <ul class="highlights-list">
                    {guide.highlights.map((item) => (
                      <li>
                        <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Bottom Bar: Formats & Action CTA -->
              <div class="guide-card-footer">
                <div class="formats-tags">
                  {guide.formats.map((fmt) => (
                    <span class="fmt-tag">{fmt}</span>
                  ))}
                  <span class="read-time-tag">⏱️ {guide.readTime}</span>
                </div>

                <a href={guide.slug} class="guide-action-btn">
                  <span>Ler o Guia Completo</span>
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Blog Spotlight Callout -->
      <section class="guides-blog-section" aria-labelledby="blog-spotlight-heading" style="margin-top: 3.5rem; padding: 2.25rem; background: var(--card-bg); border: 2.5px solid var(--border); box-shadow: var(--neo-shadow); border-radius: 4px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
          <div>
            <span style="font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; color: var(--btn-accent-text); background: var(--btn-accent); padding: 0.2rem 0.6rem; border: 1.5px solid var(--border); border-radius: 2px;">BLOG DE PRIVACIDADE</span>
            <h2 id="blog-spotlight-heading" style="font-family: var(--font-heading); font-size: clamp(1.35rem, 2.5vw, 1.75rem); font-weight: 700; color: var(--text); margin: 0.5rem 0 0.25rem;">Artigos & Análises Aprofundadas</h2>
            <p style="font-size: 0.92rem; color: var(--text-muted); margin: 0; line-height: 1.5;">Investigações técnicas e tutoriais avançados sobre segurança digital e metadados ocultos.</p>
          </div>
          <a href="/blog/" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.5rem 1rem; background: var(--btn-accent); color: var(--btn-accent-text); border: 2px solid var(--border); box-shadow: 2px 2px 0 var(--shadow-color); border-radius: 3px; font-weight: 700; font-size: 0.85rem; text-decoration: none;">
            <span>Acessar o Blog</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
          <a href="/blog/o-que-sao-metadados-exif-guia-completo/" style="display: flex; flex-direction: column; padding: 1.25rem; background: var(--bg); border: 2px solid var(--border); box-shadow: 2px 2px 0 var(--shadow-color); border-radius: 3px; text-decoration: none; color: var(--text);">
            <span style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.4rem;">FOTOS & IMAGENS · 8 MIN</span>
            <h3 style="font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; line-height: 1.35; margin: 0 0 0.5rem; color: var(--text);">O que são Metadados EXIF: Guia Definitivo sobre Dados em Fotos</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 0.75rem; flex-grow: 1;">Saiba o que seu celular grava em segredo e os perigos reais de vendas online e perseguição.</p>
            <span style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--link-color);">Ler artigo &rarr;</span>
          </a>
          <a href="/blog/metadados-em-pdf-riscos-e-como-remover/" style="display: flex; flex-direction: column; padding: 1.25rem; background: var(--bg); border: 2px solid var(--border); box-shadow: 2px 2px 0 var(--shadow-color); border-radius: 3px; text-decoration: none; color: var(--text);">
            <span style="font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--text-muted); margin-bottom: 0.4rem;">DOCUMENTOS & PDF · 7 MIN</span>
            <h3 style="font-family: var(--font-heading); font-size: 1.05rem; font-weight: 700; line-height: 1.35; margin: 0 0 0.5rem; color: var(--text);">Metadados em PDF: Campos, Limites e Como Conferir</h3>
            <p style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.55; margin: 0 0 0.75rem; flex-grow: 1;">Entenda os campos padrão, os limites do teste publicado e como revisar uma cópia processada.</p>
            <span style="font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; color: var(--link-color);">Ler artigo &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Knowledge Spotlight Section: Por que limpar metadados? -->
      <section class="knowledge-section" aria-labelledby="knowledge-heading">
        <div class="knowledge-header">
          <div class="kicker-wrap-sm">
            <span class="guides-kicker">SEGURANÇA DA INFORMAÇÃO</span>
          </div>
          <h2 id="knowledge-heading" class="knowledge-title">Por que você deve remover metadados antes de compartilhar?</h2>
          <p class="knowledge-subtitle">Entenda os três principais riscos de expor metadados em arquivos digitais no seu dia a dia.</p>
        </div>

        <div class="knowledge-grid">
          <div class="knowledge-card">
            <div class="knowledge-card-badge">01 · GEOLOCALIZAÇÃO</div>
            <h3 class="knowledge-card-title">Coordenadas de GPS Exatas</h3>
            <p class="knowledge-card-text">
              Smartphones e câmeras gravam latitude e longitude exatas de onde você tirou a foto ou gravou o vídeo. Ao postar em redes sociais ou fóruns, criminosos virtuais e stalkers podem descobrir seu endereço residencial ou rotina.
            </p>
          </div>

          <div class="knowledge-card">
            <div class="knowledge-card-badge">02 · IDENTIDADE & LGPD</div>
            <h3 class="knowledge-card-title">Autoria e Dados Corporativos</h3>
            <p class="knowledge-card-text">
              Arquivos PDF, DOCX e planilhas gravam nome completo do usuário, razão social da empresa, comentários internos deletados e caminhos de pastas confidenciais no seu computador ou servidor de rede.
            </p>
          </div>

          <div class="knowledge-card">
            <div class="knowledge-card-badge">03 · PRIVACIDADE REAL</div>
            <h3 class="knowledge-card-title">Processamento 100% no Dispositivo</h3>
            <p class="knowledge-card-text">
              A maioria dos sites envia seus arquivos confidenciais para servidores remotos na nuvem. Nossa ferramenta higieniza os arquivos no seu próprio dispositivo, garantindo que nada saia da sua máquina.
            </p>
          </div>
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="guides-faq-section" aria-labelledby="faq-section-title">
        <div class="knowledge-header">
          <div class="kicker-wrap-sm">
            <span class="guides-kicker">DÚVIDAS FREQUENTES</span>
          </div>
          <h2 id="faq-section-title" class="knowledge-title">Perguntas Frequentes sobre Metadados</h2>
        </div>

        <div class="faq-accordion">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-summary">
                <span class="faq-question">{faq.q}</span>
                <span class="faq-icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- High-Conversion Neo-Brutalist CTA Banner -->
      <section class="guides-cta-banner" aria-labelledby="cta-banner-title">
        <div class="cta-badge">
          <span class="cta-pulse" aria-hidden="true">●</span>
          <span>FERRAMENTA GRATUITA & ILIMITADA</span>
        </div>

        <h2 id="cta-banner-title" class="cta-title">
          Pronto para higienizar seus arquivos agora?
        </h2>

        <p class="cta-desc">
          Processe uma cópia no navegador, confira a cobertura do formato e revise o arquivo baixado antes de compartilhar. A ferramenta não envia o arquivo selecionado aos servidores do site.
        </p>

        <div class="cta-actions">
          <a href="/#hero-section" class="btn-cta-primary">
            <span>Abrir Removedor de Metadados</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/#formatos" class="btn-cta-secondary">
            <span>Ver Todos os Formatos</span>
          </a>
        </div>

        <div class="cta-trust-bar">
          <span>✓ Sem Envio a Servidores</span>
          <span>✓ 100% Gratuito</span>
          <span>✓ Sem Cadastro ou Login</span>
          <span>✓ Qualidade depende do formato</span>
        </div>
      </section>

    </div>
  </main>

  <Footer lang="pt-BR" />
</Layout>

<!-- Client-side Interactive Filter Script -->
<script is:inline>
  (function () {
    const filterButtons = document.querySelectorAll('#filter-pills .filter-btn');
    const cards = document.querySelectorAll('#guides-container .guide-card');

    if (!filterButtons.length || !cards.length) return;

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button states
        filterButtons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards smoothly
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Smooth Web Animations API for FAQ Accordion
    class FaqAccordion {
      constructor(el) {
        this.el = el;
        this.summary = el.querySelector('summary');
        this.content = el.querySelector('.faq-answer');
        this.animation = null;
        this.isClosing = false;
        this.isExpanding = false;
        this.summary?.addEventListener('click', (e) => this.onClick(e));
      }

      onClick(e) {
        e.preventDefault();
        this.el.style.overflow = 'hidden';
        if (this.isClosing || !this.el.open) {
          this.open();
        } else if (this.isExpanding || this.el.open) {
          this.shrink();
        }
      }

      shrink() {
        this.isClosing = true;
        const startHeight = `${this.el.offsetHeight}px`;
        const endHeight = `${this.summary.offsetHeight}px`;

        if (this.animation) this.animation.cancel();

        this.animation = this.el.animate({
          height: [startHeight, endHeight]
        }, {
          duration: 250,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
        });

        this.content?.animate({
          opacity: [1, 0],
          transform: ['translateY(0px)', 'translateY(-6px)']
        }, {
          duration: 200,
          easing: 'ease-out'
        });

        this.animation.onfinish = () => this.onAnimationFinish(false);
        this.animation.oncancel = () => (this.isClosing = false);
      }

      open() {
        this.el.style.height = `${this.el.offsetHeight}px`;
        this.el.open = true;
        window.requestAnimationFrame(() => this.expand());
      }

      expand() {
        this.isExpanding = true;
        const startHeight = `${this.el.offsetHeight}px`;
        const endHeight = `${this.summary.offsetHeight + (this.content?.offsetHeight || 0)}px`;

        if (this.animation) this.animation.cancel();

        this.animation = this.el.animate({
          height: [startHeight, endHeight]
        }, {
          duration: 280,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
        });

        this.content?.animate({
          opacity: [0, 1],
          transform: ['translateY(-6px)', 'translateY(0px)']
        }, {
          duration: 260,
          easing: 'ease-out'
        });

        this.animation.onfinish = () => this.onAnimationFinish(true);
        this.animation.oncancel = () => (this.isExpanding = false);
      }

      onAnimationFinish(open) {
        this.el.open = open;
        this.animation = null;
        this.isClosing = false;
        this.isExpanding = false;
        this.el.style.height = '';
        this.el.style.overflow = '';
      }
    }

    document.querySelectorAll('details.faq-item').forEach((el) => {
      new FaqAccordion(el);
    });
  })();
</script>

