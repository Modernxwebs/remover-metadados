---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Contato — Remover Metadados | Fale Conosco';
const description = 'Entre em contato com Modern X Webs, mantenedor do Remover Metadados, pelo e-mail dev@modernxwebs.com para relatar bugs ou dúvidas de segurança e privacidade.';
const canonicalUrl = 'https://remover-metadados.com/contato/';
const alternatePt = 'https://remover-metadados.com/contato/';
const alternateEn = 'https://remover-metadados.com/en/contact/';

const email = 'dev@modernxwebs.com';
const studioUrl = 'https://modernxwebs.com';
const verificationUrl = '/verificacao/';
---

<Layout
  pageType="ContactPage"
  title={title}
  description={description}
  lang="pt-BR"
  canonicalUrl={canonicalUrl}
  alternatePt={alternatePt}
  alternateEn={alternateEn}
>
  <Header lang="pt-BR" ptUrl="/contato/" enUrl="/en/contact/" isSubpage={true} />

  <main class="page-wrap contact-page">
    <!-- Breadcrumb & Back -->
    <nav class="breadcrumb-nav" aria-label="Navegação estrutural">
      <a href="/" class="back-link">&larr; Voltar para a Ferramenta</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Contato</span>
    </nav>

    <!-- Header Block -->
    <header class="contact-header">
      <div class="contact-badge-row">
        <span class="badge-accent">CANAL DIRETO</span>
        <span class="badge-mono">BUGS E PRIVACIDADE</span>
      </div>
      <h1 class="contact-title">Fale Conosco</h1>
      <p class="contact-subtitle">
        Tem sugestões de melhoria, deseja suporte para um formato de arquivo específico ou encontrou um bug? Adoramos conversar com nossos usuários!
      </p>
    </header>

    <div class="contact-layout-grid">

      <!-- Left Column: Direct Info Cards -->
      <div class="contact-info-col">

        <!-- Email Primary Card -->
        <div class="contact-card primary-card">
          <div class="card-icon" aria-hidden="true">✉️</div>
          <span class="card-sub">E-MAIL OFICIAL</span>
          <h2 class="card-heading">dev@modernxwebs.com</h2>
          <p class="card-desc">
            Nosso canal principal para suporte, dúvidas de conformidade com a LGPD e feedback geral.
          </p>

          <div class="card-btn-row">
            <button id="copy-email-btn" class="action-btn copy-btn" data-email={email}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <span id="copy-text">Copiar E-mail</span>
            </button>

            <a href={`mailto:${email}`} class="action-btn mail-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span>Abrir App de E-mail</span>
            </a>
          </div>
        </div>

        <!-- Founder Direct Socials -->
        <div class="contact-card">
          <div class="card-icon" aria-hidden="true">⚡</div>
          <span class="card-sub">MANTENEDOR DO PROJETO</span>
          <h2 class="card-heading">Modern X Webs</h2>
          <p class="card-desc">
            Entre em contato com o mantenedor ou consulte a cobertura de remoção, os testes e as limitações conhecidas.
          </p>

          <div class="social-links-stacked">
            <a href={studioUrl} class="social-btn-link"><span class="social-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z"/></svg></span><div class="social-details"><strong>Modern X Webs</strong><span>Mantenedor do projeto</span></div><span class="social-arrow">&rarr;</span></a>

            <a href={verificationUrl} class="social-btn-link"><span class="social-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a18 18 0 0 1 0 18 18 18 0 0 1 0-18Z"/></svg></span><div class="social-details"><strong>Testes e limitações</strong><span>Cobertura de remoção e testes publicados</span></div><span class="social-arrow">&rarr;</span></a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Client-Side Composer -->
      <div class="contact-composer-col">
        <div class="composer-card">
          <div class="composer-header">
            <span class="composer-tag">MENSAGEM RÁPIDA</span>
            <h2 class="composer-title">Envie uma Mensagem Direta</h2>
            <p class="composer-desc">
              Monte sua mensagem abaixo. Ao clicar em enviar, seu aplicativo de e-mail será aberto automaticamente com as informações preenchidas — <em>100% no seu dispositivo, sem envio a banco de dados!</em>
            </p>
          </div>

          <form id="contact-quick-form" class="composer-form">
            <div class="form-group">
              <label for="contact-name" class="form-label">Seu Nome ou Apelido</label>
              <input
                type="text"
                id="contact-name"
                class="form-input"
                placeholder="Ex: Carlos Silva"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-category" class="form-label">Assunto Principal</label>
              <select id="contact-category" class="form-input">
                <option value="Sugestão de Novo Formato de Arquivo">💡 Sugerir novo formato de arquivo</option>
                <option value="Relato de Bug ou Falha Técnica">🐛 Relatar um bug ou falha técnica</option>
                <option value="Dúvida sobre Privacidade e Metadados">🔒 Dúvida sobre privacidade / LGPD</option>
                <option value="Parceria ou Ideia de Colaboração">🤝 Parceria ou colaboração</option>
                <option value="Outro Assunto Geral">💬 Outro assunto</option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Sua Mensagem</label>
              <textarea
                id="contact-message"
                class="form-input form-textarea"
                rows="5"
                placeholder="Descreva detalhadamente sua sugestão, arquivo problemático ou dúvida..."
                required
              ></textarea>
            </div>

            <button type="submit" class="composer-submit-btn">
              <span>Gerar e Enviar E-mail</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </form>

          <div class="faq-reminder">
            <span>Dúvida comum?</span>
            <a href="/#faq" class="faq-reminder-link">Consulte nossas Perguntas Frequentes (FAQ) &rarr;</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Actions -->
    <div class="contact-actions">
      <a href="/" class="btn-primary-action">
        <span>&larr; Voltar para a Ferramenta Principal</span>
      </a>
      <a href="/sobre/" class="btn-secondary-action">
        <span>Conhecer Mais Sobre Nós &rarr;</span>
      </a>
    </div>
  </main>

  <Footer lang="pt-BR" />
</Layout>

<style>
  .contact-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 1078px; /* 980px * 1.1 */
    margin: 0 auto;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 2rem;
  }

  .back-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb-separator,
  .breadcrumb-current {
    color: var(--text-muted);
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .contact-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .badge-accent {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 2px;
  }

  .badge-mono {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .contact-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
    color: var(--text);
  }

  .contact-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Grid Layout */
  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2rem;
    align-items: flex-start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .contact-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 3.5px 3.5px 0px var(--shadow-color);
    padding: 1.75rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .primary-card {
    border-left: 5px solid var(--btn-accent);
  }

  .card-icon {
    font-size: 1.75rem;
  }

  .card-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .card-heading {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text);
    word-break: break-all;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .card-btn-row {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .copy-btn {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .copy-btn:hover {
    transform: translate(-1.5px, -1.5px);
  }

  .mail-btn {
    background: var(--bg);
    color: var(--text);
  }

  .mail-btn:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  /* Social links stacked */
  .social-links-stacked {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-btn-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    padding: 0.75rem 1rem;
    border-radius: 3px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .social-btn-link:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  .social-icon {
    width: 28px;
    height: 28px;
    background: var(--border);
    color: var(--bg);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .social-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
  }

  .social-details strong {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .social-details span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .social-btn-link:hover .social-details span {
    color: var(--btn-accent-text);
    opacity: 0.9;
  }

  .social-arrow {
    font-weight: 700;
  }

  /* Composer Col */
  .composer-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0px var(--shadow-color);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .composer-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0 var(--shadow-color);
    border-radius: 2px;
    margin-bottom: 0.5rem;
  }

  .composer-title {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
    color: var(--text);
  }

  .composer-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .composer-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text);
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.85rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus {
    border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--accent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .composer-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.85rem 1.5rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .composer-submit-btn:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0 var(--shadow-color);
  }

  .faq-reminder {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 1rem;
    border-top: 1.5px dashed var(--border);
    flex-wrap: wrap;
  }

  .faq-reminder-link {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
  }

  .faq-reminder-link:hover {
    color: var(--accent);
  }

  /* Bottom Actions */
  .contact-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-primary-action:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px var(--shadow-color);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card-bg);
    color: var(--text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-secondary-action:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  @media (max-width: 820px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary-action,
    .btn-secondary-action {
      justify-content: center;
    }
  }
</style>

<script>
  // Copy Email Button
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'dev@modernxwebs.com';
      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyText.textContent;
        copyText.textContent = 'Copiado com Sucesso! ✓';
        copyBtn.style.background = '#22c55e';
        copyBtn.style.color = '#ffffff';

        setTimeout(() => {
          copyText.textContent = originalText;
          copyBtn.style.background = '';
          copyBtn.style.color = '';
        }, 2200);
      } catch (e) {
        // Fallback prompt
        window.prompt('Copie o endereço de e-mail:', email);
      }
    });
  }

  // Quick Mailto Generator
  const form = document.getElementById('contact-quick-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const category = (document.getElementById('contact-category') as HTMLSelectElement)?.value || '';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`[Remover Metadados] ${category} - ${name}`);
      const body = encodeURIComponent(
        `Olá Modern X Webs,\n\nNome: ${name}\nCategoria: ${category}\n\nMensagem:\n${message}\n\n---\nEnviado através do remover-metadados.com/contato`
      );

      window.location.href = `mailto:dev@modernxwebs.com?subject=${subject}&body=${body}`;
    });
  }
</script>
