---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'About Us — Metadata Remover | Mission & Creator';
const description = 'Learn about Metadata Remover and indie developer Dev Sharma. An independent, client-side utility built to restore digital privacy without uploading files to the cloud.';
const canonicalUrl = 'https://remover-metadados.com/en/about/';
const alternatePt = 'https://remover-metadados.com/sobre/';
const alternateEn = 'https://remover-metadados.com/en/about/';

const email = 'hello@remover-metadados.com';
const xUrl = 'https://x.com/DevSharmaBuilds';
const linkedInUrl = 'https://www.linkedin.com/in/dev000111/';
---

<Layout
  title={title}
  description={description}
  lang="en"
  canonicalUrl={canonicalUrl}
  alternatePt={alternatePt}
  alternateEn={alternateEn}
>
  <Header lang="en" ptUrl="/sobre/" enUrl="/en/about/" isSubpage={true} />

  <main class="page-wrap about-page">
    <!-- Breadcrumb & Back -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb navigation">
      <a href="/en/" class="back-link">&larr; Back to Metadata Remover</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">About Us</span>
    </nav>

    <!-- Header Block -->
    <header class="about-header">
      <div class="about-badge-row">
        <span class="badge-accent">ABOUT THE PROJECT</span>
        <span class="badge-mono">100% INDEPENDENT & CLIENT-SIDE</span>
      </div>
      <h1 class="about-title">Restoring Privacy by Eradicating Cloud Uploads</h1>
      <p class="about-subtitle">
        Engineered to solve a glaring hypocrisy on the modern web: online "privacy" tools that ironically demand you upload your most sensitive photos and documents to remote cloud servers.
      </p>
    </header>

    <!-- Origin Story Card -->
    <section class="story-card">
      <div class="story-tag">THE PROBLEM WE SOLVE</div>
      <h2 class="story-title">The Paradox of Online Metadata Removers</h2>
      <p class="story-text">
        Whenever you want to strip GPS geolocation tags from a personal smartphone photo before sharing it online, or clean author histories from a confidential PDF or DOCX agreement before delivering it to a counterparty, you are faced with a jarring compromise:
      </p>
      <blockquote class="story-quote">
        "To protect my privacy, why do I have to upload my unencrypted files to an unfamiliar server on the internet?"
      </blockquote>
      <p class="story-text">
        Cloud-based converters and scrapers hold your private data in transit and on remote storage volumes. You can never truly verify how long your files are stored, who inspects them, or whether backups linger on third-party cloud infrastructure.
      </p>
      <p class="story-text">
        <strong>Metadata Remover (remover-metadados.com)</strong> was created to prove that modern browsers have ample computing power to handle heavy lifting locally. Thanks to the HTML5 Canvas API, WebAssembly, and local byte buffering, your files are cleaned in milliseconds on your own device — <strong>without a single byte ever leaving your computer or phone</strong>.
      </p>
    </section>

    <!-- Pillars Grid -->
    <section class="pillars-section">
      <h2 class="section-heading">Our 4 Guiding Principles</h2>
      <div class="pillars-grid">
        <div class="pillar-card">
          <span class="pillar-num">01</span>
          <h3 class="pillar-title">Radical Privacy (Zero Upload)</h3>
          <p class="pillar-desc">
            Your files never touch remote servers. Decryption, decoding, binary metadata stripping, and ZIP packaging occur purely within your browser memory.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-num">02</span>
          <h3 class="pillar-title">Zero Friction & Free Access</h3>
          <p class="pillar-desc">
            No mandatory accounts, no passwords, no paywalls, and no artificial file quotas. Drop your files, wipe metadata, and download immediately.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-num">03</span>
          <h3 class="pillar-title">Technical Transparency</h3>
          <p class="pillar-desc">
            We openly explain how EXIF, IPTC, XMP, PDF object streams, and AI Content Credentials (C2PA) work, empowering you with real digital literacy.
          </p>
        </div>

        <div class="pillar-card">
          <span class="pillar-num">04</span>
          <h3 class="pillar-title">Uncompromising Respect</h3>
          <p class="pillar-desc">
            No intrusive advertisements, no deceptive download buttons, no tracking pixels, and full compliance with international privacy benchmarks.
          </p>
        </div>
      </div>
    </section>

    <!-- Meet The Creator Card -->
    <section class="creator-bio-section">
      <div class="creator-bio-card">
        <div class="creator-avatar-wrap">
          <div class="creator-big-avatar" aria-hidden="true">👨‍💻</div>
          <span class="creator-badge-sub">CREATOR & ENGINEER</span>
        </div>

        <div class="creator-bio-content">
          <span class="creator-label">MEET THE FOUNDER</span>
          <h2 class="creator-full-name">Dev Sharma</h2>
          <p class="creator-handle">
            Creator of <strong>Metadata Remover</strong> and builder of high-performance, privacy-first web utilities.
          </p>
          <p class="creator-paragraph">
            I am driven by crafting tools that deliver immediate utility without compromising user privacy. I believe the future of web applications lies in client-side edge computing, giving people sovereignty over their own data.
          </p>

          <!-- Social Buttons -->
          <div class="creator-social-row">
            <a href={xUrl} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>Follow on X (@DevSharmaBuilds)</span>
            </a>

            <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="social-btn linkedin-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              <span>Connect on LinkedIn</span>
            </a>

            <a href={`mailto:${email}`} class="social-btn email-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span>{email}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Actions -->
    <div class="about-actions">
      <a href="/en/" class="btn-primary-action">
        <span>&larr; Try Metadata Remover</span>
      </a>
      <a href="/en/contact/" class="btn-secondary-action">
        <span>Contact Dev Sharma &rarr;</span>
      </a>
    </div>
  </main>

  <Footer lang="en" />
</Layout>

<style>
  .about-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 2rem;
  }

  .back-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb-separator,
  .breadcrumb-current {
    color: var(--text-muted);
  }

  .about-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .about-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .badge-accent {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 2px;
  }

  .badge-mono {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .about-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
    color: var(--text);
  }

  .about-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Story Card */
  .story-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0px var(--shadow-color);
    padding: 2rem;
    border-radius: 4px;
    margin-bottom: 2.75rem;
  }

  .story-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0 var(--shadow-color);
    border-radius: 2px;
    margin-bottom: 0.85rem;
  }

  .story-title {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1rem;
  }

  .story-text {
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0 0 1rem;
  }

  .story-text:last-child {
    margin-bottom: 0;
  }

  .story-quote {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    background: var(--bg);
    border-left: 4px solid var(--accent);
    border: 1.5px solid var(--border);
    border-left-width: 4px;
    box-shadow: 2px 2px 0 var(--shadow-color);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }

  /* Pillars Section */
  .pillars-section {
    margin-bottom: 3rem;
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .pillar-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    padding: 1.5rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0 var(--shadow-color);
    border-radius: 2px;
  }

  .pillar-title {
    font-size: 1.08rem;
    font-weight: 700;
    margin: 0.35rem 0 0;
    color: var(--text);
  }

  .pillar-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Creator Bio Card */
  .creator-bio-section {
    margin-bottom: 3rem;
  }

  .creator-bio-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0px var(--shadow-color);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .creator-avatar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .creator-big-avatar {
    font-size: 3.5rem;
    width: 88px;
    height: 88px;
    background: var(--btn-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--shadow-color);
    border-radius: 4px;
  }

  .creator-badge-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text);
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0 var(--shadow-color);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    text-align: center;
  }

  .creator-bio-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .creator-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .creator-full-name {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .creator-handle {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.5;
    margin: 0;
  }

  .creator-paragraph {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0;
  }

  .creator-social-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .social-btn:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  /* Bottom Actions */
  .about-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-primary-action:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px var(--shadow-color);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card-bg);
    color: var(--text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-secondary-action:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  @media (max-width: 768px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
    .creator-bio-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .creator-social-row {
      justify-content: center;
    }
    .about-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary-action,
    .btn-secondary-action {
      justify-content: center;
    }
  }
</style>
