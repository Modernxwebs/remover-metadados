---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import BlogToc from '../../../components/BlogToc.astro';
import BlogShare from '../../../components/BlogShare.astro';
import BlogAuthor from '../../../components/BlogAuthor.astro';
import BlogCta from '../../../components/BlogCta.astro';
import BlogCard from '../../../components/BlogCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data, id } = post;
const { Content, headings } = await render(post);

const canonicalUrl = `https://remover-metadados.com/en/blog/${id}/`;
const pageTitle = `${data.title} | Metadata Remover Blog`;
const pageDescription = data.description;

// Fetch related posts (if defined in frontmatter, or fallback to same category)
const allEnPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
const relatedPosts = allEnPosts
  .filter((p) => p.id !== id && (data.relatedPosts?.includes(p.id) || p.data.category === data.category))
  .slice(0, 2);

// Calculate previous & next posts
const sortedPosts = allEnPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = sortedPosts.findIndex((p) => p.id === id);
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const formattedPubDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.pubDate);

const formattedUpdateDate = data.updatedDate
  ? new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(data.updatedDate)
  : null;

const ptUrl = data.translationId ? `/blog/${data.translationId}/` : '/blog/';
const alternatePt = data.translationId ? `https://remover-metadados.com/blog/${data.translationId}/` : undefined;
const includeHreflang = Boolean(data.translationId);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://remover-metadados.com/en/' },
    { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': 'https://remover-metadados.com/en/blog/' },
    { '@type': 'ListItem', 'position': 3, 'name': data.title, 'item': canonicalUrl },
  ],
};

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalUrl}#article`,
  'isPartOf': {
    '@id': 'https://remover-metadados.com/en/blog/#blog',
  },
  'headline': data.title,
  'description': data.description,
  'url': canonicalUrl,
  'inLanguage': 'en',
  'mainEntityOfPage': canonicalUrl,
  'datePublished': data.pubDate.toISOString(),
  'dateModified': (data.updatedDate || data.pubDate).toISOString(),
  'author': {
    '@type': 'Organization',
    'name': data.author,
    'url': 'https://remover-metadados.com/en/about/',
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Metadata Remover',
    'url': 'https://remover-metadados.com/en/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://remover-metadados.com/logo.png',
    },
  },
  'image': data.coverImage
    ? {
        '@type': 'ImageObject',
        'url': `https://remover-metadados.com${data.coverImage}`,
        'width': 1376,
        'height': 768,
        'caption': data.coverAlt || data.title,
      }
    : undefined,
  'speakable': {
    '@type': 'SpeakableSpecification',
    'cssSelector': ['.post-title', '.post-lead'],
  },
  'isAccessibleForFree': true,
  'timeRequired': data.readTime,
  'keywords': data.tags.join(', '),
  'articleSection': data.category,
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="en"
  canonicalUrl={canonicalUrl}
  mainEntityId={`${canonicalUrl}#article`}
  includeHreflang={includeHreflang}
  alternatePt={alternatePt}
  alternateEn={canonicalUrl}
  alternateXDefault={canonicalUrl}
  ogImage={data.coverImage}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

  <Header lang="en" ptUrl={ptUrl} enUrl={`/en/blog/${id}/`} isSubpage={true} />

  <main class="post-main">
    <div class="page-wrap post-wrap">

      <!-- Breadcrumbs -->
      <nav class="post-breadcrumb" aria-label="Breadcrumb navigation">
        <a href="/en/">Metadata Remover</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/en/blog/">Blog</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-cat">{data.category}</span>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current" aria-current="page">{data.title}</span>
      </nav>

      <!-- Post Header -->
      <header class="post-header">
        <div class="post-kicker-strip">
          <span class="cat-pill">{data.category}</span>
          <span class="read-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {data.readTime}
          </span>
        </div>

        <h1 class="post-title">{data.title}</h1>

        <p class="post-lead">{data.description}</p>

        <div class="post-author-meta">
          <div class="meta-author-box">
            <div class="meta-avatar" aria-hidden="true">MX</div>
            <div class="meta-names">
              <span class="meta-name">{data.author}</span>
              <span class="meta-role">{data.authorRole}</span>
            </div>
          </div>

          <div class="meta-date-box">
            <span class="date-label">Published on:</span>
            <time datetime={data.pubDate.toISOString()} class="date-value">{formattedPubDate}</time>
            {formattedUpdateDate && (
              <span class="date-updated">(Updated: {formattedUpdateDate})</span>
            )}
          </div>
        </div>
      </header>

      <!-- Hero Cover Image -->
      {data.coverImage && (
        <figure class="post-hero-figure">
          <img
            src={data.coverImage}
            alt={data.coverAlt || data.title}
            class="post-hero-image"
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
          />
          {data.coverAlt && (
            <figcaption class="post-hero-caption">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>{data.coverAlt}</span>
            </figcaption>
          )}
        </figure>
      )}

      <!-- Post Body Layout -->
      <div class="post-body-layout">
        <!-- Table of Contents -->
        <BlogToc headings={headings} isEn={true} />

        <!-- Article Content -->
        <article class="post-content">
          <Content />
        </article>

        <!-- Social Share Bar -->
        <BlogShare title={data.title} url={canonicalUrl} isEn={true} />

        <!-- Author Bio Card -->
        <BlogAuthor author={data.author} role={data.authorRole} isEn={true} />

        <!-- In-Content Tool CTA -->
        <BlogCta isEn={true} />

        <!-- Prev / Next Navigation -->
        <nav class="post-navigation" aria-label="Post navigation">
          {prevPost ? (
            <a href={`/en/blog/${prevPost.id}/`} class="nav-prev">
              <span class="nav-dir-label">← Previous Article</span>
              <span class="nav-post-title">{prevPost.data.title}</span>
            </a>
          ) : <div />}

          {nextPost && (
            <a href={`/en/blog/${nextPost.id}/`} class="nav-next">
              <span class="nav-dir-label">Next Article →</span>
              <span class="nav-post-title">{nextPost.data.title}</span>
            </a>
          )}
        </nav>

        <!-- Related Posts Section -->
        {relatedPosts.length > 0 && (
          <section class="related-posts-section">
            <div class="section-label-bar">
              <span class="section-tag-pill">RELATED ARTICLES</span>
            </div>
            <div class="related-posts-grid">
              {relatedPosts.map((related) => (
                <BlogCard post={related} />
              ))}
            </div>
          </section>
        )}

      </div>

    </div>
  </main>

  <Footer lang="en" />
</Layout>

<style>
  .post-main {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .post-wrap {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
  }

  .post-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .post-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .post-breadcrumb a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .crumb-sep {
    color: var(--text-faint);
  }

  .crumb-cat {
    color: var(--text-muted);
  }

  .crumb-current {
    color: var(--text);
    font-weight: 700;
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 2px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .post-kicker-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cat-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    box-shadow: var(--neo-shadow-xs);
    color: var(--text);
  }

  .read-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0;
  }

  .post-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .post-author-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .meta-author-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .meta-avatar {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: var(--primary);
    color: var(--btn-accent-text, #fff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
    border: 1.5px solid var(--border);
    box-shadow: var(--neo-shadow-xs);
  }

  .meta-names {
    display: flex;
    flex-direction: column;
  }

  .meta-name {
    font-weight: 700;
    color: var(--text);
  }

  .meta-role {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .meta-date-box {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
  }

  .date-value {
    color: var(--text);
    font-weight: 600;
  }

  .date-updated {
    font-size: 0.72rem;
    color: var(--primary);
  }

  .post-hero-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-hero-image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    display: block;
  }

  .post-hero-caption {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .post-body-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Typography for rendered markdown content */
  .post-content :global(h2) {
    font-family: var(--font-sans);
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text);
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid var(--border);
    scroll-margin-top: 5rem;
  }

  .post-content :global(h3) {
    font-family: var(--font-sans);
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--text);
    scroll-margin-top: 5rem;
  }

  .post-content :global(p) {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: var(--text);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    font-size: 1.02rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text);
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote) {
    background: var(--card-bg);
    border-left: 4px solid var(--primary);
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-radius: 0 4px 4px 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.98rem;
    box-shadow: var(--neo-shadow-xs);
  }

  .post-content :global(blockquote p) {
    margin: 0;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.92rem;
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    background: var(--card-bg);
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--primary);
    color: var(--btn-accent-text, #fff);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-content :global(tr:nth-child(even)) {
    background: rgba(0, 0, 0, 0.02);
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--code-bg, rgba(0, 0, 0, 0.05));
    border: 1px solid var(--border);
    padding: 0.15rem 0.35rem;
    border-radius: 3px;
  }

  .post-content :global(pre) {
    padding: 1.25rem;
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(hr) {
    border: 0;
    border-top: 2px dashed var(--border);
    margin: 2.5rem 0;
  }

  .post-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .post-content :global(a:hover) {
    color: var(--text);
  }

  .post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border);
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    text-decoration: none;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .nav-prev:hover,
  .nav-next:hover {
    transform: translateY(-2px);
    box-shadow: var(--neo-shadow);
  }

  .nav-next {
    text-align: right;
  }

  .nav-dir-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
  }

  .nav-post-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
  }

  .related-posts-section {
    margin-top: 1.5rem;
  }

  .section-label-bar {
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .section-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .related-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .post-navigation {
      grid-template-columns: 1fr;
    }
    .nav-next {
      text-align: left;
    }
  }
</style>

