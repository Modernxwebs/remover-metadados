---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PrivacyDetails from '../../components/PrivacyDetails.astro';
---
<Layout title="Privacy Policy — Local Files, Analytics & Maps" description="How local file processing, Google Analytics, external resources and optional GPS maps work on Metadata Remover." lang="en"
  canonicalUrl="https://remover-metadados.com/en/privacy/"
  alternatePt="https://remover-metadados.com/privacidade/"
  alternateEn="https://remover-metadados.com/en/privacy/">
  <Header lang="en" ptUrl="/privacidade/" enUrl="/en/privacy/" isSubpage={true} />
  <main class="page-wrap privacy-page"><PrivacyDetails lang="en" /></main>
  <Footer lang="en" />
</Layout>
<style>.privacy-page { max-width: 946px; padding-top: 2rem; padding-bottom: 3rem; }</style>
