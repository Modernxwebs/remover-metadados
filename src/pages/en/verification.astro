---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VerificationDetails from '../../components/VerificationDetails.astro';
---
<Layout title="Metadata Coverage — Tests & Limitations" description="See format-specific removal coverage, image quality changes and published metadata test results." lang="en"
  canonicalUrl="https://remover-metadados.com/en/verification/" alternatePt="https://remover-metadados.com/verificacao/" alternateEn="https://remover-metadados.com/en/verification/">
  <Header lang="en" ptUrl="/verificacao/" enUrl="/en/verification/" isSubpage={true} />
  <main class="page-wrap verification-page"><VerificationDetails lang="en" /></main>
  <Footer lang="en" />
</Layout>
<style>.verification-page { max-width: 1100px; padding-top: 2rem; padding-bottom: 3rem; }</style>
