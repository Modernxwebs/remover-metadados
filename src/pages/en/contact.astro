---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Contact Us — Metadata Remover | Connect with Dev Sharma';
const description = 'Contact Metadata Remover and founder Dev Sharma. Email: hello@remover-metadados.com, X (@DevSharmaBuilds), and LinkedIn. Send suggestions, bug reports, or privacy inquiries.';
const canonicalUrl = 'https://remover-metadados.com/en/contact/';
const alternatePt = 'https://remover-metadados.com/contato/';
const alternateEn = 'https://remover-metadados.com/en/contact/';

const email = 'hello@remover-metadados.com';
const xUrl = 'https://x.com/DevSharmaBuilds';
const linkedInUrl = 'https://www.linkedin.com/in/dev000111/';
---

<Layout
  title={title}
  description={description}
  lang="en"
  canonicalUrl={canonicalUrl}
  alternatePt={alternatePt}
  alternateEn={alternateEn}
>
  <Header lang="en" ptUrl="/contato/" enUrl="/en/contact/" isSubpage={true} />

  <main class="page-wrap contact-page">
    <!-- Breadcrumb & Back -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb navigation">
      <a href="/en/" class="back-link">&larr; Back to Metadata Remover</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">Contact Us</span>
    </nav>

    <!-- Header Block -->
    <header class="contact-header">
      <div class="contact-badge-row">
        <span class="badge-accent">DIRECT CHANNEL</span>
        <span class="badge-mono">RESPONSES WITHIN 24–48H</span>
      </div>
      <h1 class="contact-title">Contact Us</h1>
      <p class="contact-subtitle">
        Have a feature request, want support for an exotic file format, or discovered an edge-case bug? We would love to hear from you!
      </p>
    </header>

    <div class="contact-layout-grid">

      <!-- Left Column: Direct Info Cards -->
      <div class="contact-info-col">

        <!-- Email Primary Card -->
        <div class="contact-card primary-card">
          <div class="card-icon" aria-hidden="true">✉️</div>
          <span class="card-sub">OFFICIAL INBOX</span>
          <h2 class="card-heading">hello@remover-metadados.com</h2>
          <p class="card-desc">
            Our primary desk for technical inquiries, privacy inquiries, and general user feedback.
          </p>

          <div class="card-btn-row">
            <button id="copy-email-btn" class="action-btn copy-btn" data-email={email}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
              </svg>
              <span id="copy-text">Copy Email</span>
            </button>

            <a href={`mailto:${email}`} class="action-btn mail-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span>Launch Mail Client</span>
            </a>
          </div>
        </div>

        <!-- Founder Direct Socials -->
        <div class="contact-card">
          <div class="card-icon" aria-hidden="true">⚡</div>
          <span class="card-sub">CONNECT WITH FOUNDER</span>
          <h2 class="card-heading">Dev Sharma</h2>
          <p class="card-desc">
            Follow along for feature rollouts, client-side engineering insights, and future privacy utilities.
          </p>

          <div class="social-links-stacked">
            <a href={xUrl} target="_blank" rel="noopener noreferrer" class="social-btn-link">
              <span class="social-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </span>
              <div class="social-details">
                <strong>@DevSharmaBuilds on X</strong>
                <span>Open direct messages for quick feedback</span>
              </div>
              <span class="social-arrow">&rarr;</span>
            </a>

            <a href={linkedInUrl} target="_blank" rel="noopener noreferrer" class="social-btn-link">
              <span class="social-icon linkedin-bg">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </span>
              <div class="social-details">
                <strong>Dev Sharma on LinkedIn</strong>
                <span>Professional networking & collaboration</span>
              </div>
              <span class="social-arrow">&rarr;</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Client-Side Composer -->
      <div class="contact-composer-col">
        <div class="composer-card">
          <div class="composer-header">
            <span class="composer-tag">QUICK INQUIRY</span>
            <h2 class="composer-title">Compose a Direct Message</h2>
            <p class="composer-desc">
              Draft your message below. Clicking submit automatically configures your default email client with a pre-filled subject and body — <em>100% private and client-side!</em>
            </p>
          </div>

          <form id="contact-quick-form" class="composer-form">
            <div class="form-group">
              <label for="contact-name" class="form-label">Your Name</label>
              <input
                type="text"
                id="contact-name"
                class="form-input"
                placeholder="e.g. Alex Miller"
                required
              />
            </div>

            <div class="form-group">
              <label for="contact-category" class="form-label">Primary Topic</label>
              <select id="contact-category" class="form-input">
                <option value="Format Support Request">💡 Suggest a new file format</option>
                <option value="Bug Report">🐛 Report a bug or rendering issue</option>
                <option value="Privacy Question">🔒 Privacy / Security inquiry</option>
                <option value="Collaboration or Partnership">🤝 Partnership or collaboration</option>
                <option value="General Feedback">💬 General feedback</option>
              </select>
            </div>

            <div class="form-group">
              <label for="contact-message" class="form-label">Your Message</label>
              <textarea
                id="contact-message"
                class="form-input form-textarea"
                rows="5"
                placeholder="Provide as much context as possible..."
                required
              ></textarea>
            </div>

            <button type="submit" class="composer-submit-btn">
              <span>Compose & Send Email</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          </form>

          <div class="faq-reminder">
            <span>Looking for answers?</span>
            <a href="/en/#faq" class="faq-reminder-link">Check out our Frequently Asked Questions (FAQ) &rarr;</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Actions -->
    <div class="contact-actions">
      <a href="/en/" class="btn-primary-action">
        <span>&larr; Return to Metadata Remover</span>
      </a>
      <a href="/en/about/" class="btn-secondary-action">
        <span>Learn More About Us &rarr;</span>
      </a>
    </div>
  </main>

  <Footer lang="en" />
</Layout>

<style>
  .contact-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 2rem;
  }

  .back-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
  }

  .back-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .breadcrumb-separator,
  .breadcrumb-current {
    color: var(--text-muted);
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .contact-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .badge-accent {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 2px;
  }

  .badge-mono {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .contact-title {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
    color: var(--text);
  }

  .contact-subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Grid Layout */
  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2rem;
    align-items: flex-start;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .contact-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 3.5px 3.5px 0px var(--shadow-color);
    padding: 1.75rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .primary-card {
    border-left: 5px solid var(--btn-accent);
  }

  .card-icon {
    font-size: 1.75rem;
  }

  .card-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .card-heading {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text);
    word-break: break-all;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .card-btn-row {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .copy-btn {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .copy-btn:hover {
    transform: translate(-1.5px, -1.5px);
  }

  .mail-btn {
    background: var(--bg);
    color: var(--text);
  }

  .mail-btn:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  .social-links-stacked {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-btn-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    padding: 0.75rem 1rem;
    border-radius: 3px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.12s ease, background 0.12s ease;
  }

  .social-btn-link:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  .social-icon {
    width: 28px;
    height: 28px;
    background: var(--border);
    color: var(--bg);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .social-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex-grow: 1;
  }

  .social-details strong {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .social-details span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .social-btn-link:hover .social-details span {
    color: var(--btn-accent-text);
    opacity: 0.9;
  }

  .social-arrow {
    font-weight: 700;
  }

  .composer-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0px var(--shadow-color);
    padding: 2rem;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .composer-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--btn-accent-text);
    background: var(--btn-accent);
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0 var(--shadow-color);
    border-radius: 2px;
    margin-bottom: 0.5rem;
  }

  .composer-title {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.4rem;
    color: var(--text);
  }

  .composer-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .composer-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text);
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.85rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus {
    border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--accent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .composer-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.85rem 1.5rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .composer-submit-btn:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0 var(--shadow-color);
  }

  .faq-reminder {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 1rem;
    border-top: 1.5px dashed var(--border);
    flex-wrap: wrap;
  }

  .faq-reminder-link {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline;
  }

  .faq-reminder-link:hover {
    color: var(--accent);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-primary-action:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px var(--shadow-color);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--card-bg);
    color: var(--text);
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    border-radius: 3px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .btn-secondary-action:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1.5px, -1.5px);
  }

  @media (max-width: 820px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-primary-action,
    .btn-secondary-action {
      justify-content: center;
    }
  }
</style>

<script>
  // Copy Email Button
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'hello@remover-metadados.com';
      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyText.textContent;
        copyText.textContent = 'Copied to Clipboard! ✓';
        copyBtn.style.background = '#22c55e';
        copyBtn.style.color = '#ffffff';

        setTimeout(() => {
          copyText.textContent = originalText;
          copyBtn.style.background = '';
          copyBtn.style.color = '';
        }, 2200);
      } catch (e) {
        window.prompt('Copy email address:', email);
      }
    });
  }

  // Quick Mailto Generator
  const form = document.getElementById('contact-quick-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const category = (document.getElementById('contact-category') as HTMLSelectElement)?.value || '';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`[Metadata Remover] ${category} - ${name}`);
      const body = encodeURIComponent(
        `Hello Dev Sharma,\n\nName: ${name}\nTopic: ${category}\n\nMessage:\n${message}\n\n---\nSent via remover-metadados.com/en/contact`
      );

      window.location.href = `mailto:hello@remover-metadados.com?subject=${subject}&body=${body}`;
    });
  }
</script>
