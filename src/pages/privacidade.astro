---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyDetails from '../components/PrivacyDetails.astro';
---
<Layout title="Política de Privacidade — Arquivos Locais, Analytics e Mapas" description="Como funcionam o processamento local, Google Analytics, recursos externos e mapas GPS opcionais no Remover Metadados." lang="pt-BR"
  canonicalUrl="https://remover-metadados.com/privacidade/"
  alternatePt="https://remover-metadados.com/privacidade/"
  alternateEn="https://remover-metadados.com/en/privacy/">
  <Header lang="pt-BR" ptUrl="/privacidade/" enUrl="/en/privacy/" isSubpage={true} />
  <main class="page-wrap privacy-page"><PrivacyDetails lang="pt-BR" /></main>
  <Footer lang="pt-BR" />
</Layout>
<style>.privacy-page { max-width: 946px; padding-top: 2rem; padding-bottom: 3rem; }</style>
