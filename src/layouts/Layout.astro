---
import '../styles/global.css';

import { faqs } from '../data/faqs.js';
import { faqsEn } from '../data/faqsEn.js';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  alternatePt?: string;
  alternateEn?: string;
  alternateXDefault?: string;
  includeHreflang?: boolean;
  noindex?: boolean;
  ogImage?: string;
  ogType?: string;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  mainEntityId?: string;
}

const currentLang = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLang === 'en';

const siteUrl = 'https://remover-metadados.com';

const {
  title = isEn
    ? 'Metadata Remover — Remove EXIF Data & GPS from Photos Free'
    : 'Remover Metadados Online — Limpe EXIF e GPS de Fotos e PDFs',
  description = isEn
    ? 'Remove metadata from photos, PDFs, and documents free. Process files locally in your browser without uploading them.'
    : 'Remova metadados de fotos, PDFs e documentos grátis. Processe seus arquivos localmente no navegador, sem envio a servidores.',
  canonicalUrl,
  alternatePt,
  alternateEn,
  alternateXDefault,
  includeHreflang = true,
  noindex = false,
  ogType = 'website',
} = Astro.props;

const pageUrl = canonicalUrl || (isEn ? `${siteUrl}/en/` : `${siteUrl}/`);
const ptHreflang = alternatePt || `${siteUrl}/`;
const enHreflang = alternateEn || `${siteUrl}/en/`;
const xDefaultHreflang = alternateXDefault || enHreflang;

function toRelativeUrl(url?: string): string {
  if (!url) return '';
  try {
    if (url.startsWith('http://') || url.startsWith('https://')) {
      const u = new URL(url);
      return u.pathname + u.search + u.hash;
    }
    return url;
  } catch {
    return url;
  }
}

const ptRelativeUrl = toRelativeUrl(alternatePt);
const enRelativeUrl = toRelativeUrl(alternateEn);
const rawOgImage = Astro.props.ogImage;
const ogImage = rawOgImage
  ? (rawOgImage.startsWith('http') ? rawOgImage : `${siteUrl}${rawOgImage}`)
  : `${siteUrl}/og-image.png`;

const keywords = (
  isEn
    ? [
        'metadata remover',
        'remove metadata from photos',
        'remove metadata',
        'remove exif data online free',
        'photo metadata remover',
        'delete exif data',
        'remove gps from photo',
        'remove metadata from pdf',
        'clean metadata online',
        'bulk metadata remover',
        'anonymize image online',
        'ai metadata remover',
        'c2pa metadata remover',
        'exif cleaner',
        'non-destructive metadata removal',
        'browser metadata cleaner',
        'free metadata cleaner',
        'remove author from word document',
        'online photo metadata cleaner',
        'strip image metadata online',
      ]
    : [
        'remover metadados',
        'remover metadados de fotos',
        'metadados remover',
        'removedor de metadados',
        'limpar metadados',
        'remover localização de fotos',
        'apagar dados exif',
        'removedor metadados',
        'remove metadados',
        'tirar metadados',
        'limpar meta dados',
        'retirar metadados',
        'apagar metadados',
        'limpar metadados de documento',
        'remover metadados gratis',
        'remover exif online',
        'como remover metadados de fotos',
        'remover metadados pdf',
      ]
).join(', ');

const currentFaqs = isEn ? faqsEn : faqs;

const schemaData: any = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': `${siteUrl}/`,
      'name': 'Remover Metadados',
      'alternateName': 'Metadata Remover',
      'description': isEn
        ? 'Free metadata removal with local file processing in your browser.'
        : 'Remoção gratuita de metadados com processamento local de arquivos no navegador.',
      'inLanguage': ['pt-BR', 'en'],
      'publisher': {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        'name': 'Remover Metadados',
        'url': `${siteUrl}/`,
        'logo': {
          '@type': 'ImageObject',
          'url': `${siteUrl}/logo.png`,
        },
      },
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#app`,
      'name': 'Remover Metadados',
      'alternateName': 'Metadata Remover',
      'url': `${siteUrl}/`,
      'applicationCategory': 'SecurityApplication',
      'operatingSystem': 'Any (Web Browser, Windows, macOS, Linux, Android, iOS)',
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': isEn ? 'USD' : 'BRL',
      },
      'description': isEn
        ? 'Free metadata removal for supported image and document fields, processed locally without file uploads. Coverage and quality depend on format.'
        : 'Remoção gratuita de campos de metadados em imagens e documentos compatíveis, com processamento local sem envio de arquivos. A cobertura e a qualidade dependem do formato.',
      'featureList': isEn
        ? [
            'Strip EXIF data and GPS geolocation from JPEG, PNG, WebP, and HEIC photos',
            'Full-screen drag and drop: release photos or files anywhere on screen to process instantly',
            'Export cleaned files in your choice of format (Original, JPG, PNG, WebP, AVIF, or all in .ZIP)',
            'Clear standard PDF and Office document properties (DOCX, XLSX, PPTX)',
            'Image re-encoding and PNG metadata chunk removal; format-specific limitations apply',
            'Local file processing without uploading files',
            'Single file or bulk download bundled as a clean .zip archive',
            'Free with no registration, no subscriptions, and no file limits',
          ]
        : [
            'Remoção de dados EXIF e geolocalização GPS em fotos JPEG, PNG, WebP e HEIC',
            'Arrastar e soltar em tela cheia: solte fotos ou arquivos em qualquer parte da tela',
            'Escolha o formato de saída dos arquivos limpos (Saída padrão, JPG, PNG, WebP, AVIF ou Todos em .ZIP)',
            'Limpeza de propriedades padrão de documentos PDF e Office (DOCX, XLSX, PPTX)',
            'Processamento local no navegador sem envio de arquivos a servidores',
            'Download individual ou em lote compactado em arquivo .zip',
            'Gratuito e sem necessidade de cadastro ou instalação',
          ],
    },
    {
      '@type': 'FAQPage',
      '@id': isEn ? `${siteUrl}/en/#faq` : `${siteUrl}/#faq`,
      'isPartOf': {
        '@id': `${siteUrl}/#website`,
      },
      'inLanguage': isEn ? 'en' : 'pt-BR',
      'mainEntity': currentFaqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.a,
        },
      })),
    },
    {
      '@type': 'HowTo',
      '@id': isEn ? `${siteUrl}/en/#howto` : `${siteUrl}/#howto`,
      'name': isEn
        ? 'How to Remove Metadata from Photos, PDFs, and Documents Online'
        : 'Como Remover Metadados de Fotos, PDFs e Documentos Online',
      'description': isEn
        ? 'Learn how to remove EXIF data, GPS coordinates, camera specs, and supported author properties from files locally in your browser.'
        : 'Aprenda como limpar dados EXIF, coordenadas GPS, dados de câmera e propriedades de autoria compatíveis de arquivos direto no navegador.',
      'inLanguage': isEn ? 'en' : 'pt-BR',
      'totalTime': 'PT10S',
      'step': isEn
        ? [
            {
              '@type': 'HowToStep',
              'position': 1,
              'name': 'Drop Files Anywhere on Screen',
              'text': 'Drag and drop your photos, PDFs, or documents anywhere on the screen (no restricted boxes), or click to choose files from your device.',
              'url': `${siteUrl}/en/#hero-section`,
            },
            {
              '@type': 'HowToStep',
              'position': 2,
              'name': 'Instant In-Browser Sanitization',
              'text': 'The tool removes supported EXIF tags, GPS location and author properties inside your browser without uploading files to remote servers.',
              'url': `${siteUrl}/en/#how-it-works`,
            },
            {
              '@type': 'HowToStep',
              'position': 3,
              'name': 'Choose Format & Download Clean Files',
              'text': 'Select the default output or JPG, PNG, WebP, AVIF, or all formats in a ZIP. Check the format-specific coverage and quality notes before sharing.',
              'url': `${siteUrl}/en/#hero-section`,
            },
          ]
        : [
            {
              '@type': 'HowToStep',
              'position': 1,
              'name': 'Solte Arquivos em Qualquer Lugar da Tela',
              'text': 'Arraste suas fotos, PDFs ou documentos para qualquer ponto da tela (sem caixas limitadoras) ou clique para escolher arquivos do seu dispositivo.',
              'url': `${siteUrl}/#hero-section`,
            },
            {
              '@type': 'HowToStep',
              'position': 2,
              'name': 'Limpeza Automática no Navegador',
              'text': 'A ferramenta apaga campos compatíveis de EXIF, GPS e autoria diretamente no seu navegador, sem envio para servidores externos.',
              'url': `${siteUrl}/#como-funciona`,
            },
            {
              '@type': 'HowToStep',
              'position': 3,
              'name': 'Escolha o Formato e Baixe com Segurança',
              'text': 'Escolha o formato de saída desejado (Saída padrão, JPG, PNG, WebP, AVIF ou Todos em .ZIP) e baixe seus arquivos limpos e higienizados.',
              'url': `${siteUrl}/#hero-section`,
            },
          ],
    },
  ],
};

// FAQPage and HowTo describe the homepage sections only. Keep those entities
// off utility and guide pages so their structured data matches visible content.
const isHomepage = pageUrl === `${siteUrl}/` || pageUrl === `${siteUrl}/en/`;
if (!isHomepage) {
  schemaData['@graph'] = schemaData['@graph'].filter(
    (entity: { '@type': string }) => !['FAQPage', 'HowTo', 'WebApplication'].includes(entity['@type']),
  );
}
schemaData['@graph'].push({
  '@type': Astro.props.pageType || 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: currentLang,
  isPartOf: { '@id': `${siteUrl}/#website` },
  ...(isHomepage || Astro.props.mainEntityId
    ? { mainEntity: { '@id': Astro.props.mainEntityId || `${siteUrl}/#app` } }
    : {}),
});
---

<!DOCTYPE html>
<html lang={isEn ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content={isEn ? 'Metadata Remover' : 'Remover Metadados'} />
    <meta name="theme-color" content="#111010" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f0ed" media="(prefers-color-scheme: light)" />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Canonical URL -->
    <link rel="canonical" href={pageUrl} />

    {includeHreflang && <>
      <link rel="alternate" hreflang="pt-BR" href={ptHreflang} />
      <link rel="alternate" hreflang="en" href={enHreflang} />
      <link rel="alternate" hreflang="x-default" href={xDefaultHreflang} />
    </>}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={isEn ? 'Metadata Remover' : 'Remover Metadados'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        isEn
          ? 'Metadata Remover — Free, private online tool to strip file metadata'
          : 'Remover Metadados — Ferramenta gratuita e privada para limpar metadados'
      }
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: WebApplication + FAQPage JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FS50H5QYJ3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FS50H5QYJ3');
    </script>

    <!-- Preload local client-side ZIP engine -->
    <script is:inline src="/vendor/jszip.min.js" defer></script>

    <!-- Theme initialization: default is light mode; dark only if user explicitly toggled -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <LanguageSuggestion isEn={isEn} ptUrl={ptRelativeUrl} enUrl={enRelativeUrl} />
    <slot />

    <!-- Global fallback drag & drop handler for non-tool pages: prevents browser navigation & forwards files to tool -->
    <script is:inline define:vars={{ isEn }}>
      (function() {
        window.addEventListener('dragover', function(e) {
          if (document.getElementById('hero-section') || document.getElementById('metadata-viewer-tool')) return;
          e.preventDefault();
          if (e.dataTransfer) {
            try { e.dataTransfer.dropEffect = 'copy'; } catch (_) {}
          }
        });

        window.addEventListener('drop', function(e) {
          if (document.getElementById('hero-section') || document.getElementById('metadata-viewer-tool')) return;
          e.preventDefault();
          const files = Array.from(e.dataTransfer?.files || []);
          if (!files.length) return;

          try {
            if (window.indexedDB) {
              const req = indexedDB.open('remover_metadados_drop_db', 1);
              req.onupgradeneeded = function() {
                if (!req.result.objectStoreNames.contains('incoming_files')) {
                  req.result.createObjectStore('incoming_files', { keyPath: 'id' });
                }
              };
              req.onsuccess = function() {
                const db = req.result;
                const tx = db.transaction('incoming_files', 'readwrite');
                const store = tx.objectStore('incoming_files');
                store.put({ id: 'pending', files: files, timestamp: Date.now() });
                tx.oncomplete = function() {
                  window.location.href = isEn ? '/en/' : '/';
                };
                tx.onerror = function() {
                  window.location.href = isEn ? '/en/' : '/';
                };
              };
              req.onerror = function() {
                window.location.href = isEn ? '/en/' : '/';
              };
              return;
            }
          } catch (_) {}

          window.location.href = isEn ? '/en/' : '/';
        });
      })();
    </script>
  </body>
</html>
