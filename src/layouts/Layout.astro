---
import '../styles/global.css';

import { faqs } from '../data/faqs.js';
import { faqsEn } from '../data/faqsEn.js';
import LanguageSuggestion from '../components/LanguageSuggestion.astro';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  alternatePt?: string;
  alternateEn?: string;
  alternateXDefault?: string;
  includeHreflang?: boolean;
  noindex?: boolean;
}

const currentLang = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLang === 'en';

const siteUrl = 'https://remover-metadados.com';

const {
  title = isEn
    ? 'Metadata Remover — Remove EXIF Data & GPS from Photos Free'
    : 'Remover Metadados Online — Limpe EXIF e GPS de Fotos e PDFs',
  description = isEn
    ? 'Remove metadata from photos, PDFs, and documents online free. Remove EXIF data, GPS location, and author info locally in your browser with 100% privacy.'
    : 'Remova metadados de fotos, PDFs e documentos online e grátis. Apague GPS, dados EXIF e autoria direto no navegador com 100% de privacidade (sem envio a servidores).',
  canonicalUrl,
  alternatePt,
  alternateEn,
  alternateXDefault,
  includeHreflang = true,
  noindex = false,
} = Astro.props;

const pageUrl = canonicalUrl || (isEn ? `${siteUrl}/en/` : `${siteUrl}/`);
const ptHreflang = alternatePt || `${siteUrl}/`;
const enHreflang = alternateEn || `${siteUrl}/en/`;
const xDefaultHreflang = alternateXDefault || enHreflang;
const ogImage = `${siteUrl}/og-image.png`;

const keywords = (
  isEn
    ? [
        'metadata remover',
        'remove metadata from photos',
        'remove metadata',
        'remove exif data online free',
        'photo metadata remover',
        'delete exif data',
        'remove gps from photo',
        'remove metadata from pdf',
        'clean metadata online',
        'bulk metadata remover',
        'anonymize image online',
        'ai metadata remover',
        'c2pa metadata remover',
        'exif cleaner',
        'non-destructive metadata removal',
        'browser metadata cleaner',
        'free metadata cleaner',
        'remove author from word document',
        'online photo metadata cleaner',
        'strip image metadata online',
      ]
    : [
        'remover metadados',
        'remover metadados de fotos',
        'metadados remover',
        'removedor de metadados',
        'limpar metadados',
        'remover localização de fotos',
        'apagar dados exif',
        'removedor metadados',
        'remove metadados',
        'tirar metadados',
        'limpar meta dados',
        'retirar metadados',
        'apagar metadados',
        'limpar metadados de documento',
        'remover metadados gratis',
        'remover exif online',
        'como remover metadados de fotos',
        'remover metadados pdf',
      ]
).join(', ');

const currentFaqs = isEn ? faqsEn : faqs;

const schemaData: any = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': `${siteUrl}/`,
      'name': isEn ? 'Metadata Remover' : 'Remover Metadados',
      'description': isEn
        ? 'Free, 100% private online metadata remover running entirely in your browser.'
        : 'Removedor de metadados gratuito e 100% privado direto no navegador.',
      'inLanguage': isEn ? 'en' : 'pt-BR',
      'publisher': {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        'name': isEn ? 'Metadata Remover' : 'Remover Metadados',
        'url': `${siteUrl}/`,
        'logo': {
          '@type': 'ImageObject',
          'url': `${siteUrl}/logo.png`,
        },
      },
    },
    {
      '@type': 'WebApplication',
      '@id': isEn ? `${siteUrl}/en/#app` : `${siteUrl}/#app`,
      'name': isEn ? 'Metadata Remover' : 'Remover Metadados',
      'url': pageUrl,
      'applicationCategory': 'SecurityApplication',
      'operatingSystem': 'Any (Web Browser, Windows, macOS, Linux, Android, iOS)',
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': isEn ? 'USD' : 'BRL',
      },
      'description': isEn
        ? 'Free and 100% private online metadata remover. Clean EXIF data, GPS coordinates, author history, and AI credentials locally in your browser without uploading files to remote servers.'
        : 'Removedor de metadados online gratuito e 100% privado. Permite limpar metadados de fotos, documentos, PDFs e vídeos localmente no navegador, sem envio de dados para a internet.',
      'featureList': isEn
        ? [
            'Strip EXIF data and GPS geolocation from JPEG, PNG, WebP, and HEIC photos',
            'Clean author metadata and revision history from PDF and Office files (DOCX, XLSX, PPTX)',
            'Remove AI generation parameters and C2PA Content Credentials manifests',
            '100% in-browser processing (zero server upload) with total privacy compliance',
            'Single file or bulk download bundled as a clean .zip archive',
            'Free with no registration, no subscriptions, and no file limits',
          ]
        : [
            'Remoção de dados EXIF e geolocalização GPS em fotos JPEG, PNG, WebP e HEIC',
            'Limpeza de metadados de autoria e histórico em documentos PDF e Office (DOCX, XLSX, PPTX)',
            'Processamento 100% no navegador (sem envio a servidores) com conformidade à LGPD',
            'Download individual ou em lote compactado em arquivo .zip',
            'Gratuito e sem necessidade de cadastro ou instalação',
          ],
    },
    {
      '@type': 'FAQPage',
      '@id': isEn ? `${siteUrl}/en/#faq` : `${siteUrl}/#faq`,
      'isPartOf': {
        '@id': `${siteUrl}/#website`,
      },
      'inLanguage': isEn ? 'en' : 'pt-BR',
      'mainEntity': currentFaqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.q,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.a,
        },
      })),
    },
    {
      '@type': 'HowTo',
      '@id': isEn ? `${siteUrl}/en/#howto` : `${siteUrl}/#howto`,
      'name': isEn
        ? 'How to Remove Metadata from Photos, PDFs, and Documents Online'
        : 'Como Remover Metadados de Fotos, PDFs e Documentos Online',
      'description': isEn
        ? 'Learn how to remove EXIF data, GPS coordinates, camera specs, and author history from files locally in your browser.'
        : 'Aprenda como limpar dados EXIF, coordenadas GPS, dados de câmera e histórico de autoria de arquivos direto no navegador.',
      'inLanguage': isEn ? 'en' : 'pt-BR',
      'totalTime': 'PT10S',
      'step': isEn
        ? [
            {
              '@type': 'HowToStep',
              'position': 1,
              'name': 'Select or Drop Files',
              'text': 'Drag and drop your photos, PDFs, or documents into the clean zone, or click to choose files from your device.',
              'url': `${siteUrl}/en/#hero-section`,
            },
            {
              '@type': 'HowToStep',
              'position': 2,
              'name': 'Instant In-Browser Sanitization',
              'text': 'The tool removes EXIF tags, GPS location, and author data completely inside your browser without uploading files to remote servers.',
              'url': `${siteUrl}/en/#how-it-works`,
            },
            {
              '@type': 'HowToStep',
              'position': 3,
              'name': 'Download Clean Files',
              'text': 'Download each sanitized file individually or download all cleaned files bundled together in a ZIP archive.',
              'url': `${siteUrl}/en/#hero-section`,
            },
          ]
        : [
            {
              '@type': 'HowToStep',
              'position': 1,
              'name': 'Selecione ou Arraste os Arquivos',
              'text': 'Arraste suas fotos, PDFs ou documentos para a área de limpeza ou clique para escolher arquivos do seu dispositivo.',
              'url': `${siteUrl}/#hero-section`,
            },
            {
              '@type': 'HowToStep',
              'position': 2,
              'name': 'Limpeza Automática no Navegador',
              'text': 'A ferramenta apaga dados EXIF, GPS e histórico de autoria diretamente no seu navegador, sem envio para servidores externos.',
              'url': `${siteUrl}/#como-funciona`,
            },
            {
              '@type': 'HowToStep',
              'position': 3,
              'name': 'Baixe os Arquivos Higienizados',
              'text': 'Faça o download de cada arquivo limpo individualmente ou baixe todos reunidos em um arquivo ZIP protegido.',
              'url': `${siteUrl}/#hero-section`,
            },
          ],
    },
  ],
};

// FAQPage and HowTo describe the homepage sections only. Keep those entities
// off utility and guide pages so their structured data matches visible content.
const isHomepage = pageUrl === `${siteUrl}/` || pageUrl === `${siteUrl}/en/`;
if (!isHomepage) {
  schemaData['@graph'] = schemaData['@graph'].filter(
    (entity: { '@type': string }) => entity['@type'] !== 'FAQPage' && entity['@type'] !== 'HowTo',
  );
}
---

<!DOCTYPE html>
<html lang={isEn ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="author" content={isEn ? 'Metadata Remover' : 'Remover Metadados'} />
    <meta name="theme-color" content="#111010" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f0ed" media="(prefers-color-scheme: light)" />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Canonical URL -->
    <link rel="canonical" href={pageUrl} />

    {includeHreflang && <>
      <link rel="alternate" hreflang="pt-BR" href={ptHreflang} />
      <link rel="alternate" hreflang="en" href={enHreflang} />
      <link rel="alternate" hreflang="x-default" href={xDefaultHreflang} />
    </>}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={isEn ? 'Metadata Remover' : 'Remover Metadados'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        isEn
          ? 'Metadata Remover — Free, private online tool to strip file metadata'
          : 'Remover Metadados — Ferramenta gratuita e privada para limpar metadados'
      }
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: WebApplication + FAQPage JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FS50H5QYJ3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FS50H5QYJ3');
    </script>

    <!-- Preload local client-side ZIP engine -->
    <script is:inline src="/vendor/jszip.min.js" defer></script>

    <!-- Theme initialization: default is light mode; dark only if user explicitly toggled -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <LanguageSuggestion isEn={isEn} />
    <slot />
  </body>
</html>
