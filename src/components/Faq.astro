---
// FAQ Component — Accessible accordion with On-Page SEO questions & answers
import { faqs } from '../data/faqs.js';
import { faqsEn } from '../data/faqsEn.js';

export interface Props {
  lang?: string;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';
const currentFaqs = isEn ? faqsEn : faqs;
---

<section id="faq" style="padding: 4rem 0; border-top: 2px solid var(--border);">
  <div class="page-wrap" style="text-align: left;">

    <div style="text-align: center; margin-bottom: 2.5rem;">
      <h2>{isEn ? "Frequently Asked Questions" : "Perguntas Frequentes"}</h2>
      <p style="font-family: var(--font-heading); font-size: clamp(1.3rem, 2.2vw, 1.6rem); font-weight: 700; color: var(--text); letter-spacing: -0.02em;">
        {isEn ? "Everything you need to know about metadata removal" : "Tire suas dúvidas sobre como limpar metadados"}
      </p>
      <p style="font-size: 0.9rem; font-weight: 400; color: var(--text-muted); margin-top: 0.5rem;">
        {isEn
          ? "Direct answers on client-side processing, supported file formats, and digital privacy safety."
          : "Respostas diretas sobre funcionamento, formatos suportados e segurança da sua privacidade digital."}
      </p>
    </div>

    <div class="faq-list" itemscope itemtype="https://schema.org/FAQPage">
      {currentFaqs.map((faq, index) => (
        <details class="faq-item" id={`faq-${index + 1}`} itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <summary class="faq-summary">
            <span class="faq-question" itemprop="name">{faq.q}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p itemprop="text">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 990px; /* 900px * 1.1 */
    margin-inline: auto;
  }

  .faq-item {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    overflow: hidden;
  }

  .faq-item:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .faq-item[open] {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .faq-summary {
    padding: 1.25rem 1.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    user-select: none;
    border-bottom: 2px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] .faq-summary {
    border-bottom: 2px solid var(--border);
    background: var(--bg);
  }

  .faq-question {
    flex: 1;
    line-height: 1.4;
  }

  .faq-icon {
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    background: var(--card-bg);
    border-radius: 2px;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .faq-answer {
    padding: 1.25rem 1.4rem;
  }

  .faq-answer p {
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-summary {
      padding: 1rem 1.15rem;
      font-size: 0.9rem;
    }
    .faq-answer {
      padding: 0 1.15rem 1.15rem 1.15rem;
    }
  }
</style>

<script>
  class FaqAccordion {
    constructor(el) {
      this.el = el;
      this.summary = el.querySelector('summary');
      this.content = el.querySelector('.faq-answer');
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.summary?.addEventListener('click', (e) => this.onClick(e));
    }

    onClick(e) {
      e.preventDefault();
      this.el.style.overflow = 'hidden';
      if (this.isClosing || !this.el.open) {
        this.open();
      } else if (this.isExpanding || this.el.open) {
        this.shrink();
      }
    }

    shrink() {
      this.isClosing = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate({
        height: [startHeight, endHeight]
      }, {
        duration: 250,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
      });

      this.content?.animate({
        opacity: [1, 0],
        transform: ['translateY(0px)', 'translateY(-6px)']
      }, {
        duration: 200,
        easing: 'ease-out'
      });

      this.animation.onfinish = () => this.onAnimationFinish(false);
      this.animation.oncancel = () => (this.isClosing = false);
    }

    open() {
      this.el.style.height = `${this.el.offsetHeight}px`;
      this.el.open = true;
      window.requestAnimationFrame(() => this.expand());
    }

    expand() {
      this.isExpanding = true;
      const startHeight = `${this.el.offsetHeight}px`;
      const endHeight = `${this.summary.offsetHeight + (this.content?.offsetHeight || 0)}px`;

      if (this.animation) this.animation.cancel();

      this.animation = this.el.animate({
        height: [startHeight, endHeight]
      }, {
        duration: 280,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)'
      });

      this.content?.animate({
        opacity: [0, 1],
        transform: ['translateY(-6px)', 'translateY(0px)']
      }, {
        duration: 260,
        easing: 'ease-out'
      });

      this.animation.onfinish = () => this.onAnimationFinish(true);
      this.animation.oncancel = () => (this.isExpanding = false);
    }

    onAnimationFinish(open) {
      this.el.open = open;
      this.animation = null;
      this.isClosing = false;
      this.isExpanding = false;
      this.el.style.height = '';
      this.el.style.overflow = '';
    }
  }

  document.querySelectorAll('details.faq-item').forEach((el) => {
    new FaqAccordion(el);
  });
</script>
