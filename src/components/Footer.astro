---
// Footer — clean, professional Neo-Brutalist layout with Product, Legal & Company links
export interface Props {
  lang?: string;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';
const year = new Date().getFullYear();

const homeUrl = isEn ? '/en/' : '/';
const privacyUrl = isEn ? '/en/privacy/' : '/privacidade/';
const termsUrl = isEn ? '/en/terms/' : '/termos/';
const aboutUrl = isEn ? '/en/about/' : '/sobre/';
const contactUrl = isEn ? '/en/contact/' : '/contato/';
---

<footer class="site-footer">
  <div class="page-wrap footer-container">

    <!-- Top Grid Section -->
    <div class="footer-grid">

      <!-- Col 1: Brand Info -->
      <div class="footer-brand-col">
        <a href={homeUrl} class="footer-logo-link" title={isEn ? 'Metadata Remover' : 'Remover Metadados'}>
          <span class="footer-logo-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </span>
          <span class="footer-brand-name">
            {isEn ? 'Metadata Remover' : 'Remover Metadados'}
          </span>
        </a>

        <p class="footer-description">
          {isEn
            ? 'Local metadata removal for photos, PDFs and documents, without file uploads. See coverage and privacy details.'
            : 'Remoção local de metadados de fotos, PDFs e documentos, sem envio de arquivos. Consulte a cobertura e a política de privacidade.'}
        </p>

        <div class="footer-brand-badges">
          <span class="compliance-badge zero-upload-badge">
            <span class="compliance-dot yellow-dot" aria-hidden="true"></span>
            {isEn ? 'Zero Server Upload' : 'Zero Envio a Servidores'}
          </span>
          <span class="compliance-badge">
            <span class="compliance-dot" aria-hidden="true"></span>
            {isEn ? 'Privacy Details Available' : 'Política de Privacidade'}
          </span>
        </div>

        <div class="footer-featured-badges">
          <a href="https://twelve.tools" target="_blank"><img src="https://twelve.tools/badge1-light.svg" alt="Featured on Twelve Tools" width="148" height="40"></a>
          <a href="https://dododirectory.com" target="_blank" rel="dofollow"><img src="https://dododirectory.com/badge-light.png" alt="Featured on DodoDirectory" width="200" height="54" /></a>
          <a href="https://dofollow.tools" target="_blank"><img src="https://dofollow.tools/badge/badge_light.svg" alt="Featured on Dofollow.Tools" width="200" height="54" /></a>
          <a href="https://www.producthunt.com/products/remover-metadados?embed=true&amp;utm_source=badge-featured&amp;utm_medium=badge&amp;utm_campaign=badge-remover-metadados" target="_blank" rel="noopener noreferrer"><img alt="Remover Metadados - Remove EXIF, GPS &amp; hidden metadata privately online | Product Hunt" width="250" height="54" src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1284124&amp;theme=light&amp;t=1792318013174"></a>
        </div>
      </div>

      <!-- Col 2: Navigation / Product -->
      <div class="footer-links-col">
        <h3 class="footer-heading">{isEn ? 'Product' : 'Ferramenta'}</h3>
        <ul class="footer-link-list">
          <li><a href={homeUrl} class="footer-link">{isEn ? 'Metadata Remover' : 'Início & Limpeza'}</a></li>
          {isEn ? (
            <li><a href="/en/metadata-viewer/" class="footer-link">Metadata Viewer</a></li>
          ) : (
            <li><a href="/ver-metadados/" class="footer-link">Visualizador de Metadados</a></li>
          )}
          <li><a href="/blog/" class="footer-link">{isEn ? 'Privacy Blog' : 'Blog de Privacidade'}</a></li>
          <li><a href={isEn ? '/en/#how-it-works' : '/#como-funciona'} class="footer-link">{isEn ? 'How It Works' : 'Como Funciona'}</a></li>
          <li><a href={isEn ? '/en/#formats' : '/#formatos'} class="footer-link">{isEn ? 'Supported Formats' : 'Formatos Suportados'}</a></li>
          <li><a href="/guias/" class="footer-link">{isEn ? 'Guides Hub' : 'Central de Guias'}</a></li>
          <li><a href="/guias/remover-metadados-de-video/" class="footer-link">{isEn ? 'Guide: MP4 & MOV Videos' : 'Guia: Vídeos MP4 & MOV'}</a></li>
          <li><a href="/guias/remover-metadados-de-imagem/" class="footer-link">{isEn ? 'Guide: EXIF & GPS Photos' : 'Guia: Fotos EXIF & GPS'}</a></li>
          <li><a href="/guias/remover-metadados-pdf/" class="footer-link">{isEn ? 'Guide: PDF Documents' : 'Guia: Documentos PDF'}</a></li>
          <li><a href={isEn ? '/en/#faq' : '/#faq'} class="footer-link">{isEn ? 'Frequently Asked' : 'Perguntas Frequentes'}</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal -->
      <div class="footer-links-col">
        <h3 class="footer-heading">{isEn ? 'Legal & Privacy' : 'Legal & Privacidade'}</h3>
        <ul class="footer-link-list">
          <li><a href={privacyUrl} class="footer-link">{isEn ? 'Privacy Policy' : 'Política de Privacidade'}</a></li>
          <li><a href={isEn ? '/en/verification/' : '/verificacao/'} class="footer-link">{isEn ? 'Tests & Limitations' : 'Testes e Limitações'}</a></li>
          <li><a href={termsUrl} class="footer-link">{isEn ? 'Terms & Conditions' : 'Termos de Uso'}</a></li>
        </ul>
      </div>

      <!-- Col 4: Company & Contact -->
      <div class="footer-links-col">
        <h3 class="footer-heading">{isEn ? 'Company' : 'Institucional'}</h3>
        <ul class="footer-link-list">
          <li><a href={aboutUrl} class="footer-link">{isEn ? 'About Us' : 'Sobre Nós'}</a></li>
          <li><a href={contactUrl} class="footer-link">{isEn ? 'Contact Us' : 'Fale Conosco'}</a></li>
          <li><a href="/rss.xml" class="footer-link">{isEn ? 'RSS Feed' : 'Feed RSS'}</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="copyright-tag">&copy; {year} remover-metadados.com</span>
        <span class="footer-subtext">
          {isEn
            ? 'Application code: MIT. Brand and editorial content reserved.'
            : 'Código da aplicação: MIT. Marca e conteúdo editorial reservados.'}
        </span>
      </div>
      <div class="footer-bottom-right">
        <span class="footer-pill-notice">
          {isEn ? '🔒 Local Files • Optional Maps' : '🔒 Arquivos Locais • Mapas Opcionais'}
        </span>
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    padding: 3.5rem 0 2rem;
    border-top: 2px solid var(--border);
    margin-top: 4rem;
    background: var(--bg);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  /* Col 1: Brand */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .footer-brand-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .footer-description {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
    max-width: 396px; /* 360px * 1.1 */
  }

  .footer-brand-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .footer-featured-badges {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: repeat(2, 120px);
    align-items: center;
    gap: 0.6rem 0.75rem;
  }

  .footer-featured-badges a {
    display: block;
    width: 120px;
    height: 32px;
    border-radius: 6px;
    overflow: hidden;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .footer-featured-badges a:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }

  .footer-featured-badges img {
    display: block;
    width: 120px;
    height: 32px;
    border-radius: 6px;
  }

  /* Columns 2, 3, 4 */
  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text);
    margin: 0;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--border);
    display: inline-block;
  }

  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-link {
    font-size: 0.84rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.12s ease, transform 0.12s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: var(--text);
    transform: translateX(2px);
  }

  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
  }

  .compliance-dot {
    width: 7px;
    height: 7px;
    background: #22c55e;
    border-radius: 50%;
    display: inline-block;
  }

  .yellow-dot {
    background: #eab308;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--border);
  }

  .footer-bottom-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .copyright-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--btn-text);
    background: var(--btn-bg);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .footer-subtext {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-pill-notice {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text);
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    padding: 0.25rem 0.65rem;
    border-radius: 3px;
  }

  /* Responsiveness */
  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .footer-brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
    .footer-bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
