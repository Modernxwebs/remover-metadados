---
import OutputNotes from './OutputNotes.astro';
// Hero — headline + formats line + drop zone, privmeta-style
export interface Props {
  lang?: string;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';

const t = isEn
  ? {
      titleLine1: "Metadata Remover",
      titleLine2: "Remove EXIF & GPS from Photos",
      subtitle: "Remove supported location, camera and author metadata directly in your browser. Free, with no file uploads.",
      formatsTag: "FORMATS",
      badgePrivacy: "LOCAL FILE PROCESSING · NO FILE UPLOADS",
      dropPrompt: "Drag & drop your files here",
      dropOr: "or",
      browseBtn: "select from device",
      counterZero: "0 files",
      addMoreBtn: "Add more",
      clearBtn: "Clear all",
      processBtn: "Remove metadata",
      processingBtn: "Removing metadata...",
      downloadSingle: "Download clean file",
      downloadZip: "Download all (.zip)",
      statusWaiting: "Waiting",
      statusProcessing: "Processing",
      statusDone: "✓ Done",
      statusError: "Error",
      btnCleanOne: "Clean",
      btnRemoveOne: "Clean",
      removeFileAria: "Remove file from list",
      btnDownloadOne: "Download",
      zipFileName: "remover-metadados-cleaned.zip",
      generatingZip: "Creating ZIP...",
      downloadedZip: "✓ Downloaded (.zip)",
      errorZip: "Error creating ZIP",
      downloadedSingle: "✓ Downloaded",
      singularFile: "file",
      pluralFiles: "files",
      dropAria: "Drag files here or click to select from device",
      formatLabel: "Format",
      formatTooltip: "Select output format for downloaded files",
      formatOriginal: "Default output (by file type)",
      formatOriginalShort: "Default output",
      formatJpg: "JPG (.jpg)",
      formatPng: "PNG (.png)",
      formatWebp: "WebP (.webp)",
      formatAvif: "AVIF (.avif)",
      formatAll: "All formats (.zip)",
      formatAllShort: "All (.zip)",
      formatDocLocked: "Processed document",
      globalDropTitle: "Drop your files anywhere",
      globalDropSubtitle: "Release anywhere on the screen to remove metadata instantly",
      globalDropFormatsHint: "Photos, Images, PDFs, Documents, Videos & Audio · 100% Client-Side",
    }
  : {
      titleLine1: "Remover Metadados",
      titleLine2: "Apague GPS, EXIF e Dados Ocultos",
      subtitle: "Remova metadados compatíveis de localização, câmera e autoria direto no navegador. Grátis e sem envio de arquivos.",
      formatsTag: "FORMATOS",
      badgePrivacy: "PROCESSAMENTO LOCAL · SEM ENVIO DE ARQUIVOS",
      dropPrompt: "Arraste e solte seus arquivos aqui",
      dropOr: "ou",
      browseBtn: "selecionar do dispositivo",
      counterZero: "0 arquivos",
      addMoreBtn: "Adicionar mais",
      clearBtn: "Limpar tudo",
      processBtn: "Remover metadados",
      processingBtn: "Removendo metadados...",
      downloadSingle: "Baixar arquivo limpo",
      downloadZip: "Baixar todos (.zip)",
      statusWaiting: "Aguardando",
      statusProcessing: "Processando",
      statusDone: "✓ Concluído",
      statusError: "Erro",
      btnCleanOne: "Limpar",
      btnRemoveOne: "Limpar",
      removeFileAria: "Remover arquivo da lista",
      btnDownloadOne: "Baixar",
      zipFileName: "remover-metadados-limpos.zip",
      generatingZip: "Gerando ZIP...",
      downloadedZip: "✓ Baixado (.zip)",
      errorZip: "Erro ao gerar ZIP",
      downloadedSingle: "✓ Baixado",
      singularFile: "arquivo",
      pluralFiles: "arquivos",
      dropAria: "Arraste arquivos aqui ou clique para selecionar",
      formatLabel: "Formato",
      formatTooltip: "Selecione o formato de download dos arquivos limpos",
      formatOriginal: "Saída padrão (por tipo de arquivo)",
      formatOriginalShort: "Saída padrão",
      formatJpg: "JPG (.jpg)",
      formatPng: "PNG (.png)",
      formatWebp: "WebP (.webp)",
      formatAvif: "AVIF (.avif)",
      formatAll: "Todos os formatos (.zip)",
      formatAllShort: "Todos (.zip)",
      formatDocLocked: "Documento processado",
      globalDropTitle: "Solte seus arquivos em qualquer lugar",
      globalDropSubtitle: "Solte em qualquer parte da tela para remover metadados instantaneamente",
      globalDropFormatsHint: "Fotos, Imagens, PDFs, Documentos, Vídeos e Áudio · 100% no seu navegador",
    };
---

<section
  id="hero-section"
  data-i18n={JSON.stringify(t)}
  style="
    min-height: calc(100vh - var(--header-h, 77px));
    min-height: calc(100dvh - var(--header-h, 77px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 3.5vh, 2.5rem) 0;
    box-sizing: border-box;
  "
>
  <div class="page-wrap" style="width: 100%;">

    <!-- Headline & Sentence -->
    <h1 class="hero-title" style="margin-bottom: 1.25rem;">
      <span class="hero-line">{t.titleLine1}</span>
      <span class="hero-line">{t.titleLine2}</span>
    </h1>
    <p class="hero-subtitle">
      {t.subtitle}
    </p>

    <!-- Formats ticker bar -->
    <div class="formats-ticker">
      <div class="formats-ticker-lead">
        <span class="formats-ticker-badge">{t.formatsTag}</span>
        <span class="formats-group formats-group-images">
          JPEG · PNG · WEBP · AVIF · HEIC · SVG
        </span>
      </div>
      <span class="formats-group-sep" aria-hidden="true">·</span>
      <span class="formats-group formats-group-docs">
        PDF · DOCX · XLSX · PPTX · MP4 · MOV
      </span>
    </div>

    <!-- Hidden file input accessible to both dropzone & add-more button -->
    <input
      type="file"
      id="file-input"
      multiple
      accept="image/*,.avif,.pdf,.docx,.xlsx,.pptx,.odt,.ods,.odp,.mp3,.mp4,.m4v,.mov,.svg,.heic,.heif,.tif,.tiff"
      style="display:none;"
      aria-hidden="true"
    />

    <!-- Drop Zone -->
    <div
      id="drop-zone"
      class="drop-zone-main"
      role="button"
      tabindex="0"
      aria-label={t.dropAria}
    >
      <!-- Animated moving dashed border -->
      <svg
        class="drop-border-svg"
        aria-hidden="true"
      >
        <rect class="marching-rect" />
      </svg>

      <!-- Badge de segurança e privacidade em linguagem clara -->
      <div class="drop-privacy-badge">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: #16a34a; display: inline-block; flex-shrink: 0;"></span>
        <span>{t.badgePrivacy}</span>
      </div>

      <!-- Icon box -->
      <div class="drop-icon-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>

      <p class="drop-prompt-title">
        {t.dropPrompt}
      </p>
      <div class="drop-prompt-sub">
        <span>{t.dropOr}</span>
        <button id="browse-btn" class="btn-accent drop-browse-btn" type="button">
          {t.browseBtn}
        </button>
      </div>

      <!-- File count hint -->
      <div id="drop-counter" class="drop-counter-badge">{t.counterZero}</div>
    </div>

    <!-- Actions row (appears above the file list when files are added) -->
    <div id="actions-row" class="actions-toolbar" style="display:none;">
      <div class="actions-left">
        <button id="add-more-btn" class="btn-main add-more-btn" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <span>{t.addMoreBtn}</span>
        </button>

        <!-- Global format selector -->
        <div class="format-selector-wrap" title={t.formatTooltip}>
          <label for="global-format-select" class="format-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>{t.formatLabel}:</span>
          </label>
          <select id="global-format-select" class="neo-format-select" aria-label={t.formatLabel}>
            <option value="original">{t.formatOriginal}</option>
            <option value="jpg">{t.formatJpg}</option>
            <option value="png">{t.formatPng}</option>
            <option value="webp">{t.formatWebp}</option>
            <option value="avif">{t.formatAvif}</option>
            <option value="all">{t.formatAll}</option>
          </select>
        </div>
      </div>
      <div class="actions-right">
        <button id="clear-btn" class="btn-ghost" type="button">{t.clearBtn}</button>
        <button id="process-all-btn" class="btn-accent" type="button" disabled>
          {t.processBtn}
        </button>
      </div>
    </div>

    <OutputNotes lang={currentLocale} />

    <!-- File list (appears after files are added) -->
    <div id="file-list" style="display:none; margin-top: 0.5rem;" aria-live="polite">
      <div id="file-cards"></div>
    </div>

  </div>

  <!-- Global Fullscreen Drop Overlay -->
  <div id="global-drop-overlay" class="global-drop-overlay" aria-hidden="true" style="display:none;">
    <div class="global-drop-backdrop"></div>
    <div class="global-drop-modal">
      <div class="global-drop-badge">
        <span class="live-dot" aria-hidden="true"></span>
        <span>{t.badgePrivacy}</span>
      </div>
      <div class="global-drop-icon-box" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>
      <h2 class="global-drop-title">{t.globalDropTitle}</h2>
      <p class="global-drop-sub">{t.globalDropSubtitle}</p>
      <div class="global-drop-formats">
        <span>{t.globalDropFormatsHint}</span>
      </div>
    </div>
  </div>
</section>

<script type="module">
  import { removeMetadata, bundleAsZip, downloadBlob, isImageFile } from '/src/scripts/metadataRemover.js';
  import { escapeHtml } from '/src/scripts/html.js';

  const heroSection         = document.getElementById('hero-section');
  const t                   = JSON.parse(heroSection?.dataset?.i18n || '{}');

  const dropZone            = document.getElementById('drop-zone');
  const fileInput           = document.getElementById('file-input');
  const browseBtn           = document.getElementById('browse-btn');
  const addMoreBtn          = document.getElementById('add-more-btn');
  const actionsRow          = document.getElementById('actions-row');
  const fileList            = document.getElementById('file-list');
  const fileCards           = document.getElementById('file-cards');
  const dropCounter         = document.getElementById('drop-counter');
  const processAllBtn       = document.getElementById('process-all-btn');
  const clearBtn            = document.getElementById('clear-btn');
  const globalFormatSelect  = document.getElementById('global-format-select');
  const globalDropOverlay   = document.getElementById('global-drop-overlay');

  /** Helper: fire a GA4 event safely (won't crash if gtag isn't loaded yet) */
  function track(eventName, params = {}) {
    if (typeof gtag === 'function') gtag('event', eventName, params);
  }

  const downloadIconSvg = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;

  /** @type {'process' | 'download' | 'processing'} */
  let buttonMode = 'process';

  /** @type {string} */
  let currentGlobalFormat = 'original';

  /** @type {Map<string, { file: File, status: string, format: string, result: null | { blob: Blob, filename: string, files?: Array<{ blob: Blob, filename: string }> } }>} */
  const fileMap = new Map();

  function fmt(b) {
    if (b < 1024) return `${b} B`;
    if (b < 1048576) return `${(b/1024).toFixed(1)} KB`;
    return `${(b/1048576).toFixed(1)} MB`;
  }
  function ext(name) { return (name.split('.').pop() ?? '???').toUpperCase(); }
  function telemetryFileType(file) {
    const candidate = file?.name?.split('.').pop()?.toLowerCase() || '';
    const allowed = ['jpg', 'jpeg', 'png', 'webp', 'avif', 'heic', 'heif', 'tif', 'tiff', 'bmp', 'gif', 'svg', 'pdf', 'docx', 'xlsx', 'pptx', 'odt', 'ods', 'odp', 'mp3', 'mp4', 'mov', 'm4v'];
    return allowed.includes(candidate) ? candidate : 'unknown';
  }
  function genId(f)  { return `${f.name}-${f.size}-${f.lastModified}`; }

  function updateMainButton() {
    const allEntries = [...fileMap.values()];
    const totalCount = allEntries.length;
    const waitingCount = allEntries.filter(e => e.status === 'waiting').length;
    const processingCount = allEntries.filter(e => e.status === 'processing').length;
    const doneEntries = allEntries.filter(e => e.status === 'done' && e.result);

    if (totalCount === 0) {
      buttonMode = 'process';
      processAllBtn.disabled = true;
      processAllBtn.innerHTML = t.processBtn || 'Remover metadados';
      return;
    }

    if (processingCount > 0) {
      buttonMode = 'processing';
      processAllBtn.disabled = true;
      processAllBtn.innerHTML = `<span class="spin">↻</span> ${t.processingBtn || 'Removendo metadados...'}`;
      return;
    }

    if (waitingCount > 0) {
      buttonMode = 'process';
      processAllBtn.disabled = false;
      processAllBtn.innerHTML = t.processBtn || 'Remover metadados';
      return;
    }

    // All files are finished — convert directly into download button with clear descriptive text!
    if (doneEntries.length > 0) {
      buttonMode = 'download';
      processAllBtn.disabled = false;
      if (doneEntries.length === 1) {
        processAllBtn.innerHTML = `${downloadIconSvg} ${t.downloadSingle || 'Baixar arquivo limpo'}`;
      } else {
        processAllBtn.innerHTML = `${downloadIconSvg} ${t.downloadZip || 'Baixar todos (.zip)'}`;
      }
    }
  }

  function renderCards() {
    fileCards.innerHTML = '';
    for (const [id, entry] of fileMap) {
      const row = document.createElement('div');
      row.className = 'file-row';

      let statusHtml = '';
      let actionHtml = '';
      let formatHtml = '';

      if (isImageFile(entry.file.name)) {
        formatHtml = `
          <div class="file-format-cell" title="${t.formatTooltip || 'Formato de saída'}">
            <select class="neo-format-select-card file-format-select" data-id="${escapeHtml(id)}" aria-label="${t.formatLabel || 'Formato'}">
              <option value="original" ${entry.format === 'original' ? 'selected' : ''}>${t.formatOriginalShort || 'Original'}</option>
              <option value="jpg" ${entry.format === 'jpg' ? 'selected' : ''}>JPG</option>
              <option value="png" ${entry.format === 'png' ? 'selected' : ''}>PNG</option>
              <option value="webp" ${entry.format === 'webp' ? 'selected' : ''}>WebP</option>
              <option value="avif" ${entry.format === 'avif' ? 'selected' : ''}>AVIF</option>
              <option value="all" ${entry.format === 'all' ? 'selected' : ''}>${t.formatAllShort || 'Todos (.zip)'}</option>
            </select>
          </div>
        `;
      } else {
        formatHtml = `
          <div class="file-format-cell" title="${t.formatDocLocked || 'Documento processado'}">
            <span class="file-format-badge-doc">${escapeHtml(ext(entry.file.name))}</span>
          </div>
        `;
      }

      if (entry.status === 'waiting') {
        statusHtml = `<span class="file-status-text status-waiting">${t.statusWaiting || 'Aguardando'}</span>`;
        actionHtml = `
          <button class="btn-main process-one-btn" data-id="${escapeHtml(id)}" style="font-size:0.78rem;padding:0.35rem 0.75rem;" type="button">${t.btnCleanOne || t.btnRemoveOne || 'Clean'}</button>
          <button class="btn-icon remove-btn" data-id="${escapeHtml(id)}" type="button" aria-label="${t.removeFileAria || 'Remove file from list'}" title="${t.removeFileAria || 'Remove file from list'}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>`;
      } else if (entry.status === 'processing') {
        statusHtml = `<span class="file-status-text status-processing"><span class="spin">↻</span> ${t.statusProcessing || 'Processando'}</span>`;
      } else if (entry.status === 'done') {
        statusHtml = `<span class="file-status-text status-done">${t.statusDone || '✓ Concluído'}</span>`;
        actionHtml = `
          <button class="btn-accent download-one-btn" data-id="${escapeHtml(id)}" style="font-size:0.78rem;padding:0.35rem 0.75rem;" type="button">${t.btnDownloadOne || 'Baixar'}</button>
          <button class="btn-icon remove-btn" data-id="${escapeHtml(id)}" type="button" aria-label="${t.removeFileAria || 'Remove file from list'}" title="${t.removeFileAria || 'Remove file from list'}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>`;
      } else if (entry.status === 'error') {
        statusHtml = `<span class="file-status-text status-error">${t.statusError || 'Erro'}</span>`;
        actionHtml = `
          <button class="btn-icon remove-btn" data-id="${escapeHtml(id)}" type="button" aria-label="${t.removeFileAria || 'Remove file from list'}" title="${t.removeFileAria || 'Remove file from list'}">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>`;
      }

      row.innerHTML = `
        <span class="file-ext">${escapeHtml(ext(entry.file.name).slice(0,4))}</span>
        <span class="file-name-text" title="${escapeHtml(entry.file.name)}">${escapeHtml(entry.file.name)}</span>
        <div class="file-right-meta">
          <span class="file-size-text">${fmt(entry.file.size)}</span>
          ${formatHtml}
          ${statusHtml}
          <span style="display:flex;align-items:center;gap:0.35rem;">${actionHtml}</span>
        </div>
      `;
      fileCards.appendChild(row);
    }

    fileCards.querySelectorAll('.file-format-select').forEach(sel =>
      sel.addEventListener('change', async e => {
        const id = e.currentTarget.dataset.id;
        const entry = fileMap.get(id);
        if (!entry) return;
        const newFormat = e.currentTarget.value;
        if (entry.format === newFormat) return;
        entry.format = newFormat;

        track('file_format_changed', {
          format: newFormat,
          file_type: telemetryFileType(entry.file),
        });

        // If file already processed, re-convert instantly to the newly selected format
        if (entry.status === 'done') {
          await processFile(id, true);
        } else {
          renderCards();
          updateMainButton();
        }
      }));

    fileCards.querySelectorAll('.process-one-btn').forEach(btn =>
      btn.addEventListener('click', e => processFile(e.currentTarget.dataset.id)));
    fileCards.querySelectorAll('.download-one-btn').forEach(btn =>
      btn.addEventListener('click', e => {
        const entry = fileMap.get(e.currentTarget.dataset.id);
        if (entry?.result) {
          downloadBlob(entry.result.blob, entry.result.filename);
          track('file_downloaded', {
            file_type: telemetryFileType(entry.file),
            file_size_kb: Math.round(entry.file?.size / 1024),
            source: 'card_button',
            download_format: entry.format,
          });
        }
      }));
    fileCards.querySelectorAll('.remove-btn').forEach(btn =>
      btn.addEventListener('click', e => {
        const id = e.currentTarget.dataset.id;
        const entry = fileMap.get(id);
        if (entry) {
          track('file_removed', {
            file_type: telemetryFileType(entry.file),
            status_at_removal: entry.status,
          });
        }
        fileMap.delete(id);
        updateUI();
      }));

    const count = fileMap.size;
    dropCounter.textContent = `${count} ${count !== 1 ? (t.pluralFiles || 'arquivos') : (t.singularFile || 'arquivo')}`;
    updateMainButton();
  }

  function updateUI() {
    const count = fileMap.size;
    dropCounter.textContent = `${count} ${count !== 1 ? (t.pluralFiles || 'arquivos') : (t.singularFile || 'arquivo')}`;
    if (globalFormatSelect) {
      globalFormatSelect.value = currentGlobalFormat;
    }
    if (count === 0) {
      fileCards.replaceChildren();
      dropZone.style.display = '';
      actionsRow.style.display = 'none';
      fileList.style.display = 'none';
      updateMainButton();
    } else {
      dropZone.style.display = 'none';
      actionsRow.style.display = 'flex';
      fileList.style.display = 'block';
      renderCards();
    }
  }

  async function processFile(id, isReformat = false) {
    const entry = fileMap.get(id);
    if (!entry || entry.status === 'processing') return;
    if (!isReformat && entry.status === 'done') return;
    entry.status = 'processing';
    renderCards();
    try {
      entry.result = await removeMetadata(entry.file, () => {}, { format: entry.format || currentGlobalFormat });
      entry.status = 'done';
      // ✅ Event: successful metadata removal
      track('metadata_removed', {
        file_type: telemetryFileType(entry.file),
        file_size_kb: Math.round(entry.file.size / 1024),
        output_format: entry.format || currentGlobalFormat,
      });
    } catch (err) {
      console.error(err);
      entry.status = 'error';
      // ⚠️ Event: processing error
      track('metadata_error', {
        file_type: telemetryFileType(entry.file),
        error_code: 'processing_failed',
      });
    }
    renderCards();
    updateMainButton();
  }

  async function handleMainAction() {
    if (buttonMode === 'process') {
      const ids = [...fileMap.keys()].filter(id => fileMap.get(id).status === 'waiting');
      if (!ids.length) return;
      track('process_all_started', {
        file_count: ids.length,
      });
      buttonMode = 'processing';
      processAllBtn.disabled = true;
      processAllBtn.innerHTML = `<span class="spin">↻</span> ${t.processingBtn || 'Removendo metadados...'}`;
      for (const id of ids) {
        await processFile(id);
      }
    } else if (buttonMode === 'download') {
      const doneEntries = [...fileMap.values()].filter(e => e.status === 'done' && e.result);
      if (!doneEntries.length) return;

      if (doneEntries.length === 1) {
        downloadBlob(doneEntries[0].result.blob, doneEntries[0].result.filename);
        // ✅ Event: single file downloaded
        track('file_downloaded', {
          file_type: telemetryFileType(doneEntries[0].file),
          file_size_kb: Math.round(doneEntries[0].file?.size / 1024),
          download_format: doneEntries[0].format,
        });
        const originalHtml = processAllBtn.innerHTML;
        processAllBtn.innerHTML = t.downloadedSingle || `✓ Baixado`;
        setTimeout(() => {
          if (buttonMode === 'download') processAllBtn.innerHTML = originalHtml;
        }, 1500);
      } else {
        processAllBtn.disabled = true;
        processAllBtn.innerHTML = `<span class="spin">↻</span> ${t.generatingZip || 'Gerando ZIP...'}`;
        try {
          const zip = await bundleAsZip(doneEntries.map(e => e.result));
          downloadBlob(zip, t.zipFileName || 'remover-metadados-limpos.zip');
          // ✅ Event: ZIP bundle downloaded
          track('zip_downloaded', { file_count: doneEntries.length });
          processAllBtn.innerHTML = t.downloadedZip || `✓ Baixado (.zip)`;
        } catch (err) {
          console.error(err);
          processAllBtn.innerHTML = t.errorZip || `Erro ao gerar ZIP`;
        } finally {
          setTimeout(() => {
            processAllBtn.disabled = false;
            updateMainButton();
          }, 1500);
        }
      }
    }
  }

  function addFiles(files) {
    let newCount = 0;
    const types = new Set();
    for (const f of files) {
      const id = genId(f);
      if (!fileMap.has(id)) {
        fileMap.set(id, {
          file: f,
          status: 'waiting',
          format: isImageFile(f.name) ? currentGlobalFormat : 'original',
          result: null,
        });
        newCount++;
        types.add(telemetryFileType(f));
      }
    }
    if (newCount > 0) {
      // ✅ Event: files added to the drop zone
      track('file_added', {
        file_count: newCount,
        file_types: [...types].join(','),
      });
    }
    updateUI();
  }

  globalFormatSelect?.addEventListener('change', async e => {
    currentGlobalFormat = e.currentTarget.value;
    track('global_format_changed', { format: currentGlobalFormat });

    const reprocessList = [];
    for (const [id, entry] of fileMap) {
      if (isImageFile(entry.file.name)) {
        entry.format = currentGlobalFormat;
        if (entry.status === 'done') {
          reprocessList.push(processFile(id, true));
        }
      }
    }
    if (reprocessList.length > 0) {
      await Promise.all(reprocessList);
    } else {
      renderCards();
      updateMainButton();
    }
  });

  browseBtn.addEventListener('click', e => { e.stopPropagation(); fileInput.click(); });
  addMoreBtn.addEventListener('click', e => { e.stopPropagation(); fileInput.click(); });
  dropZone.addEventListener('click', e => { if (e.target.tagName !== 'BUTTON') fileInput.click(); });
  dropZone.addEventListener('keydown', e => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) addFiles(Array.from(fileInput.files));
    fileInput.value = '';
  });

  let windowDragCounter = 0;

  function showGlobalDropOverlay(show) {
    if (!globalDropOverlay) return;
    if (show) {
      globalDropOverlay.style.display = 'flex';
      requestAnimationFrame(() => {
        globalDropOverlay.classList.add('active');
      });
    } else {
      globalDropOverlay.classList.remove('active');
      setTimeout(() => {
        if (!globalDropOverlay.classList.contains('active')) {
          globalDropOverlay.style.display = 'none';
        }
      }, 150);
    }
  }

  function isDragWithFiles(e) {
    if (!e.dataTransfer) return false;
    const types = e.dataTransfer.types;
    if (!types) return false;
    for (let i = 0; i < types.length; i++) {
      if (types[i] === 'Files') return true;
    }
    return false;
  }

  function handleIncomingFiles(files) {
    if (!files || !files.length) return;
    addFiles(files);
    if (heroSection) {
      const rect = heroSection.getBoundingClientRect();
      if (rect.top < -50 || rect.bottom > window.innerHeight + 100) {
        heroSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }
  }

  // Window-level drag & drop so dropping anywhere on the entire screen works reliably
  window.addEventListener('dragenter', e => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    windowDragCounter++;
    if (windowDragCounter === 1) {
      showGlobalDropOverlay(true);
      if (dropZone) dropZone.classList.add('drag-over');
    }
  });

  window.addEventListener('dragover', e => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    if (e.dataTransfer) {
      try { e.dataTransfer.dropEffect = 'copy'; } catch {}
    }
  });

  window.addEventListener('dragleave', e => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    if (e.clientX <= 0 || e.clientY <= 0 || e.clientX >= window.innerWidth || e.clientY >= window.innerHeight || !e.relatedTarget) {
      windowDragCounter = 0;
      showGlobalDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
      return;
    }
    windowDragCounter--;
    if (windowDragCounter <= 0) {
      windowDragCounter = 0;
      showGlobalDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
    }
  });

  window.addEventListener('drop', e => {
    e.preventDefault();
    e.stopPropagation();
    windowDragCounter = 0;
    showGlobalDropOverlay(false);
    if (dropZone) dropZone.classList.remove('drag-over');

    const files = Array.from(e.dataTransfer?.files ?? []);
    if (files.length > 0) {
      handleIncomingFiles(files);
    }
  });

  window.addEventListener('dragend', () => {
    windowDragCounter = 0;
    showGlobalDropOverlay(false);
    if (dropZone) dropZone.classList.remove('drag-over');
  });

  window.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      windowDragCounter = 0;
      showGlobalDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
    }
  });

  // Check if user dropped files on another page that stashed them for the hero tool
  try {
    if (window.indexedDB) {
      const req = indexedDB.open('remover_metadados_drop_db', 1);
      req.onupgradeneeded = () => {
        if (!req.result.objectStoreNames.contains('incoming_files')) {
          req.result.createObjectStore('incoming_files', { keyPath: 'id' });
        }
      };
      req.onsuccess = () => {
        const db = req.result;
        if (!db.objectStoreNames.contains('incoming_files')) return;
        const tx = db.transaction('incoming_files', 'readwrite');
        const store = tx.objectStore('incoming_files');
        const getReq = store.get('pending');
        getReq.onsuccess = () => {
          const item = getReq.result;
          // Consume or discard every handoff, including expired entries. Never
          // leave an old dropped file in persistent storage after a tool visit.
          store.clear();
          if (item && item.files && item.files.length && (Date.now() - item.timestamp >= 0) && (Date.now() - item.timestamp < 30000)) {
            handleIncomingFiles(item.files);
          }
        };
        tx.oncomplete = () => db.close();
        tx.onerror = () => db.close();
      };
    }
  } catch {}

  processAllBtn.addEventListener('click', handleMainAction);

  clearBtn.addEventListener('click', () => {
    const count = fileMap.size;
    fileMap.clear();
    currentGlobalFormat = 'original';
    if (globalFormatSelect) globalFormatSelect.value = 'original';
    // ✅ Event: user cleared all files
    track('files_cleared', { file_count: count });
    updateUI();
  });
</script>

