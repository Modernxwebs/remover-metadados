---
// Supported Formats — 4-column container showcase
export interface Props {
  lang?: string;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';

const categories = isEn
  ? [
      {
        id: "images",
        title: "Images",
        icon: "image",
        formats: ["JPEG", "PNG", "WebP", "HEIC", "GIF", "SVG", "TIFF", "BMP"],
        desc: "Re-encodes raster images or strips PNG metadata chunks. Quality, output format and animation depend on the input type.",
      },
      {
        id: "pdfs",
        title: "PDFs",
        icon: "pdf",
        formats: ["PDF"],
        desc: "Clears standard Info fields and detaches catalog XMP. Comments, attachments, custom properties and embedded image metadata can remain.",
      },
      {
        id: "office",
        title: "Office Documents",
        icon: "office",
        formats: ["DOCX", "XLSX", "PPTX"],
        desc: "Clears core/app properties, custom properties and selected thumbnails. Document comments, tracked changes and embedded files remain.",
      },
      {
        id: "multimedia",
        title: "Audio & Video",
        icon: "media",
        formats: ["MP4", "MOV", "MP3"],
        desc: "Targets MP3 ID3 tags and selected MP4/MOV user-data and XMP boxes. Other tags, dates and track metadata can remain.",
      },
    ]
  : [
      {
        id: "imagens",
        title: "Imagens",
        icon: "image",
        formats: ["JPEG", "PNG", "WebP", "HEIC", "GIF", "SVG", "TIFF", "BMP"],
        desc: "Recodifica imagens raster ou remove blocos de metadados PNG. Qualidade, formato de saída e animação dependem do arquivo.",
      },
      {
        id: "pdfs",
        title: "PDFs",
        icon: "pdf",
        formats: ["PDF"],
        desc: "Limpa campos Info padrão e desvincula XMP do catálogo. Comentários, anexos, propriedades personalizadas e metadados de imagens podem permanecer.",
      },
      {
        id: "office",
        title: "Documentos Office",
        icon: "office",
        formats: ["DOCX", "XLSX", "PPTX"],
        desc: "Limpa propriedades core/app, propriedades personalizadas e miniaturas selecionadas. Comentários, alterações controladas e arquivos embutidos permanecem.",
      },
      {
        id: "multimidia",
        title: "Áudio e Vídeo",
        icon: "media",
        formats: ["MP4", "MOV", "MP3"],
        desc: "Trata tags ID3 de MP3 e caixas de dados do usuário e XMP selecionadas em MP4/MOV. Outras tags, datas e dados de faixas podem permanecer.",
      },
    ];
---

<section id={isEn ? "formats" : "formatos"} style="padding: 4rem 0; border-top: 2px solid var(--border);">
  <div class="page-wrap">

    <h2>{isEn ? "Supported file formats" : "Formatos de arquivo suportados"}</h2>

    <div class="format-cards-grid">
      {categories.map((cat) => (
        <div class="format-category-card">
          <!-- Top row: Icon + Title -->
          <div class="format-card-top">
            <div class="format-icon" aria-hidden="true">
              {cat.icon === "image" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                  <circle cx="9" cy="9" r="2"/>
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                </svg>
              )}
              {cat.icon === "pdf" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>
              )}
              {cat.icon === "office" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <path d="M2 15h10"/>
                  <path d="m9 18 3-3-3-3"/>
                </svg>
              )}
              {cat.icon === "media" && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="15" x="2" y="5" rx="2"/>
                  <polyline points="17 2 12 5 7 2"/>
                </svg>
              )}
            </div>
            <h3 class="format-title">{cat.title}</h3>
          </div>

          <!-- Format pill tags -->
          <div class="format-pills-wrap">
            {cat.formats.map((f) => (
              <span class="format-pill">{f}</span>
            ))}
          </div>

          <!-- Description text -->
          <p class="format-card-desc">{cat.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .format-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    text-align: left;
  }

  .format-category-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 4px;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .format-category-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--neo-shadow-lg);
  }

  .format-card-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .format-icon {
    width: 30px;
    height: 30px;
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    background: var(--bg);
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    flex-shrink: 0;
  }

  .format-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.3;
  }

  .format-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
    min-height: 28px;
  }

  .format-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    border-radius: 2px;
    padding: 0.2rem 0.45rem;
    transition: transform 0.12s ease;
  }

  .format-pill:hover {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px var(--shadow-color);
  }

  .format-card-desc {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    margin-top: auto;
  }

  @media (max-width: 980px) {
    .format-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 580px) {
    .format-cards-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
