---
export interface Props {
  isEn?: boolean;
  ptUrl?: string;
  enUrl?: string;
  targetUrl?: string;
}

const isEn = Astro.props.isEn || false;
const currentPath = Astro.url.pathname;

const routeMap: Record<string, string> = {
  '/ver-metadados/': '/en/metadata-viewer/',
  '/ver-metadados': '/en/metadata-viewer/',
  '/sobre/': '/en/about/',
  '/sobre': '/en/about/',
  '/contato/': '/en/contact/',
  '/contato': '/en/contact/',
  '/privacidade/': '/en/privacy/',
  '/privacidade': '/en/privacy/',
  '/termos/': '/en/terms/',
  '/termos': '/en/terms/',
  '/': '/en/',
};

const reverseRouteMap: Record<string, string> = {
  '/en/metadata-viewer/': '/ver-metadados/',
  '/en/metadata-viewer': '/ver-metadados/',
  '/en/about/': '/sobre/',
  '/en/about': '/sobre/',
  '/en/contact/': '/contato/',
  '/en/contact': '/contato/',
  '/en/privacy/': '/privacidade/',
  '/en/privacy': '/privacidade/',
  '/en/terms/': '/termos/',
  '/en/terms': '/termos/',
  '/en/': '/',
  '/en': '/',
};

let switchUrl = Astro.props.targetUrl;
if (!switchUrl) {
  if (isEn) {
    switchUrl = Astro.props.ptUrl || reverseRouteMap[currentPath] || '/';
  } else {
    switchUrl = Astro.props.enUrl || routeMap[currentPath] || '/en/';
  }
}

const isViewer = currentPath.includes('/ver-metadados') || currentPath.includes('/metadata-viewer');
---

<aside
  id="language-suggestion"
  class="language-suggestion"
  aria-label="Language suggestion"
  hidden
>
  <button
    type="button"
    class="language-suggestion-close"
    aria-label={isEn ? 'Fechar sugestão de idioma' : 'Close language suggestion'}
  ><span aria-hidden="true">×</span></button>
  <div class="language-suggestion-copy">
    <span class="language-suggestion-icon" aria-hidden="true">{isEn ? 'PT' : 'EN'}</span>
    <p>
      <strong>{isEn ? 'Prefere português?' : 'Prefer English?'}</strong>
      {isEn
        ? (isViewer ? 'Veja o Visualizador de Metadados em português.' : 'Veja a versão brasileira do Remover Metadados.')
        : (isViewer ? 'View the Metadata Viewer in English.' : 'View the global English version of Metadata Remover.')}
    </p>
  </div>
  <div class="language-suggestion-actions">
    <a
      href={switchUrl}
      class="language-suggestion-button language-suggestion-primary"
      data-language-choice={isEn ? 'pt' : 'en'}
    >{isEn ? 'Ver em português' : 'View in English'}</a>
    <button
      type="button"
      class="language-suggestion-button language-suggestion-dismiss"
      data-language-choice={isEn ? 'en' : 'pt'}
    >{isEn ? 'Continue in English' : 'Continuar em português'}</button>
  </div>
</aside>

<script is:inline define:vars={{ isEn }}>
  (() => {
    const suggestion = document.getElementById('language-suggestion');
    if (!suggestion) return;

    const preferenceKey = 'preferred-language';
    const sessionDismissalKey = 'language-suggestion-dismissed';
    const storedPreference = localStorage.getItem(preferenceKey);
    const dismissedThisSession = sessionStorage.getItem(sessionDismissalKey);
    const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
    const prefersPortuguese = languages.some((language) => /^pt(?:-|$)/i.test(language || ''));
    const shouldSuggestAlternateLanguage = isEn ? prefersPortuguese : !prefersPortuguese;

    // Safety fallback: ensure anchor href points to correct page pair dynamically
    const link = suggestion.querySelector('a[data-language-choice]');
    if (link) {
      const path = window.location.pathname;
      if (path.includes('/ver-metadados')) {
        link.href = '/en/metadata-viewer/';
      } else if (path.includes('/metadata-viewer')) {
        link.href = '/ver-metadados/';
      } else if (path.includes('/sobre')) {
        link.href = '/en/about/';
      } else if (path.includes('/about')) {
        link.href = '/sobre/';
      } else if (path.includes('/contato')) {
        link.href = '/en/contact/';
      } else if (path.includes('/contact')) {
        link.href = '/contato/';
      } else if (path.includes('/privacidade')) {
        link.href = '/en/privacy/';
      } else if (path.includes('/privacy')) {
        link.href = '/privacidade/';
      } else if (path.includes('/termos')) {
        link.href = '/en/terms/';
      } else if (path.includes('/terms')) {
        link.href = '/termos/';
      }
    }

    const hideSuggestion = () => {
      suggestion.hidden = true;
    };

    const dismissForSession = () => {
      hideSuggestion();
      sessionStorage.setItem(sessionDismissalKey, 'true');
    };

    if (!storedPreference && !dismissedThisSession && shouldSuggestAlternateLanguage) {
      suggestion.hidden = false;
      window.setTimeout(hideSuggestion, 10000);
    }

    suggestion.querySelector('.language-suggestion-close')?.addEventListener('click', dismissForSession);

    suggestion.querySelectorAll('[data-language-choice]').forEach((control) => {
      control.addEventListener('click', () => {
        const choice = control.getAttribute('data-language-choice');
        if (choice) localStorage.setItem(preferenceKey, choice);
        if (control.tagName === 'BUTTON') hideSuggestion();
      });
    });
  })();
</script>

<style>
  .language-suggestion {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 760px;
    margin: 0 auto;
    padding: 0.8rem 2.8rem 0.8rem 1rem;
    background: var(--card-bg);
    color: var(--text);
    border: 2px solid var(--border);
    border-radius: 4px;
    box-shadow: var(--neo-shadow-lg);
  }

  .language-suggestion-copy,
  .language-suggestion-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .language-suggestion-close {
    position: absolute;
    inset: 0.45rem 0.5rem auto auto;
    left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    background: transparent;
    color: var(--text-muted);
    border: 0;
    border-radius: 3px;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }

  .language-suggestion-close:hover,
  .language-suggestion-close:focus-visible {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .language-suggestion-copy p {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .language-suggestion-copy strong {
    display: block;
    font-size: 0.85rem;
  }

  .language-suggestion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .language-suggestion-button {
    padding: 0.45rem 0.65rem;
    border: 2px solid var(--border);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .language-suggestion-primary {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .language-suggestion-dismiss {
    background: transparent;
    color: var(--text);
  }

  .language-suggestion-button:hover,
  .language-suggestion-button:focus-visible {
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 var(--shadow-color);
  }

  @media (max-width: 600px) {
    .language-suggestion {
      align-items: stretch;
      flex-direction: column;
      gap: 0.7rem;
      bottom: 0.65rem;
      padding: 0.8rem 2.55rem 0.8rem 0.8rem;
    }

    .language-suggestion-actions {
      width: 100%;
    }

    .language-suggestion-button {
      flex: 1;
      text-align: center;
    }
  }
</style>
