---
// Header — logo left, nav + lang switcher + dark toggle right with responsive mobile menu
export interface Props {
  lang?: string;
  ptUrl?: string;
  enUrl?: string;
  isSubpage?: boolean;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';
const isSubpage = Astro.props.isSubpage || false;
const ptSwitchUrl = Astro.props.ptUrl || '/';
const enSwitchUrl = Astro.props.enUrl || '/en/';

const homeUrl = isEn ? '/en/' : '/';
const brandName = isEn ? 'Metadata Remover' : 'Remover Metadados';
const navLinks = isEn
  ? [
      { href: isSubpage ? '/en/#how-it-works' : '#how-it-works', label: 'How it works' },
      { href: isSubpage ? '/en/#formats' : '#formats', label: 'Formats' },
      { href: isSubpage ? '/en/#privacy-guide' : '#privacy-guide', label: 'Guide' },
      { href: isSubpage ? '/en/#faq' : '#faq', label: 'FAQ' },
    ]
  : [
      { href: isSubpage ? '/#como-funciona' : '#como-funciona', label: 'Como funciona' },
      { href: isSubpage ? '/#formatos' : '#formatos', label: 'Formatos' },
      { href: isSubpage ? '/#guia-metadados' : '#guia-metadados', label: 'Guia' },
      { href: isSubpage ? '/#faq' : '#faq', label: 'FAQ' },
    ];
---

<header class="site-header">
  <div class="page-wrap header-inner">

    <!-- Logo -->
    <a href={homeUrl} class="logo-link">
      <span class="logo-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </span>
      <span class="logo-text">
        {brandName}
      </span>
    </a>

    <!-- Right Controls -->
    <div class="header-right">
      <!-- Desktop nav -->
      <nav class="desktop-nav" aria-label={isEn ? "Main navigation" : "Navegação principal"}>
        {navLinks.map((item) => (
          <a href={item.href} class="nav-link">{item.label}</a>
        ))}
      </nav>

      <!-- Language switcher -->
      <div class="lang-switcher">
        <a
          href={ptSwitchUrl}
          class={`lang-btn ${!isEn ? 'active' : ''}`}
          data-language-choice="pt"
          title="Versão em Português"
        >PT</a>
        <span class="lang-divider"></span>
        <a
          href={enSwitchUrl}
          class={`lang-btn ${isEn ? 'active' : ''}`}
          data-language-choice="en"
          title="English Version"
        >EN</a>
      </div>

      <!-- Dark/light toggle -->
      <button
        id="theme-toggle"
        class="btn-icon"
        aria-label={isEn ? "Toggle theme" : "Alternar tema"}
        title={isEn ? "Toggle theme" : "Alternar tema"}
      >
        <svg id="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <svg id="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Mobile hamburger toggle button -->
      <button
        id="mobile-menu-btn"
        class="btn-icon mobile-menu-btn"
        aria-label={isEn ? "Toggle menu" : "Abrir menu"}
        aria-expanded="false"
      >
        <svg id="icon-menu-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <svg id="icon-menu-close" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Navigation Drawer -->
  <div id="mobile-nav-panel" class="mobile-nav-panel">
    <nav class="mobile-nav-links" aria-label={isEn ? "Mobile navigation" : "Navegação mobile"}>
      {navLinks.map((item) => (
        <a href={item.href} class="mobile-nav-link">
          <span>{item.label}</span>
          <span class="mobile-nav-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: var(--header-h, 77px);
    display: flex;
    align-items: center;
    border-bottom: 2px solid var(--border);
    background: var(--bg);
    position: relative;
    z-index: 100;
    box-sizing: border-box;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.75rem;
  }

  .logo-link {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .logo-text {
    font-size: clamp(0.95rem, 3vw, 1.05rem);
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-switcher {
    display: inline-flex;
    align-items: center;
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    background: var(--card-bg);
    border-radius: 3px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .lang-btn {
    padding: 0.2rem 0.5rem;
    text-decoration: none;
    color: var(--text-muted);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .lang-btn.active {
    color: var(--btn-accent-text);
    background: var(--btn-accent);
  }

  .lang-divider {
    width: 1px;
    height: 14px;
    background: var(--border);
  }

  .mobile-menu-btn {
    display: none;
  }

  /* Mobile Drawer Panel */
  .mobile-nav-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--card-bg);
    border-bottom: 2px solid var(--border);
    box-shadow: 0 10px 0 var(--shadow-color);
    padding: 1rem 1.25rem;
    z-index: 99;
  }

  .mobile-nav-panel.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0 var(--shadow-color);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    transition: transform 0.12s ease, background-color 0.15s ease;
  }

  .mobile-nav-link:active,
  .mobile-nav-link:hover {
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    transform: translate(-1px, -1px);
  }

  .mobile-nav-arrow {
    font-size: 1rem;
    font-weight: 700;
  }

  /* Dark mode icon switching */
  html.dark #icon-sun  { display: block; }
  html.dark #icon-moon { display: none; }
  html:not(.dark) #icon-sun  { display: none; }
  html:not(.dark) #icon-moon { display: block; }

  @media (max-width: 768px) {
    .site-header {
      height: var(--header-h, 64px);
    }
    .desktop-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: inline-flex;
    }
    .header-right {
      gap: 0.5rem;
    }
    .logo-text {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 400px) {
    .logo-text {
      font-size: 0.88rem;
    }
    .header-right {
      gap: 0.35rem;
    }
    .lang-btn {
      padding: 0.2rem 0.4rem;
      font-size: 0.65rem;
    }
  }
</style>

<script>
  // Theme Toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileNavPanel = document.getElementById('mobile-nav-panel');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  function toggleMenu(forceClose = false) {
    const isCurrentlyOpen = mobileNavPanel?.classList.contains('open');
    const willOpen = forceClose ? false : !isCurrentlyOpen;

    if (willOpen) {
      mobileNavPanel?.classList.add('open');
      mobileMenuBtn?.setAttribute('aria-expanded', 'true');
      if (iconOpen) iconOpen.style.display = 'none';
      if (iconClose) iconClose.style.display = 'block';
    } else {
      mobileNavPanel?.classList.remove('open');
      mobileMenuBtn?.setAttribute('aria-expanded', 'false');
      if (iconOpen) iconOpen.style.display = 'block';
      if (iconClose) iconClose.style.display = 'none';
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMenu());

  // Close drawer when link clicked
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(true));
  });

  // Remember an explicit language choice made in the header.
  document.querySelectorAll('[data-language-choice].lang-btn').forEach((link) => {
    link.addEventListener('click', () => {
      const choice = link.getAttribute('data-language-choice');
      if (choice) localStorage.setItem('preferred-language', choice);
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const target = e.target;
    if (
      mobileNavPanel?.classList.contains('open') &&
      !mobileNavPanel.contains(target) &&
      !mobileMenuBtn?.contains(target)
    ) {
      toggleMenu(true);
    }
  });
</script>
