---
export interface Props {
  title: string;
  url: string;
  isEn?: boolean;
}

const { title, url, isEn = false } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const twitterUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const whatsappUrl = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
---

<div class="blog-share-bar">
  <span class="share-label">{isEn ? 'Share this article:' : 'Compartilhe este artigo:'}</span>

  <div class="share-buttons">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-whatsapp"
      title={isEn ? "Share on WhatsApp" : "Compartilhar no WhatsApp"}
      aria-label="WhatsApp"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <a
      href={twitterUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-twitter"
      title={isEn ? "Share on X (Twitter)" : "Compartilhar no X (Twitter)"}
      aria-label="X (Twitter)"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>X</span>
    </a>

    <a
      href={linkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-linkedin"
      title={isEn ? "Share on LinkedIn" : "Compartilhar no LinkedIn"}
      aria-label="LinkedIn"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect x="2" y="9" width="4" height="12"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
      <span>LinkedIn</span>
    </a>

    <button
      type="button"
      id="copy-link-btn"
      class="share-btn share-copy"
      data-url={url}
      title={isEn ? "Copy link to clipboard" : "Copiar link"}
      aria-label={isEn ? "Copy link" : "Copiar link"}
    >
      <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <span id="copy-btn-text">{isEn ? 'Copy' : 'Copiar'}</span>
    </button>
  </div>
</div>

<style>
  .blog-share-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    border-radius: 4px;
    margin: 2rem 0;
  }

  .share-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    border: 1.5px solid var(--border);
    background: var(--bg);
    color: var(--text);
    text-decoration: none;
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
    border-radius: 2px;
    cursor: pointer;
    transition: transform 0.12s ease, background 0.15s ease;
  }

  .share-btn:hover {
    transform: translate(-1px, -1px);
    background: var(--btn-accent);
    color: var(--btn-accent-text);
  }

  .share-copy.copied {
    background: #22c55e !important;
    color: #ffffff !important;
  }

  @media (max-width: 640px) {
    .blog-share-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.getAttribute('data-url') || window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      if (copyText) {
        const original = copyText.textContent;
        copyText.textContent = copyBtn.title.includes('clipboard') ? 'Copied!' : 'Copiado!';
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyText.textContent = original;
          copyBtn.classList.remove('copied');
        }, 2200);
      }
    } catch {
      // Fallback
    }
  });
</script>
