---
// MetadataViewerTool.astro — Neo-Brutalist 100% Client-Side Metadata Viewer (supports pt-BR and en)
export interface Props {
  lang?: string;
}

const currentLocale = Astro.props.lang || Astro.currentLocale || 'pt-BR';
const isEn = currentLocale === 'en';

const t = isEn
  ? {
      privacyBadge: "100% PRIVATE · LOCAL IN-BROWSER INSPECTION",
      dropTitle: "Drag & drop photos or documents here",
      dropDesc: "or click to browse files from your computer or phone",
      browseBtn: "Choose Files",
      sampleBtn: "⚡ Test Sample with GPS",
      sampleHint: "Test viewer with a sample photo containing GPS and EXIF",
      formatsNote: "Supports photos (JPG, PNG, HEIC, WebP, TIFF), documents (PDF, DOCX, XLSX, PPTX) and media (MP4, MP3)",
      loadingText: "Reading metadata locally in your browser...",
      loadingSub: "No files ever leave your device.",
      filesLoadedPlural: "files loaded",
      filesLoadedSingular: "file loaded",
      addMore: "+ Add More",
      clearAll: "Clear All",
      cleanBtnText: "Clean Metadata from This File Now",
      cleaningBtnText: "Removing metadata...",
      cleanedBtnText: "✓ Cleaned & Downloaded",
      reDownloadBtnText: "Download Clean File Again",
      cleanFormatLabel: "Format",
      cleanFormatTooltip: "Choose format for cleaned file",
      cleanFormatOriginal: "Original (Default)",
      cleanFormatAll: "All formats (.zip)",
      copyJson: "Copy JSON",
      copiedJson: "✓ JSON Copied!",
      exportReport: "Export Report",
      tabGeneral: "📌 Overview",
      tabCamera: "📷 Camera & EXIF",
      tabGps: "🗺️ Location & GPS",
      tabDoc: "📄 Document & Author",
      tabMedia: "🎵 Audio / Video",
      tabRaw: "🔍 All Data",
      headerProperty: "Property / Metadata Tag",
      headerValue: "Detected Value",
      headerAction: "Copy",
      clearFilter: "Clear filter",
      cameraSectionTitle: "Photography & Device Specifications (EXIF / IPTC)",
      cameraSectionSub: "Optical parameters, original timestamp, and camera hardware details.",
      gpsAlertTitle: "Satellite Coordinates Found in File!",
      gpsAlertDesc: "This image contains exact latitude and longitude coordinates where it was taken. Anyone with this file can see your home, workplace, or travel route.",
      coordLat: "Latitude",
      coordLon: "Longitude",
      coordAlt: "Altitude",
      coordAltSub: "Above sea level",
      openGoogleMaps: "📍 Open in Google Maps ↗",
      openOsm: "🗺️ Open in OpenStreetMap ↗",
      copyCoords: "📋 Copy Coordinates",
      copiedCoords: "✓ Coordinates Copied!",
      mapTitle: "Location Preview on Map",
      mapTag: "OpenStreetMap (Zero Tracking)",
      docSectionTitle: "Document Metadata & Properties",
      docSectionSub: "Author identity, creating application, revision cycles, and editing history.",
      mediaSectionTitle: "Media File Tags & Attributes",
      mediaSectionSub: "ID3 tags, artist, album, track duration, and media codec info.",
      searchPlaceholder: "Filter by tag name or value (e.g., Model, Date, GPS, Creator)...",
      tagsFound: "tags found",
      emptyFilter: "No tags match the search term",
      emptyCategory: "No metadata found in this category.",
      reportTitle: "METADATA REPORT - METADATA REMOVER",
      reportFile: "File",
      reportSize: "Size",
      reportFormat: "Format",
      reportDate: "Analysis Date",
      reportRisk: "[PRIVACY RISK ASSESSMENT]",
      reportGps: "[GPS LOCATION]",
      reportGeneral: "[GENERAL FILE DATA]",
      reportCamera: "[CAMERA AND EXIF]",
      reportDoc: "[DOCUMENT PROPERTIES]",
      sampleFileName: "sample-photo-sao-paulo.jpg",
      globalDropTitle: "Drop your files anywhere to inspect",
      globalDropSubtitle: "Release anywhere on the screen to view EXIF, GPS & hidden metadata",
      globalDropFormatsHint: "Photos, Images, PDFs, Documents, Videos & Audio · 100% Client-Side",
    }
  : {
      privacyBadge: "100% PRIVADO · LEITURA LOCAL NO NAVEGADOR",
      dropTitle: "Arraste e solte fotos ou documentos aqui",
      dropDesc: "ou clique para selecionar arquivos do seu celular ou computador",
      browseBtn: "Escolher Arquivos",
      sampleBtn: "⚡ Testar Exemplo com GPS",
      sampleHint: "Testar visualizador com foto de exemplo contendo GPS e EXIF",
      formatsNote: "Suporta fotos (JPG, PNG, HEIC, WebP, TIFF), documentos (PDF, DOCX, XLSX, PPTX) e mídias (MP4, MP3)",
      loadingText: "Lendo metadados localmente no navegador...",
      loadingSub: "Nenhum dado sai do seu dispositivo.",
      filesLoadedPlural: "arquivos carregados",
      filesLoadedSingular: "arquivo carregado",
      addMore: "+ Adicionar Mais",
      clearAll: "Limpar Tudo",
      cleanBtnText: "Limpar Metadados Deste Arquivo Agora",
      cleaningBtnText: "Limpando metadados...",
      cleanedBtnText: "✓ Limpo & Baixado",
      reDownloadBtnText: "Baixar Novamente Arquivo Limpo",
      cleanFormatLabel: "Formato",
      cleanFormatTooltip: "Escolha o formato do arquivo limpo",
      cleanFormatOriginal: "Original (Padrão)",
      cleanFormatAll: "Todos os formatos (.zip)",
      copyJson: "Copiar JSON",
      copiedJson: "✓ JSON Copiado!",
      exportReport: "Exportar Relatório",
      tabGeneral: "📌 Visão Geral",
      tabCamera: "📷 Câmera & EXIF",
      tabGps: "🗺️ Localização & GPS",
      tabDoc: "📄 Documento & Autoria",
      tabMedia: "🎵 Áudio / Vídeo",
      tabRaw: "🔍 Todos os Dados",
      headerProperty: "Propriedade / Tag de Metadados",
      headerValue: "Valor Detectado",
      headerAction: "Copiar",
      clearFilter: "Limpar filtro",
      cameraSectionTitle: "Dados de Fotografia e Dispositivo (EXIF / IPTC)",
      cameraSectionSub: "Parâmetros ópticos, data original e especificações da câmera usadas no registro.",
      gpsAlertTitle: "Coordenadas de Satélite Encontradas!",
      gpsAlertDesc: "Esta foto contém os dados exatos de latitude e longitude de onde foi tirada. Qualquer pessoa que receber esta imagem pode ver seu endereço ou trajeto.",
      coordLat: "Latitude",
      coordLon: "Longitude",
      coordAlt: "Altitude",
      coordAltSub: "Acima do nível do mar",
      openGoogleMaps: "📍 Abrir no Google Maps ↗",
      openOsm: "🗺️ Abrir no OpenStreetMap ↗",
      copyCoords: "📋 Copiar Coordenadas",
      copiedCoords: "✓ Coordenadas Copiadas!",
      mapTitle: "Visualização do Local no Mapa",
      mapTag: "OpenStreetMap (Zero Rastreamento)",
      docSectionTitle: "Propriedades e Metadados do Documento",
      docSectionSub: "Informações de autoria corporativa, software gerador, histórico de edição e revisões.",
      mediaSectionTitle: "Tags e Informações do Arquivo de Mídia",
      mediaSectionSub: "Tags ID3, artista, álbum, duração e codificador de mídia.",
      searchPlaceholder: "Filtrar por nome de tag ou valor (ex: Model, Date, GPS, Creator)...",
      tagsFound: "tags encontradas",
      emptyFilter: "Nenhuma tag corresponde à busca",
      emptyCategory: "Nenhum metadado encontrado nesta categoria.",
      reportTitle: "RELATÓRIO DE METADADOS - REMOVER-METADADOS.COM",
      reportFile: "Arquivo",
      reportSize: "Tamanho",
      reportFormat: "Formato",
      reportDate: "Data de Análise",
      reportRisk: "[AVALIAÇÃO DE RISCO DE PRIVACIDADE]",
      reportGps: "[LOCALIZAÇÃO GPS]",
      reportGeneral: "[DADOS GERAIS]",
      reportCamera: "[CÂMERA E EXIF]",
      reportDoc: "[PROPRIEDADES DO DOCUMENTO]",
      sampleFileName: "foto-exemplo-sao-paulo.jpg",
      globalDropTitle: "Solte seus arquivos em qualquer lugar para inspecionar",
      globalDropSubtitle: "Solte em qualquer parte da tela para ver EXIF, GPS e dados ocultos",
      globalDropFormatsHint: "Fotos, Imagens, PDFs, Documentos, Vídeos e Áudio · 100% no seu navegador",
    };
---

<div
  class="metadata-viewer-tool"
  id="metadata-viewer-tool"
  data-i18n={JSON.stringify(t)}
  data-lang={isEn ? "en" : "pt-BR"}
>

  <!-- ── Drop Zone / Upload Area ───────────────────────────── -->
  <div class="viewer-drop-card" id="viewer-drop-zone">
    <input
      type="file"
      id="viewer-file-input"
      multiple
      accept="image/*,.pdf,.docx,.xlsx,.pptx,.odt,.ods,.odp,.mp3,.mp4,.m4v,.mov,.svg,.heic,.heif,.tif,.tiff"
      style="display:none;"
      aria-hidden="true"
    />

    <!-- Moving dashed animated SVG border -->
    <svg class="drop-border-svg" aria-hidden="true">
      <rect class="marching-rect" />
    </svg>

    <div class="viewer-drop-content">
      <!-- Badge de Privacidade -->
      <div class="drop-privacy-pill">
        <span class="live-dot" aria-hidden="true"></span>
        <span>{t.privacyBadge}</span>
      </div>

      <div class="drop-icon-wrapper" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <path d="M11 8v6"/>
          <path d="M8 11h6"/>
        </svg>
      </div>

      <h2 class="drop-title">{t.dropTitle}</h2>
      <p class="drop-desc">
        {t.dropDesc}
      </p>

      <div class="drop-actions-row">
        <button id="viewer-browse-btn" class="btn-accent viewer-browse-btn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
            <polyline points="13 2 13 9 20 9"/>
          </svg>
          {t.browseBtn}
        </button>

        <button id="viewer-sample-btn" class="btn-ghost viewer-sample-btn" type="button" title={t.sampleHint}>
          <span>{t.sampleBtn}</span>
        </button>
      </div>

      <p class="drop-formats-note">
        {t.formatsNote}
      </p>
    </div>
  </div>

  <!-- ── Loading Spinner State ─────────────────────────────── -->
  <div id="viewer-loading" class="viewer-loading-state" style="display:none;" aria-live="polite">
    <div class="spinner-box">
      <div class="neo-spinner" aria-hidden="true"></div>
      <p class="spinner-text">{t.loadingText}</p>
      <span class="spinner-sub">{t.loadingSub}</span>
    </div>
  </div>

  <!-- ── Multi-file Selector Strip (when multiple files added) ─ -->
  <div id="viewer-files-strip" class="viewer-files-strip" style="display:none;">
    <div class="files-strip-header">
      <div class="files-strip-title">
        <span class="files-icon" aria-hidden="true">📁</span>
        <span id="files-strip-count">1 {t.filesLoadedSingular}</span>
      </div>
      <div class="files-strip-actions">
        <button id="viewer-add-more-btn" class="btn-subtle" type="button">
          {t.addMore}
        </button>
        <button id="viewer-clear-all-btn" class="btn-subtle btn-danger-subtle" type="button">
          {t.clearAll}
        </button>
      </div>
    </div>
    <div id="viewer-files-list" class="viewer-files-scroll">
      <!-- File cards rendered dynamically -->
    </div>
  </div>

  <!-- ── Active File Inspection Result View ────────────────── -->
  <div id="viewer-results" class="viewer-results-container" style="display:none;">

    <!-- Top Card: File Summary & Privacy Health Rating -->
    <div class="viewer-summary-card">
      <div class="summary-card-inner">

        <!-- File Info & Thumbnail -->
        <div class="summary-file-block">
          <div class="file-thumb-container" id="file-thumb-box">
            <img id="file-thumb-img" class="file-thumb-img" src="" alt="File preview" style="display:none;" />
            <div id="file-thumb-icon" class="file-thumb-icon">📄</div>
          </div>

          <div class="file-meta-headings">
            <div class="file-name-row">
              <h3 id="res-file-name" class="res-file-name">foto.jpg</h3>
              <span id="res-file-ext-badge" class="badge-ext">JPG</span>
            </div>
            <div class="file-specs-chips">
              <span id="res-file-size" class="spec-chip">2.4 MB</span>
              <span id="res-file-dims" class="spec-chip" style="display:none;">4032 × 3024 px</span>
              <span id="res-file-date" class="spec-chip">Today</span>
            </div>
          </div>
        </div>

        <!-- Privacy Risk Assessment Alert Box -->
        <div id="privacy-risk-box" class="privacy-risk-box risk-danger">
          <div class="risk-header">
            <span id="risk-status-icon" class="risk-status-icon" aria-hidden="true">⚠️</span>
            <div class="risk-text-group">
              <h4 id="risk-status-title" class="risk-title">High Privacy Risk Detected</h4>
              <p id="risk-status-desc" class="risk-desc">
                This file exposes exact GPS coordinates and device identifiers.
              </p>
            </div>
          </div>
          <div id="risk-findings-list" class="risk-findings-list">
            <!-- Rendered list of findings -->
          </div>
        </div>

      </div>

      <!-- Quick Actions Toolbar -->
      <div class="summary-actions-toolbar">
        <div class="actions-left-group" style="display:flex;align-items:center;gap:0.65rem;flex-wrap:wrap;">
          <!-- Quick Clean CTA Button -->
          <button id="quick-clean-btn" class="btn-accent quick-clean-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span id="quick-clean-text">{t.cleanBtnText}</span>
          </button>

          <!-- Format selector -->
          <div id="viewer-format-wrap" class="viewer-format-selector" title={t.cleanFormatTooltip}>
            <label for="viewer-format-select" class="viewer-format-label">
              <span>{t.cleanFormatLabel}:</span>
            </label>
            <select id="viewer-format-select" class="neo-viewer-select" aria-label={t.cleanFormatLabel}>
              <option value="original">{t.cleanFormatOriginal}</option>
              <option value="jpg">JPG (.jpg)</option>
              <option value="png">PNG (.png)</option>
              <option value="webp">WebP (.webp)</option>
              <option value="avif">AVIF (.avif)</option>
              <option value="all">{t.cleanFormatAll}</option>
            </select>
          </div>
        </div>

        <div class="actions-right-group">
          <button id="copy-json-btn" class="btn-secondary" type="button" title="Copy all metadata in JSON format">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span id="copy-json-label">{t.copyJson}</span>
          </button>

          <button id="export-report-btn" class="btn-secondary" type="button" title="Export metadata report (.txt)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>{t.exportReport}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ── Tab Navigation ──────────────────────────────────── -->
    <div class="viewer-tabs-bar" role="tablist" aria-label="Metadata tabs">
      <button id="tab-btn-raw" class="viewer-tab-btn active" role="tab" aria-selected="true" data-tab="tab-raw">
        <span>{t.tabRaw}</span>
        <span id="badge-raw-count" class="tab-badge" style="display:none;">0</span>
      </button>

      <button id="tab-btn-general" class="viewer-tab-btn" role="tab" aria-selected="false" data-tab="tab-general">
        <span>{t.tabGeneral}</span>
      </button>

      <button id="tab-btn-camera" class="viewer-tab-btn" role="tab" aria-selected="false" data-tab="tab-camera" style="display:none;">
        <span>{t.tabCamera}</span>
        <span id="badge-camera-count" class="tab-badge">0</span>
      </button>

      <button id="tab-btn-gps" class="viewer-tab-btn tab-gps-highlight" role="tab" aria-selected="false" data-tab="tab-gps" style="display:none;">
        <span class="gps-pulse-dot" aria-hidden="true"></span>
        <span>{t.tabGps}</span>
      </button>

      <button id="tab-btn-doc" class="viewer-tab-btn" role="tab" aria-selected="false" data-tab="tab-doc" style="display:none;">
        <span>{t.tabDoc}</span>
      </button>

      <button id="tab-btn-media" class="viewer-tab-btn" role="tab" aria-selected="false" data-tab="tab-media" style="display:none;">
        <span>{t.tabMedia}</span>
      </button>
    </div>

    <!-- ── Tab Panels ──────────────────────────────────────── -->
    <div class="viewer-tab-panels">

      <!-- 1. Panel: All Data (Raw Tags) — ACTIVE BY DEFAULT -->
      <div id="tab-raw" class="viewer-tab-panel active" role="tabpanel">
        <div class="raw-search-toolbar">
          <div class="raw-search-input-wrapper">
            <span class="search-icon" aria-hidden="true">🔎</span>
            <input
              type="text"
              id="raw-search-input"
              class="raw-search-input"
              placeholder={t.searchPlaceholder}
              aria-label="Filter raw tags"
            />
            <button id="raw-search-clear-btn" class="raw-search-clear-btn" type="button" style="display:none;" aria-label={t.clearFilter} title={t.clearFilter}>✕</button>
          </div>
          <div class="raw-toolbar-stats">
            <span id="raw-count-label" class="raw-count-label">0 {t.tagsFound}</span>
          </div>
        </div>

        <div id="raw-tags-container" class="raw-tags-container">
          <div class="raw-table-header" aria-hidden="true">
            <span class="raw-th-key">{t.headerProperty}</span>
            <span class="raw-th-val">{t.headerValue}</span>
            <span class="raw-th-act">{t.headerAction}</span>
          </div>
          <div id="raw-tags-list" class="raw-tags-list">
            <!-- Key-value table rendered dynamically -->
          </div>
        </div>
      </div>

      <!-- 2. Panel: Overview / Geral -->
      <div id="tab-general" class="viewer-tab-panel" role="tabpanel">
        <div class="meta-cards-grid" id="grid-general">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- 3. Panel: Camera & EXIF -->
      <div id="tab-camera" class="viewer-tab-panel" role="tabpanel">
        <div class="meta-section-header">
          <h4 class="section-title">{t.cameraSectionTitle}</h4>
          <p class="section-sub">{t.cameraSectionSub}</p>
        </div>
        <div class="meta-cards-grid" id="grid-camera">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- 4. Panel: Location & GPS -->
      <div id="tab-gps" class="viewer-tab-panel" role="tabpanel">
        <div class="gps-panel-content">
          <!-- GPS Alert Notice -->
          <div class="gps-warning-alert">
            <div class="gps-warning-icon" aria-hidden="true">📍</div>
            <div class="gps-warning-text">
              <h4 class="gps-warning-title">{t.gpsAlertTitle}</h4>
              <p class="gps-warning-desc">
                {t.gpsAlertDesc}
              </p>
            </div>
          </div>

          <!-- GPS Coordinates Grid & Action Buttons -->
          <div class="gps-coords-container">
            <div class="gps-coords-grid">
              <div class="coord-box">
                <span class="coord-label">{t.coordLat}</span>
                <span id="gps-lat-val" class="coord-val">—</span>
                <span id="gps-lat-dms" class="coord-dms">—</span>
              </div>
              <div class="coord-box">
                <span class="coord-label">{t.coordLon}</span>
                <span id="gps-lon-val" class="coord-val">—</span>
                <span id="gps-lon-dms" class="coord-dms">—</span>
              </div>
              <div class="coord-box">
                <span class="coord-label">{t.coordAlt}</span>
                <span id="gps-alt-val" class="coord-val">—</span>
                <span class="coord-dms">{t.coordAltSub}</span>
              </div>
            </div>

            <!-- External Map Buttons -->
            <div class="gps-buttons-row">
              <a id="btn-open-gmaps" class="btn-main gps-ext-btn" href="#" target="_blank" rel="noopener noreferrer">
                <span>{t.openGoogleMaps}</span>
              </a>
              <a id="btn-open-osm" class="btn-secondary gps-ext-btn" href="#" target="_blank" rel="noopener noreferrer">
                <span>{t.openOsm}</span>
              </a>
              <button id="btn-copy-coords" class="btn-secondary gps-ext-btn" type="button">
                <span>{t.copyCoords}</span>
              </button>
            </div>
          </div>

          <!-- Embedded OpenStreetMap Map Frame -->
          <div class="gps-map-frame-box">
            <div class="map-frame-header">
              <span class="map-frame-title">{t.mapTitle}</span>
              <span class="map-frame-tag">{t.mapTag}</span>
            </div>
            <iframe
              id="gps-map-iframe"
              class="gps-map-iframe"
              title="Map showing coordinates from image"
              loading="lazy"
              src="about:blank"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- 5. Panel: Document & Author -->
      <div id="tab-doc" class="viewer-tab-panel" role="tabpanel">
        <div class="meta-section-header">
          <h4 class="section-title">{t.docSectionTitle}</h4>
          <p class="section-sub">{t.docSectionSub}</p>
        </div>
        <div class="meta-cards-grid" id="grid-doc">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- 6. Panel: Media (Audio / Video) -->
      <div id="tab-media" class="viewer-tab-panel" role="tabpanel">
        <div class="meta-section-header">
          <h4 class="section-title">{t.mediaSectionTitle}</h4>
          <p class="section-sub">{t.mediaSectionSub}</p>
        </div>
        <div class="meta-cards-grid" id="grid-media">
          <!-- Rendered dynamically -->
        </div>
      </div>

    </div>

  </div>

  <!-- Global Fullscreen Drop Overlay for Viewer -->
  <div id="viewer-global-drop-overlay" class="global-drop-overlay" aria-hidden="true" style="display:none;">
    <div class="global-drop-backdrop"></div>
    <div class="global-drop-modal">
      <div class="global-drop-badge">
        <span class="live-dot" aria-hidden="true"></span>
        <span>{t.privacyBadge}</span>
      </div>
      <div class="global-drop-icon-box" aria-hidden="true">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          <path d="M11 8v6"/>
          <path d="M8 11h6"/>
        </svg>
      </div>
      <h2 class="global-drop-title">{t.globalDropTitle}</h2>
      <p class="global-drop-sub">{t.globalDropSubtitle}</p>
      <div class="global-drop-formats">
        <span>{t.globalDropFormatsHint}</span>
      </div>
    </div>
  </div>

</div>

<!-- ── Neo-Brutalist Component Styles ─────────────────────── -->
<style is:global>
  .metadata-viewer-tool {
    width: 100%;
    margin: 0 auto;
    font-family: var(--font-sans);
    text-align: left;
  }

  /* ── Drop Card ─────────────────────────────────────────── */
  .viewer-drop-card {
    position: relative;
    background: var(--card-bg);
    border: 2.5px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
    text-align: center;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    user-select: none;
    outline: none;
  }

  .viewer-drop-card:hover,
  .viewer-drop-card.drag-over {
    transform: translate(-2px, -2px);
    box-shadow: var(--neo-shadow-lg);
  }

  .drop-border-svg {
    position: absolute;
    inset: 6px;
    width: calc(100% - 12px);
    height: calc(100% - 12px);
    pointer-events: none;
    overflow: visible;
  }

  .marching-rect {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
    animation: march 22s linear infinite;
  }

  @keyframes march {
    to { stroke-dashoffset: -200; }
  }

  .viewer-drop-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .drop-privacy-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    background: var(--badge-bg);
    color: var(--text);
    border: 1.5px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    margin-bottom: 1.5rem;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
    display: inline-block;
  }

  .drop-icon-wrapper {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 3px 3px 0px var(--shadow-color);
    margin-bottom: 1.25rem;
  }

  .drop-title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 3.2vw, 1.65rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .drop-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    max-width: 500px;
  }

  .drop-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .viewer-browse-btn {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.75rem 1.4rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .viewer-browse-btn:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .viewer-sample-btn {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.75rem 1.25rem;
    background: var(--card-bg);
    color: var(--text);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .viewer-sample-btn:hover {
    background: var(--badge-bg);
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .drop-formats-note {
    font-size: 0.75rem;
    color: var(--text-faint);
    max-width: 580px;
  }

  /* ── Loading Spinner ────────────────────────────────────── */
  .viewer-loading-state {
    padding: 3rem 1rem;
    text-align: center;
  }

  .spinner-box {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: 2rem 2.5rem;
  }

  .neo-spinner {
    width: 36px;
    height: 36px;
    border: 3.5px solid var(--border-light);
    border-top-color: var(--text);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 1rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .spinner-text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .spinner-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* ── Multi-file Selector Strip ──────────────────────────── */
  .viewer-files-strip {
    margin-top: 1.5rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    padding: 1rem;
  }

  .files-strip-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .files-strip-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .files-strip-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-subtle {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
    background: var(--card-bg);
    color: var(--text);
    border: 1.5px solid var(--border);
    cursor: pointer;
  }

  .btn-subtle:hover {
    background: var(--badge-bg);
  }

  .btn-danger-subtle:hover {
    background: #fee2e2;
    color: #b91c1c;
  }

  .viewer-files-scroll {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: thin;
  }

  /* ── Results Container & Summary ────────────────────────── */
  .viewer-results-container {
    margin-top: 2rem;
  }

  .viewer-summary-card {
    background: var(--card-bg);
    border: 2.5px solid var(--border);
    box-shadow: var(--neo-shadow);
    margin-bottom: 2rem;
  }

  .summary-card-inner {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .summary-card-inner {
      grid-template-columns: 1.1fr 1.3fr;
      align-items: start;
    }
  }

  .summary-file-block {
    display: flex;
    gap: 1.15rem;
    align-items: center;
  }

  .file-thumb-container {
    width: 74px;
    height: 74px;
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    background: var(--badge-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .file-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .file-thumb-icon {
    font-size: 2rem;
  }

  .file-meta-headings {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .file-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .res-file-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    word-break: break-all;
  }

  .badge-ext {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 1.5px solid var(--border);
    box-shadow: 1.5px 1.5px 0px var(--shadow-color);
  }

  .file-specs-chips {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .spec-chip {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    background: var(--badge-bg);
    border: 1px solid var(--border-light);
    padding: 0.15rem 0.45rem;
  }

  /* ── Privacy Risk Box ──────────────────────────────────── */
  .privacy-risk-box {
    border: 2px solid var(--border);
    box-shadow: 2.5px 2.5px 0px var(--shadow-color);
    padding: 1rem 1.25rem;
  }

  .privacy-risk-box.risk-danger {
    background: #fef2f2;
    border-color: #dc2626;
  }

  html.dark .privacy-risk-box.risk-danger {
    background: #450a0a;
    border-color: #ef4444;
  }

  .privacy-risk-box.risk-warning {
    background: #fffbeb;
    border-color: #d97706;
  }

  html.dark .privacy-risk-box.risk-warning {
    background: #451a03;
    border-color: #f59e0b;
  }

  .privacy-risk-box.risk-clean {
    background: #f0fdf4;
    border-color: #16a34a;
  }

  html.dark .privacy-risk-box.risk-clean {
    background: #052e16;
    border-color: #22c55e;
  }

  .risk-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }

  .risk-status-icon {
    font-size: 1.4rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .risk-title {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.2rem 0;
  }

  .risk-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  .risk-findings-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(0, 0, 0, 0.15);
  }

  html.dark .risk-findings-list {
    border-top-color: rgba(255, 255, 255, 0.2);
  }

  .finding-item {
    color: var(--text);
  }

  /* ── Actions Toolbar ────────────────────────────────────── */
  .summary-actions-toolbar {
    background: var(--bg);
    border-top: 2px solid var(--border);
    padding: 0.85rem clamp(1rem, 2.5vw, 1.75rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .quick-clean-btn {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.65rem 1.25rem;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .quick-clean-btn:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }

  .quick-clean-btn.done-state {
    background: #16a34a;
    color: #ffffff;
    border-color: var(--border);
  }

  .viewer-format-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    padding: 0 0.65rem;
    height: 40px;
    border-radius: 3px;
    box-sizing: border-box;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .viewer-format-selector:hover {
    transform: translate(-1.5px, -1.5px);
    box-shadow: var(--neo-shadow);
  }
  .viewer-format-label {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }
  .neo-viewer-select {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text);
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    padding: 0.15rem 0.2rem 0.15rem 0;
  }
  .neo-viewer-select option {
    background: var(--card-bg);
    color: var(--text);
    font-family: var(--font-mono);
  }

  .actions-right-group {
    display: flex;
    gap: 0.5rem;
  }

  .btn-secondary {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.65rem 0.95rem;
    background: var(--card-bg);
    color: var(--text);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.1s ease;
  }

  .btn-secondary:hover {
    background: var(--badge-bg);
    transform: translate(-1.5px, -1.5px);
  }

  /* ── Tabs Bar ───────────────────────────────────────────── */
  .viewer-tabs-bar {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    border-bottom: 2px solid var(--border);
    padding-bottom: 2px;
    margin-bottom: 1.5rem;
    scrollbar-width: thin;
  }

  .viewer-tab-btn {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.75rem 1.15rem;
    background: var(--card-bg);
    color: var(--text-muted);
    border: 2px solid var(--border);
    border-bottom: none;
    box-shadow: 2px -2px 0px transparent;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .viewer-tab-btn:hover {
    color: var(--text);
    background: var(--badge-bg);
  }

  .viewer-tab-btn.active {
    background: var(--bg);
    color: var(--text);
    border-bottom: 2px solid var(--bg);
    margin-bottom: -2px;
    box-shadow: 3px -3px 0px var(--shadow-color);
  }

  .tab-badge {
    font-size: 0.68rem;
    padding: 0.1rem 0.4rem;
    background: var(--badge-bg);
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  .tab-gps-highlight {
    position: relative;
  }

  .gps-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.4);
    animation: gpsPulse 1.8s infinite;
  }

  @keyframes gpsPulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }

  /* ── Tab Panels ─────────────────────────────────────────── */
  .viewer-tab-panel {
    display: none;
  }

  .viewer-tab-panel.active {
    display: block;
    animation: fadeIn 0.2s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .meta-section-header {
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .section-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Metadata Cards Grid ────────────────────────────────── */
  .meta-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }

  .meta-item-card {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    padding: 0.95rem 1.1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .meta-item-key {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .meta-item-val {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    word-break: break-word;
  }

  /* ── GPS Panel Styling ──────────────────────────────────── */
  .gps-warning-alert {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: #fef2f2;
    border: 2px solid #dc2626;
    box-shadow: var(--neo-shadow-sm);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  html.dark .gps-warning-alert {
    background: #450a0a;
    border-color: #ef4444;
  }

  .gps-warning-icon {
    font-size: 1.8rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .gps-warning-title {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: #b91c1c;
    margin: 0 0 0.25rem 0;
  }

  html.dark .gps-warning-title {
    color: #fca5a5;
  }

  .gps-warning-desc {
    font-size: 0.85rem;
    color: var(--text);
    margin: 0;
    line-height: 1.45;
  }

  .gps-coords-container {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    padding: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .gps-coords-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .coord-box {
    background: var(--bg);
    border: 1.5px solid var(--border);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
  }

  .coord-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .coord-val {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.15rem;
  }

  .coord-dms {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .gps-buttons-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-top: 1px dashed var(--border-light);
    padding-top: 1rem;
  }

  .gps-ext-btn {
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.65rem 1.15rem;
  }

  .btn-main {
    background: var(--btn-bg);
    color: var(--btn-text);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: transform 0.1s ease;
  }

  .btn-main:hover {
    transform: translate(-1.5px, -1.5px);
  }

  .gps-map-frame-box {
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    overflow: hidden;
  }

  .map-frame-header {
    background: var(--bg);
    border-bottom: 2px solid var(--border);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .map-frame-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text);
  }

  .map-frame-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .gps-map-iframe {
    width: 100%;
    height: 340px;
    border: none;
    display: block;
    background: #e5e7eb;
  }

  /* ── Raw Tags Panel (Spacious & Unsqueezed) ──────────────── */
  .raw-search-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .raw-search-input-wrapper {
    position: relative;
    flex: 1;
    min-width: 280px;
  }

  .search-icon {
    position: absolute;
    left: 0.95rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.95rem;
    color: var(--text-muted);
    pointer-events: none;
  }

  .raw-search-input {
    width: 100%;
