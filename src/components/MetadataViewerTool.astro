</style>

<!-- ── Client Script for Metadata Viewer ──────────────────── -->
<script type="module">
  import { inspectFileMetadata, toDms, formatBytes } from '/src/scripts/metadataViewer.js';
  import { removeMetadata, downloadBlob, isImageFile } from '/src/scripts/metadataRemover.js';

  const toolContainer  = document.getElementById('metadata-viewer-tool');
  const t              = JSON.parse(toolContainer?.dataset?.i18n || '{}');
  const currentLang    = toolContainer?.dataset?.lang || 'pt-BR';

  // DOM elements
  const dropZone       = document.getElementById('viewer-drop-zone');
  const fileInput      = document.getElementById('viewer-file-input');
  const browseBtn      = document.getElementById('viewer-browse-btn');
  const sampleBtn      = document.getElementById('viewer-sample-btn');
  const loadingState   = document.getElementById('viewer-loading');
  const filesStrip     = document.getElementById('viewer-files-strip');
  const filesStripCount= document.getElementById('files-strip-count');
  const filesListEl    = document.getElementById('viewer-files-list');
  const addMoreBtn     = document.getElementById('viewer-add-more-btn');
  const clearAllBtn    = document.getElementById('viewer-clear-all-btn');

  const resultsView    = document.getElementById('viewer-results');
  const resFileName    = document.getElementById('res-file-name');
  const resFileExtBadge= document.getElementById('res-file-ext-badge');
  const resFileSize    = document.getElementById('res-file-size');
  const resFileDims    = document.getElementById('res-file-dims');
  const resFileDate    = document.getElementById('res-file-date');
  const fileThumbImg   = document.getElementById('file-thumb-img');
  const fileThumbIcon  = document.getElementById('file-thumb-icon');

  const riskBox        = document.getElementById('privacy-risk-box');
  const riskTitle      = document.getElementById('risk-status-title');
  const riskDesc       = document.getElementById('risk-status-desc');
  const riskIcon       = document.getElementById('risk-status-icon');
  const riskFindings   = document.getElementById('risk-findings-list');

  const quickCleanBtn  = document.getElementById('quick-clean-btn');
  const quickCleanText = document.getElementById('quick-clean-text');
  const copyJsonBtn    = document.getElementById('copy-json-btn');
  const copyJsonLabel  = document.getElementById('copy-json-label');
  const exportReportBtn= document.getElementById('export-report-btn');

  // Tab elements
  const tabBtns        = document.querySelectorAll('.viewer-tab-btn');
  const tabPanels      = document.querySelectorAll('.viewer-tab-panel');
  const tabBtnCamera   = document.getElementById('tab-btn-camera');
  const badgeCamCount  = document.getElementById('badge-camera-count');
  const tabBtnGps      = document.getElementById('tab-btn-gps');
  const tabBtnDoc      = document.getElementById('tab-btn-doc');
  const tabBtnMedia    = document.getElementById('tab-btn-media');

  const gridGeneral    = document.getElementById('grid-general');
  const gridCamera     = document.getElementById('grid-camera');
  const gridDoc        = document.getElementById('grid-doc');
  const gridMedia      = document.getElementById('grid-media');

  // GPS elements
  const gpsLatVal      = document.getElementById('gps-lat-val');
  const gpsLatDms      = document.getElementById('gps-lat-dms');
  const gpsLonVal      = document.getElementById('gps-lon-val');
  const gpsLonDms      = document.getElementById('gps-lon-dms');
  const gpsAltVal      = document.getElementById('gps-alt-val');
  const btnOpenGmaps   = document.getElementById('btn-open-gmaps');
  const btnOpenOsm     = document.getElementById('btn-open-osm');
  const btnCopyCoords  = document.getElementById('btn-copy-coords');
  const gpsMapIframe   = document.getElementById('gps-map-iframe');

  // Raw search elements
  const rawSearchInput = document.getElementById('raw-search-input');
  const rawSearchClear = document.getElementById('raw-search-clear-btn');
  const rawCountLabel  = document.getElementById('raw-count-label');
  const rawContainer   = document.getElementById('raw-tags-container');
  const rawTagsList    = document.getElementById('raw-tags-list');
  const badgeRawCount  = document.getElementById('badge-raw-count');

  /** @type {Array<{ file: File, result: any, thumbUrl?: string }>} */
  let loadedItems = [];
  let activeIndex = 0;

  // ── Drag & Drop listeners ─────────────────────────────────
  const viewerGlobalDropOverlay = document.getElementById('viewer-global-drop-overlay');
  let viewerDragCounter = 0;

  function showViewerDropOverlay(show) {
    if (!viewerGlobalDropOverlay) return;
    if (show) {
      viewerGlobalDropOverlay.style.display = 'flex';
      requestAnimationFrame(() => {
        viewerGlobalDropOverlay.classList.add('active');
      });
    } else {
      viewerGlobalDropOverlay.classList.remove('active');
      setTimeout(() => {
        if (!viewerGlobalDropOverlay.classList.contains('active')) {
          viewerGlobalDropOverlay.style.display = 'none';
        }
      }, 150);
    }
  }

  function isDragWithFiles(e) {
    if (!e.dataTransfer) return false;
    const types = e.dataTransfer.types;
    if (!types) return false;
    for (let i = 0; i < types.length; i++) {
      if (types[i] === 'Files') return true;
    }
    return false;
  }

  if (dropZone) {
    dropZone.addEventListener('click', (e) => {
      if (e.target.closest('#viewer-sample-btn')) return;
      fileInput?.click();
    });
  }

  // Window-level listeners so dropping anywhere on the screen works reliably
  window.addEventListener('dragenter', (e) => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    viewerDragCounter++;
    if (viewerDragCounter === 1) {
      showViewerDropOverlay(true);
      if (dropZone) dropZone.classList.add('drag-over');
    }
  });

  window.addEventListener('dragover', (e) => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    if (e.dataTransfer) {
      try { e.dataTransfer.dropEffect = 'copy'; } catch {}
    }
  });

  window.addEventListener('dragleave', (e) => {
    if (!isDragWithFiles(e)) return;
    e.preventDefault();
    if (e.clientX <= 0 || e.clientY <= 0 || e.clientX >= window.innerWidth || e.clientY >= window.innerHeight || !e.relatedTarget) {
      viewerDragCounter = 0;
      showViewerDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
      return;
    }
    viewerDragCounter--;
    if (viewerDragCounter <= 0) {
      viewerDragCounter = 0;
      showViewerDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
    }
  });

  window.addEventListener('drop', (e) => {
    e.preventDefault();
    e.stopPropagation();
    viewerDragCounter = 0;
    showViewerDropOverlay(false);
    if (dropZone) dropZone.classList.remove('drag-over');

    const files = Array.from(e.dataTransfer?.files || []);
    if (files.length > 0) {
      handleFiles(files);
    }
  });

  window.addEventListener('dragend', () => {
    viewerDragCounter = 0;
    showViewerDropOverlay(false);
    if (dropZone) dropZone.classList.remove('drag-over');
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      viewerDragCounter = 0;
      showViewerDropOverlay(false);
      if (dropZone) dropZone.classList.remove('drag-over');
    }
  });

  browseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  addMoreBtn?.addEventListener('click', () => {
    fileInput?.click();
  });

  clearAllBtn?.addEventListener('click', () => {
    loadedItems.forEach(item => {
      if (item.thumbUrl) URL.revokeObjectURL(item.thumbUrl);
    });
    loadedItems = [];
    activeIndex = 0;
    if (filesStrip) filesStrip.style.display = 'none';
    if (resultsView) resultsView.style.display = 'none';
    if (dropZone) dropZone.style.display = 'block';
  });

  fileInput?.addEventListener('change', (e) => {
    const files = Array.from(e.target.files || []);
    if (files.length > 0) handleFiles(files);
    fileInput.value = '';
  });

  // ── Sample Test Button ────────────────────────────────────
  sampleBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    try {
      showLoading(true);
      const res = await fetch('/sample-exif.jpg');
      if (!res.ok) throw new Error('Could not load sample image');
      const blob = await res.blob();
      const sampleFile = new File([blob], t.sampleFileName || 'sample-photo-sao-paulo.jpg', { type: 'image/jpeg' });
      await handleFiles([sampleFile]);
    } catch (err) {
      alert('Error loading sample: ' + err.message);
    } finally {
      showLoading(false);
    }
  });

  function showLoading(show) {
    if (loadingState) loadingState.style.display = show ? 'block' : 'none';
  }

  // ── Process incoming files ────────────────────────────────
  async function handleFiles(files) {
    showLoading(true);
    try {
      for (const file of files) {
        const inspection = await inspectFileMetadata(file, currentLang);

        let thumbUrl = '';
        if (inspection.isImage && !file.name.endsWith('.svg')) {
          try {
            thumbUrl = URL.createObjectURL(file);
          } catch {}
        }

        loadedItems.push({
          file,
          result: inspection,
          thumbUrl,
        });
      }

      activeIndex = loadedItems.length - files.length;
      if (activeIndex < 0) activeIndex = 0;

      renderFilesStrip();
      renderActiveItem();

      resultsView?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      console.error('File inspection error:', err);
      alert('Error inspecting file: ' + err.message);
    } finally {
      showLoading(false);
    }
  }

  // ── Render Files Strip ────────────────────────────────────
  function renderFilesStrip() {
    if (!filesStrip || !filesListEl) return;
    if (loadedItems.length <= 1) {
      filesStrip.style.display = 'none';
      return;
    }

    filesStrip.style.display = 'block';
    if (filesStripCount) {
      const suffix = loadedItems.length === 1 ? t.filesLoadedSingular : t.filesLoadedPlural;
      filesStripCount.textContent = `${loadedItems.length} ${suffix}`;
    }

    filesListEl.innerHTML = '';
    loadedItems.forEach((item, idx) => {
      const pill = document.createElement('div');
      pill.className = `file-pill ${idx === activeIndex ? 'active' : ''}`;

      const icon = item.result.isImage ? '📷' : (item.result.isPdf ? '📄' : '📁');
      const tagText = item.result.gps ? '📍 GPS' : item.result.assessment.level.toUpperCase();

      pill.innerHTML = `
        <span aria-hidden="true">${icon}</span>
        <span class="file-pill-name" title="${item.file.name}">${item.file.name}</span>
        <span class="file-pill-tag">${tagText}</span>
      `;

      pill.addEventListener('click', () => {
        activeIndex = idx;
        renderFilesStrip();
        renderActiveItem();
      });

      filesListEl.appendChild(pill);
    });
  }

  // ── Render Active Item ────────────────────────────────────
  function renderActiveItem() {
    const item = loadedItems[activeIndex];
    if (!item) return;

    const res = item.result;
    if (resultsView) resultsView.style.display = 'block';

    // File info
    if (resFileName) resFileName.textContent = item.file.name;
    if (resFileExtBadge) resFileExtBadge.textContent = res.ext.toUpperCase();
    if (resFileSize) resFileSize.textContent = formatBytes(item.file.size, currentLang);
    if (resFileDate) resFileDate.textContent = res.general[currentLang === 'en' ? 'Last Modified' : 'Última Modificação'] || '—';

    const viewerFormatWrap = document.getElementById('viewer-format-wrap');
    if (viewerFormatWrap) {
      viewerFormatWrap.style.display = isImageFile(item.file.name) ? 'inline-flex' : 'none';
    }

    if (resFileDims) {
      const dims = res.general[currentLang === 'en' ? 'Dimensions' : 'Dimensões'];
      if (dims) {
        resFileDims.textContent = dims;
        resFileDims.style.display = 'inline-block';
      } else {
        resFileDims.style.display = 'none';
      }
    }

    // Thumbnail
    if (item.thumbUrl) {
      if (fileThumbImg) {
        fileThumbImg.src = item.thumbUrl;
        fileThumbImg.style.display = 'block';
      }
      if (fileThumbIcon) fileThumbIcon.style.display = 'none';
    } else {
      if (fileThumbImg) fileThumbImg.style.display = 'none';
      if (fileThumbIcon) {
        fileThumbIcon.style.display = 'block';
        fileThumbIcon.textContent = res.isImage ? '🖼️' : (res.isPdf ? '📄' : (res.isOffice ? '📑' : (res.isAudio ? '🎵' : '📹')));
      }
    }

    // Privacy Risk Assessment
    if (riskBox) {
      riskBox.className = `privacy-risk-box risk-${res.assessment.level}`;
    }
    if (riskTitle) riskTitle.textContent = res.assessment.title;
    if (riskDesc) riskDesc.textContent = res.assessment.description;
    if (riskIcon) {
      riskIcon.textContent = res.assessment.level === 'danger' ? '🚨' : (res.assessment.level === 'warning' ? '⚠️' : '✅');
    }

    if (riskFindings) {
      if (res.assessment.findings && res.assessment.findings.length > 0) {
        riskFindings.style.display = 'flex';
        riskFindings.innerHTML = res.assessment.findings
          .map(f => `<div class="finding-item">• ${f}</div>`)
          .join('');
      } else {
        riskFindings.style.display = 'none';
        riskFindings.innerHTML = '';
      }
    }

    // Reset Clean Button state
    if (quickCleanBtn && quickCleanText) {
      quickCleanBtn.classList.remove('done-state');
      quickCleanBtn.disabled = false;
      quickCleanText.textContent = t.cleanBtnText;
    }

    // Render Tab Buttons Visibility
    const hasCamera = Object.keys(res.camera).length > 0;
    const hasGps = !!res.gps;
    const hasDoc = Object.keys(res.documentInfo).length > 0;
    const hasMedia = Object.keys(res.mediaInfo).length > 0;

    if (tabBtnCamera) {
      tabBtnCamera.style.display = hasCamera ? 'inline-flex' : 'none';
      if (badgeCamCount) badgeCamCount.textContent = String(Object.keys(res.camera).length);
    }
    if (tabBtnGps) {
      tabBtnGps.style.display = hasGps ? 'inline-flex' : 'none';
    }
    if (tabBtnDoc) {
      tabBtnDoc.style.display = hasDoc ? 'inline-flex' : 'none';
    }
    if (tabBtnMedia) {
      tabBtnMedia.style.display = hasMedia ? 'inline-flex' : 'none';
    }

    // Show All Data by default
    switchTab('tab-raw');

    const totalRawCount = Object.keys(res.rawTags || {}).length;
    if (badgeRawCount) {
      badgeRawCount.textContent = String(totalRawCount);
      badgeRawCount.style.display = 'inline-block';
    }

    // Populate Grids
    renderGrid(gridGeneral, res.general);
    if (hasCamera) renderGrid(gridCamera, res.camera);
    if (hasDoc) renderGrid(gridDoc, res.documentInfo);
    if (hasMedia) renderGrid(gridMedia, res.mediaInfo);

    // Populate GPS
    if (hasGps && res.gps) {
      if (gpsLatVal) gpsLatVal.textContent = res.gps.latitude.toFixed(6);
      if (gpsLatDms) gpsLatDms.textContent = res.gps.dmsLat;
      if (gpsLonVal) gpsLonVal.textContent = res.gps.longitude.toFixed(6);
      if (gpsLonDms) gpsLonDms.textContent = res.gps.dmsLon;
      if (gpsAltVal) gpsAltVal.textContent = res.gps.altitude ? `${res.gps.altitude} m` : '—';

      if (btnOpenGmaps) btnOpenGmaps.href = res.gps.googleMapsUrl;
      if (btnOpenOsm) btnOpenOsm.href = res.gps.osmUrl;

      // Embed map
      if (gpsMapIframe) {
        const lat = res.gps.latitude;
        const lon = res.gps.longitude;
        const delta = 0.006;
        const bbox = `${lon - delta}%2C${lat - delta}%2C${lon + delta}%2C${lat + delta}`;
        gpsMapIframe.src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lon}`;
      }
    }

    // Populate Raw Tags Table
    renderRawTags(res.rawTags);
  }

  // ── Render Helper for Key-Value Grids ─────────────────────
  function renderGrid(container, obj) {
    if (!container) return;
    container.innerHTML = '';
    const entries = Object.entries(obj);
    if (entries.length === 0) {
      container.innerHTML = `<div class="raw-empty-state">${t.emptyCategory}</div>`;
      return;
    }
    entries.forEach(([key, val]) => {
      const card = document.createElement('div');
      card.className = 'meta-item-card';
      card.innerHTML = `
        <span class="meta-item-key">${key}</span>
        <span class="meta-item-val">${val}</span>
      `;
      container.appendChild(card);
    });
  }

  function formatTagValue(v) {
    if (v === null || v === undefined) {
      return { text: '—', copyVal: '' };
    }
    if (typeof v === 'boolean') {
      return { text: v ? 'true' : 'false', copyVal: String(v) };
    }
    if (Array.isArray(v)) {
      if (v.every(item => typeof item === 'string' || typeof item === 'number')) {
        const joined = v.join(', ');
        return { text: joined, copyVal: joined };
      }
      const json = JSON.stringify(v, null, 2);
      return { text: json, copyVal: json };
    }
    if (typeof v === 'object') {
      try {
        const json = JSON.stringify(v, null, 2);
        return { text: json, copyVal: json };
      } catch {
        return { text: String(v), copyVal: String(v) };
      }
    }
    const str = String(v);
    return { text: str, copyVal: str };
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ── Render Raw Tags with Live Search ──────────────────────
  let currentRawObj = {};
  function renderRawTags(rawObj) {
    currentRawObj = rawObj || {};
    filterRawTags('');
  }

  function filterRawTags(filterTerm) {
    const listEl = rawTagsList || rawContainer;
    if (!listEl) return;
    listEl.innerHTML = '';

    const term = (filterTerm || '').toLowerCase().trim();
    if (rawSearchClear) {
      rawSearchClear.style.display = term ? 'inline-flex' : 'none';
    }

    const entries = Object.entries(currentRawObj).filter(([k, v]) => {
      if (!term) return true;
      const kMatch = k.toLowerCase().includes(term);
      const vMatch = String(v).toLowerCase().includes(term);
      return kMatch || vMatch;
    });

    if (rawCountLabel) {
      rawCountLabel.textContent = `${entries.length} ${t.tagsFound}`;
    }

    if (entries.length === 0) {
      listEl.innerHTML = `<div class="raw-empty-state">${t.emptyFilter} "${escapeHtml(filterTerm)}".</div>`;
      return;
    }

    entries.forEach(([k, v]) => {
      const row = document.createElement('div');
      row.className = 'raw-tag-row';
      const formatted = formatTagValue(v);

      row.innerHTML = `
        <div class="raw-tag-key-col">
          <span class="raw-tag-key">${escapeHtml(k)}</span>
        </div>
        <div class="raw-tag-val-col">
          <span class="raw-tag-val">${escapeHtml(formatted.text)}</span>
        </div>
        <div class="raw-tag-act-col">
          <button class="raw-tag-copy" type="button" title="${currentLang === 'en' ? 'Copy value' : 'Copiar valor'}" aria-label="${currentLang === 'en' ? 'Copy tag value' : 'Copiar valor da tag'}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
        </div>
      `;

      const copyBtn = row.querySelector('.raw-tag-copy');
      copyBtn?.addEventListener('click', () => {
        navigator.clipboard.writeText(formatted.copyVal);
        copyBtn.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        `;
        copyBtn.classList.add('copied');
        setTimeout(() => {
          copyBtn.innerHTML = `
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          `;
          copyBtn.classList.remove('copied');
        }, 1500);
      });

      listEl.appendChild(row);
    });
  }

  rawSearchInput?.addEventListener('input', (e) => {
    filterRawTags(e.target.value);
  });

  rawSearchClear?.addEventListener('click', () => {
    if (rawSearchInput) rawSearchInput.value = '';
    filterRawTags('');
    rawSearchInput?.focus();
  });

  // ── Tab Switching Logic ───────────────────────────────────
  function switchTab(targetTabId) {
    tabBtns.forEach(btn => {
      const isActive = btn.dataset.tab === targetTabId;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    tabPanels.forEach(panel => {
      panel.classList.toggle('active', panel.id === targetTabId);
    });
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      switchTab(btn.dataset.tab);
    });
  });

  // ── Copy GPS Coords ───────────────────────────────────────
  btnCopyCoords?.addEventListener('click', () => {
    const item = loadedItems[activeIndex];
    if (item?.result?.gps) {
      const coords = `${item.result.gps.latitude.toFixed(6)}, ${item.result.gps.longitude.toFixed(6)}`;
      navigator.clipboard.writeText(coords);
      btnCopyCoords.querySelector('span').textContent = t.copiedCoords;
      setTimeout(() => {
        btnCopyCoords.querySelector('span').textContent = t.copyCoords;
      }, 2000);
    }
  });

  // ── Copy JSON ─────────────────────────────────────────────
  copyJsonBtn?.addEventListener('click', () => {
    const item = loadedItems[activeIndex];
    if (!item) return;
    const jsonStr = JSON.stringify(item.result.rawTags, null, 2);
    navigator.clipboard.writeText(jsonStr);
    if (copyJsonLabel) copyJsonLabel.textContent = t.copiedJson;
    setTimeout(() => {
      if (copyJsonLabel) copyJsonLabel.textContent = t.copyJson;
    }, 2000);
  });

  // ── Export Text Report ────────────────────────────────────
  exportReportBtn?.addEventListener('click', () => {
    const item = loadedItems[activeIndex];
    if (!item) return;

    const res = item.result;
    let report = `====================================================\n`;
    report += `${t.reportTitle}\n`;
    report += `====================================================\n\n`;
    report += `${t.reportFile}: ${item.file.name}\n`;
    report += `${t.reportSize}: ${formatBytes(item.file.size, currentLang)}\n`;
    report += `${t.reportFormat}: ${res.ext.toUpperCase()}\n`;
    report += `${t.reportDate}: ${new Date().toLocaleString(currentLang === 'en' ? 'en-US' : 'pt-BR')}\n\n`;

    report += `${t.reportRisk}\n`;
    report += `Status: ${res.assessment.title}\n`;
    report += `${res.assessment.description}\n`;
    if (res.assessment.findings?.length) {
      report += `Findings:\n`;
      res.assessment.findings.forEach(f => report += ` - ${f}\n`);
    }
    report += `\n`;

    if (res.gps) {
      report += `${t.reportGps}\n`;
      report += `Latitude: ${res.gps.latitude} (${res.gps.dmsLat})\n`;
      report += `Longitude: ${res.gps.longitude} (${res.gps.dmsLon})\n`;
      report += `Altitude: ${res.gps.altitude || 'N/A'}\n`;
      report += `Google Maps: ${res.gps.googleMapsUrl}\n\n`;
    }

    report += `${t.reportGeneral}\n`;
    Object.entries(res.general).forEach(([k, v]) => report += `${k}: ${v}\n`);
    report += `\n`;

    if (Object.keys(res.camera).length > 0) {
      report += `${t.reportCamera}\n`;
      Object.entries(res.camera).forEach(([k, v]) => report += `${k}: ${v}\n`);
      report += `\n`;
    }

    if (Object.keys(res.documentInfo).length > 0) {
      report += `${t.reportDoc}\n`;
      Object.entries(res.documentInfo).forEach(([k, v]) => report += `${k}: ${v}\n`);
      report += `\n`;
    }

    const blob = new Blob([report], { type: 'text/plain;charset=utf-8' });
    downloadBlob(blob, `metadata-report-${item.file.name}.txt`);
  });

  // ── Quick Clean Button Action ─────────────────────────────
  quickCleanBtn?.addEventListener('click', async () => {
    const item = loadedItems[activeIndex];
    if (!item) return;

    try {
      quickCleanBtn.disabled = true;
      if (quickCleanText) quickCleanText.textContent = t.cleaningBtnText;

      const formatSelect = document.getElementById('viewer-format-select');
      const chosenFormat = formatSelect?.value || 'original';

      const cleaned = await removeMetadata(item.file, () => {}, { format: chosenFormat });
      downloadBlob(cleaned.blob, cleaned.filename);

      if (quickCleanText) quickCleanText.textContent = `${t.cleanedBtnText} (${cleaned.filename})!`;
      quickCleanBtn.classList.add('done-state');

      setTimeout(() => {
        if (quickCleanText) quickCleanText.textContent = t.reDownloadBtnText;
        quickCleanBtn.disabled = false;
      }, 3500);
    } catch (err) {
      alert('Error cleaning metadata: ' + err.message);
      if (quickCleanText) quickCleanText.textContent = 'Error cleaning metadata';
      quickCleanBtn.disabled = false;
    }
  });
</script>
