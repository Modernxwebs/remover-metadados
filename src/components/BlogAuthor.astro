---
export interface Props {
  author?: string;
  role?: string;
  isEn?: boolean;
}

const {
  author = 'Dev Sharma',
  role = 'Especialista em Privacidade & Segurança Digital',
  isEn = false,
} = Astro.props;

const authorAboutUrl = isEn ? '/en/about/' : '/sobre/';
---

<div class="blog-author-card">
  <div class="author-avatar-badge" aria-hidden="true">
    <span>DS</span>
  </div>

  <div class="author-info">
    <div class="author-top-row">
      <span class="author-role-tag">{isEn ? 'Author & Privacy Engineer' : 'Autor & Especialista em Privacidade'}</span>
      <a href={authorAboutUrl} class="author-profile-link">
        {isEn ? 'View Profile →' : 'Ver Perfil →'}
      </a>
    </div>

    <h3 class="author-name">{author}</h3>

    <p class="author-bio">
      {isEn
        ? 'Creator of Metadata Remover and privacy advocate. Dev builds client-side, zero-upload web tools engineered to give users full sovereignty over their files, photos, and digital footprints without corporate tracking.'
        : 'Criador do Remover Metadados e defensor da privacidade digital. Desenvolve ferramentas web 100% locais (zero envio a servidores) que devolvem aos usuários a soberania sobre suas fotos, documentos e rastros digitais.'}
    </p>
  </div>
</div>

<style>
  .blog-author-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--card-bg);
    border: 2px solid var(--border);
    box-shadow: var(--neo-shadow);
    border-radius: 4px;
    margin: 3rem 0 2rem;
    text-align: left;
  }

  .author-avatar-badge {
    width: 52px;
    height: 52px;
    background: var(--btn-accent);
    color: var(--btn-accent-text);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0px var(--shadow-color);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .author-info {
    flex-grow: 1;
  }

  .author-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .author-role-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .author-profile-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--link-color);
    text-decoration: none;
  }

  .author-profile-link:hover {
    text-decoration: underline;
  }

  .author-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.45rem 0;
  }

  .author-bio {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-muted);
    margin: 0;
  }

  @media (max-width: 540px) {
    .blog-author-card {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
